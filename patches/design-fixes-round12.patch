@@ -0,0 +1,39 @@
+---
+// Fig. for "Modular Inverses & Fermat's Little Theorem": the same 6 ÷ 2,
+// read three ways — plain division, the reciprocal rewrite that's
+// identical to it, and that same rewrite attempted inside mod 7, where
+// the reciprocal ½ simply isn't a number that exists.
+interface Col {
+  eq: string;
+  note1: string;
+  note2: string;
+  verdict: string | null;
+  ok: boolean;
+}
+const cols: Col[] = [
+  { eq: "6 ÷ 2 = 3", note1: "normal division", note2: "", verdict: null, ok: true },
+  { eq: "6 × ½ = 3", note1: "same thing — multiply by", note2: "the reciprocal", verdict: null, ok: true },
+  { eq: "6 × ½ mod 7 ?", note1: "½ is not a whole number", note2: "", verdict: "✗ this doesn't exist here", ok: false },
+];
+const colW = 240;
+---
+<svg viewBox="0 0 720 200" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;display:block;">
+  <line x1="240" y1="14" x2="240" y2="186" stroke="#223049" stroke-width="1" />
+  <line x1="480" y1="14" x2="480" y2="186" stroke="#223049" stroke-width="1" />
+
+  {cols.map((col, i) => {
+    const cx = i * colW + colW / 2;
+    return (
+      <>
+        <text x={cx} y="56" text-anchor="middle" fill="#e9eef5" font-size="21" font-weight="800" font-family="-apple-system,Arial,sans-serif">{col.eq}</text>
+        <text x={cx} y="88" text-anchor="middle" fill="#8b96a8" font-size="13" font-family="-apple-system,Arial,sans-serif">{col.note1}</text>
+        {col.note2 && (
+          <text x={cx} y="108" text-anchor="middle" fill="#8b96a8" font-size="13" font-family="-apple-system,Arial,sans-serif">{col.note2}</text>
+        )}
+        {col.verdict && (
+          <text x={cx} y="150" text-anchor="middle" fill="#ff8080" font-size="14.5" font-weight="800" font-family="-apple-system,Arial,sans-serif">{col.verdict}</text>
+        )}
+      </>
+    );
+  })}
+</svg>
diff --git a/src/components/figures/ModularInverseSearchFigure.astro b/src/components/figures/ModularInverseSearchFigure.astro
new file mode 100644
index 0000000..627133d
--- /dev/null
+++ b/src/components/figures/ModularInverseSearchFigure.astro
@@ -0,0 +1,49 @@
+---
+// Fig. for "Modular Inverses & Fermat's Little Theorem": the brute-force
+// search for an inverse, one candidate at a time — reused for both the
+// successful search (3, mod 7) and the one that never finds a match
+// (2, mod 6), which is what the optional `footer` prop is for.
+interface Props {
+  a: number;
+  n: number;
+  rows: number[];
+  matchIndex?: number;
+  footer?: string;
+}
+const { a, n, rows, matchIndex, footer } = Astro.props;
+const rowH = 44;
+const topPad = 34;
+const tableH = rows.length * rowH;
+const footerH = footer ? 74 : 0;
+const height = topPad + tableH + footerH + 16;
+---
+<svg viewBox={`0 0 720 ${height}`} xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;display:block;">
+  {rows.map((x, i) => {
+    const y = topPad + i * rowH;
+    const product = a * x;
+    const remainder = product % n;
+    const isMatch = i === matchIndex;
+    const color = isMatch ? "#5ddc8a" : "#ff8080";
+    const verdict = isMatch ? "✓ found it!" : "✗ not 1";
+    return (
+      <>
+        <text x="60" y={y + 23} text-anchor="middle" fill="#c3cedd" font-size="15" font-weight="700" font-family="-apple-system,Arial,sans-serif">x = {x}</text>
+        <text x="340" y={y + 23} text-anchor="middle" fill="#cdd9e8" font-size="14.5" font-family="SF Mono, Fira Code, Consolas, monospace">
+          {`${a} × ${x} = ${product} → mod ${n} = ${remainder}`}
+        </text>
+        <text x="630" y={y + 23} text-anchor="middle" fill={color} font-size="14" font-weight="800" font-family="-apple-system,Arial,sans-serif">{verdict}</text>
+        {i < rows.length - 1 && (
+          <line x1="20" y1={y + rowH - 8} x2="700" y2={y + rowH - 8} stroke="#1a2436" stroke-width="1" />
+        )}
+      </>
+    );
+  })}
+
+  {footer && (
+    <>
+      <rect x="20" y={topPad + tableH + 14} width="680" height={footerH - 16} rx="8" fill="#1a1016" stroke="#ff8080" stroke-width="1.5" />
+      <line x1="20" y1={topPad + tableH + 14} x2="20" y2={topPad + tableH + footerH - 2} stroke="#ff8080" stroke-width="4" />
+      <text x="360" y={topPad + tableH + 14 + (footerH - 16) / 2 + 5} text-anchor="middle" fill="#f2b8b8" font-size="13.5" font-weight="700" font-family="-apple-system,Arial,sans-serif">{footer}</text>
+    </>
+  )}
+</svg>
