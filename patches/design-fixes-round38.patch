diff --git a/src/components/figures/ConstraintDotProductFigure.astro b/src/components/figures/ConstraintDotProductFigure.astro
new file mode 100644
index 0000000..49b2d7f
--- /dev/null
+++ b/src/components/figures/ConstraintDotProductFigure.astro
@@ -0,0 +1,34 @@
+---
+// Fig. for "Linear Algebra over Finite Fields": packing a claimed computation
+// into a vector z = (1, x, y, w) and checking each multiplication step as
+// (row A • z) × (row B • z) = (row C • z) — the shape of an R1CS constraint.
+---
+<svg viewBox="0 0 760 560" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;display:block;">
+  <text x="380" y="26" text-anchor="middle" fill="#e9eef5" font-size="16" font-weight="800" font-family="-apple-system,Arial,sans-serif">constraints as dot products</text>
+
+  <rect x="40" y="46" width="680" height="42" rx="10" fill="#111c2e" stroke="#3ab7ff" stroke-width="1.5" />
+  <text x="380" y="72" text-anchor="middle" fill="#8fdcff" font-size="13.5" font-weight="700" font-family="-apple-system,Arial,sans-serif">Can a computation be checked with dot products?</text>
+
+  <text x="380" y="108" text-anchor="middle" fill="#8b96a8" font-size="11.5" font-weight="700" font-family="-apple-system,Arial,sans-serif">SETUP</text>
+  <text x="380" y="130" text-anchor="middle" fill="#e9eef5" font-size="13" font-family="SF Mono, Fira Code, Consolas, monospace">claim: x = 3, y = x &#215; x = 9 = 2, w = y &#215; x = 6 (mod 7)</text>
+  <text x="380" y="152" text-anchor="middle" fill="#e9eef5" font-size="13" font-family="SF Mono, Fira Code, Consolas, monospace">pack everything into one vector z = (1, x, y, w) = (1, 3, 2, 6)</text>
+
+  <text x="380" y="186" text-anchor="middle" fill="#8b96a8" font-size="12" font-weight="700" font-family="-apple-system,Arial,sans-serif">STEP 1 &#8212; constraint y = x &#215; x</text>
+  <text x="380" y="210" text-anchor="middle" fill="#e9eef5" font-size="13.5" font-family="SF Mono, Fira Code, Consolas, monospace">(row A)&#8226;z = (0, 1, 0, 0)&#8226;z = 3</text>
+  <text x="380" y="230" text-anchor="middle" fill="#e9eef5" font-size="13.5" font-family="SF Mono, Fira Code, Consolas, monospace">(row B)&#8226;z = (0, 1, 0, 0)&#8226;z = 3</text>
+  <text x="380" y="250" text-anchor="middle" fill="#e9eef5" font-size="13.5" font-family="SF Mono, Fira Code, Consolas, monospace">(row C)&#8226;z = (0, 0, 1, 0)&#8226;z = 2</text>
+  <text x="380" y="276" text-anchor="middle" fill="#5ddc8a" font-size="13.5" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">3 &#215; 3 = 9 = 2 &#10003;</text>
+
+  <text x="380" y="310" text-anchor="middle" fill="#8b96a8" font-size="12" font-weight="700" font-family="-apple-system,Arial,sans-serif">STEP 2 &#8212; constraint w = y &#215; x</text>
+  <text x="380" y="334" text-anchor="middle" fill="#e9eef5" font-size="13.5" font-family="SF Mono, Fira Code, Consolas, monospace">(row A)&#8226;z = (0, 0, 1, 0)&#8226;z = 2</text>
+  <text x="380" y="354" text-anchor="middle" fill="#e9eef5" font-size="13.5" font-family="SF Mono, Fira Code, Consolas, monospace">(row B)&#8226;z = (0, 1, 0, 0)&#8226;z = 3</text>
+  <text x="380" y="374" text-anchor="middle" fill="#e9eef5" font-size="13.5" font-family="SF Mono, Fira Code, Consolas, monospace">(row C)&#8226;z = (0, 0, 0, 1)&#8226;z = 6</text>
+  <text x="380" y="400" text-anchor="middle" fill="#5ddc8a" font-size="13.5" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">2 &#215; 3 = 6 &#10003;</text>
+
+  <rect x="60" y="412" width="640" height="48" rx="10" fill="#0e1f16" stroke="#5ddc8a" stroke-width="1.8" />
+  <text x="380" y="442" text-anchor="middle" fill="#5ddc8a" font-size="13.5" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">every constraint: (row A &#8226; z) &#215; (row B &#8226; z) = (row C &#8226; z)</text>
+
+  <line x1="40" y1="486" x2="720" y2="486" stroke="#223049" stroke-width="1" />
+  <text x="380" y="510" text-anchor="middle" fill="#8fdcff" font-size="15.5" font-weight="800" font-family="-apple-system,Arial,sans-serif">ONE MULTIPLY PER CONSTRAINT</text>
+  <text x="380" y="532" text-anchor="middle" fill="#8b96a8" font-size="12.5" font-family="-apple-system,Arial,sans-serif">This is the shape of R1CS, a constraint system many ZK proofs use.</text>
+</svg>
diff --git a/src/components/figures/InverseMatrixFigure.astro b/src/components/figures/InverseMatrixFigure.astro
new file mode 100644
index 0000000..4ff48f8
--- /dev/null
+++ b/src/components/figures/InverseMatrixFigure.astro
@@ -0,0 +1,48 @@
+---
+// Fig. for "Linear Algebra over Finite Fields": building A⁻¹ by determinant,
+// invert, swap/negate/scale — then checking A⁻¹ × (3,4) recovers (5,6), and
+// noting a zero determinant (rows carrying the same information) has no inverse.
+import Matrix2x2 from "./Matrix2x2.astro";
+---
+<svg viewBox="0 0 760 560" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;display:block;">
+  <text x="380" y="26" text-anchor="middle" fill="#e9eef5" font-size="16" font-weight="800" font-family="-apple-system,Arial,sans-serif">the inverse matrix</text>
+
+  <rect x="40" y="46" width="680" height="42" rx="10" fill="#111c2e" stroke="#3ab7ff" stroke-width="1.5" />
+  <text x="380" y="72" text-anchor="middle" fill="#8fdcff" font-size="13.5" font-weight="700" font-family="-apple-system,Arial,sans-serif">Can we undo A in one step?</text>
+
+  <text x="380" y="112" text-anchor="middle" fill="#8b96a8" font-size="12" font-weight="700" font-family="-apple-system,Arial,sans-serif">STEP 1 &#8212; the determinant</text>
+  <text x="161" y="150" fill="#e9eef5" font-size="13" font-family="SF Mono, Fira Code, Consolas, monospace">for the grid</text>
+  <Matrix2x2 x={281} y={127} a="1" b="2" c="3" d="4" scale={0.7} />
+  <text x="339" y="150" fill="#e9eef5" font-size="13" font-family="SF Mono, Fira Code, Consolas, monospace">: 1 &#215; 4 &#8722; 2 &#215; 3 = &#8722;2 = 5</text>
+
+  <text x="380" y="190" text-anchor="middle" fill="#8b96a8" font-size="12" font-weight="700" font-family="-apple-system,Arial,sans-serif">STEP 2 &#8212; invert it</text>
+  <text x="380" y="216" text-anchor="middle" fill="#e9eef5" font-size="13.5" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">5 &#215; 3 = 15 = 1, so 1 &#247; 5 = 3</text>
+
+  <text x="380" y="250" text-anchor="middle" fill="#8b96a8" font-size="12" font-weight="700" font-family="-apple-system,Arial,sans-serif">STEP 3 &#8212; swap, negate, scale</text>
+
+  <text x="160" y="285" fill="#e9eef5" font-size="14" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">3 &#215;</text>
+  <Matrix2x2 x={204} y={258} a="4" b="&#8722;2" c="&#8722;3" d="1" scale={0.85} />
+  <text x="272" y="285" fill="#e9eef5" font-size="14" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">=</text>
+  <text x="302" y="285" fill="#e9eef5" font-size="14" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">3 &#215;</text>
+  <Matrix2x2 x={346} y={258} a="4" b="5" c="4" d="1" scale={0.85} />
+  <text x="414" y="285" fill="#e9eef5" font-size="14" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">=</text>
+  <Matrix2x2 x={444} y={258} a="12" b="15" c="12" d="3" scale={0.85} />
+  <text x="512" y="285" fill="#e9eef5" font-size="14" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">=</text>
+  <Matrix2x2 x={542} y={258} a="5" b="1" c="5" d="3" scale={0.85} />
+
+  <text x="380" y="320" text-anchor="middle" fill="#8b96a8" font-size="11.5" font-family="SF Mono, Fira Code, Consolas, monospace">&#8722;2 = 5 and &#8722;3 = 4</text>
+
+  <rect x="240" y="342" width="280" height="56" rx="10" fill="#0e1f16" stroke="#5ddc8a" stroke-width="1.8" />
+  <text x="316" y="376" fill="#5ddc8a" font-size="15" font-weight="800" font-family="SF Mono, Fira Code, Consolas, monospace">A<tspan dy="-6" font-size="65%">&#8722;1</tspan><tspan dy="6"> =</tspan></text>
+  <Matrix2x2 x={386} y={348} a="5" b="1" c="5" d="3" scale={0.85} color="#5ddc8a" />
+
+  <text x="380" y="428" text-anchor="middle" fill="#e9eef5" font-size="12.5" font-family="SF Mono, Fira Code, Consolas, monospace">A<tspan dy="-6" font-size="65%">&#8722;1</tspan><tspan dy="6">&#215; (3, 4) = (5&#8226;3 + 1&#8226;4, 5&#8226;3 + 3&#8226;4) = (19, 27) = (5, 6) &#10003;, the same answer as before</tspan></text>
+
+  <text x="101" y="454" fill="#ff5c7a" font-size="12.5" font-family="-apple-system,Arial,sans-serif">if the determinant is 0, there is no inverse:</text>
+  <Matrix2x2 x={431} y={431} a="1" b="2" c="2" d="4" scale={0.7} color="#ff5c7a" />
+  <text x="489" y="454" fill="#ff5c7a" font-size="12.5" font-family="SF Mono, Fira Code, Consolas, monospace">has 1 &#215; 4 &#8722; 2 &#215; 2 = 0</text>
+
+  <line x1="40" y1="486" x2="720" y2="486" stroke="#223049" stroke-width="1" />
+  <text x="380" y="510" text-anchor="middle" fill="#8fdcff" font-size="15.5" font-weight="800" font-family="-apple-system,Arial,sans-serif">A NON-ZERO DETERMINANT MEANS YOU CAN UNDO IT</text>
+  <text x="380" y="532" text-anchor="middle" fill="#8b96a8" font-size="12.5" font-family="-apple-system,Arial,sans-serif">Zero determinant means two rows carry the same information.</text>
+</svg>
diff --git a/src/components/figures/LinearAlgebraSummaryFigure.astro b/src/components/figures/LinearAlgebraSummaryFigure.astro
new file mode 100644
index 0000000..c86252f
--- /dev/null
+++ b/src/components/figures/LinearAlgebraSummaryFigure.astro
@@ -0,0 +1,36 @@
+---
+// Fig. for "Linear Algebra over Finite Fields": where this shows up — the
+// three-column summary pattern used by the quadratic-residues and
+// extension-fields lessons' closing figures.
+---
+<svg viewBox="0 0 760 430" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;display:block;">
+  <text x="380" y="26" text-anchor="middle" fill="#e9eef5" font-size="16" font-weight="800" font-family="-apple-system,Arial,sans-serif">where this shows up</text>
+
+  <!-- the dot product -->
+  <rect x="30" y="56" width="220" height="230" rx="12" fill="#121c2c" stroke="#3ab7ff" stroke-width="1.8" />
+  <text x="140" y="90" text-anchor="middle" fill="#8fdcff" font-size="14.5" font-weight="800" font-family="-apple-system,Arial,sans-serif">THE DOT PRODUCT</text>
+  <text x="140" y="130" text-anchor="middle" fill="#c3cedd" font-size="12" font-family="-apple-system,Arial,sans-serif">multiply matching</text>
+  <text x="140" y="148" text-anchor="middle" fill="#c3cedd" font-size="12" font-family="-apple-system,Arial,sans-serif">entries, add,</text>
+  <text x="140" y="166" text-anchor="middle" fill="#c3cedd" font-size="12" font-family="-apple-system,Arial,sans-serif">reduce mod 7</text>
+  <text x="140" y="256" text-anchor="middle" fill="#5ddc8a" font-size="12.5" font-style="italic" font-family="-apple-system,Arial,sans-serif">Two lists, one number.</text>
+
+  <!-- matrices and solving -->
+  <rect x="270" y="56" width="220" height="230" rx="12" fill="#121c2c" stroke="#5ddc8a" stroke-width="1.8" />
+  <text x="380" y="90" text-anchor="middle" fill="#5ddc8a" font-size="14.5" font-weight="800" font-family="-apple-system,Arial,sans-serif">MATRICES AND SOLVING</text>
+  <text x="380" y="130" text-anchor="middle" fill="#c3cedd" font-size="12" font-family="-apple-system,Arial,sans-serif">matrix times vector,</text>
+  <text x="380" y="148" text-anchor="middle" fill="#c3cedd" font-size="12" font-family="-apple-system,Arial,sans-serif">row reduction,</text>
+  <text x="380" y="166" text-anchor="middle" fill="#c3cedd" font-size="12" font-family="-apple-system,Arial,sans-serif">inverses</text>
+  <text x="380" y="256" text-anchor="middle" fill="#5ddc8a" font-size="12.5" font-style="italic" font-family="-apple-system,Arial,sans-serif">Undo a matrix.</text>
+
+  <!-- constraints -->
+  <rect x="510" y="56" width="220" height="230" rx="12" fill="#121c2c" stroke="#8fdcff" stroke-width="1.8" />
+  <text x="620" y="90" text-anchor="middle" fill="#8fdcff" font-size="14.5" font-weight="800" font-family="-apple-system,Arial,sans-serif">CONSTRAINTS</text>
+  <text x="620" y="130" text-anchor="middle" fill="#c3cedd" font-size="12" font-family="-apple-system,Arial,sans-serif">each check is three</text>
+  <text x="620" y="148" text-anchor="middle" fill="#c3cedd" font-size="12" font-family="-apple-system,Arial,sans-serif">dot products and</text>
+  <text x="620" y="166" text-anchor="middle" fill="#c3cedd" font-size="12" font-family="-apple-system,Arial,sans-serif">one multiply</text>
+  <text x="620" y="256" text-anchor="middle" fill="#5ddc8a" font-size="12.5" font-style="italic" font-family="-apple-system,Arial,sans-serif">The shape of R1CS.</text>
+
+  <line x1="30" y1="316" x2="730" y2="316" stroke="#223049" stroke-width="1" />
+  <text x="380" y="340" text-anchor="middle" fill="#8fdcff" font-size="15.5" font-weight="800" font-family="-apple-system,Arial,sans-serif">DOT PRODUCTS ARE THE BUILDING BLOCK</text>
+  <text x="380" y="362" text-anchor="middle" fill="#8b96a8" font-size="12.5" font-family="-apple-system,Arial,sans-serif">Next up: FFT and NTT.</text>
+</svg>
diff --git a/src/components/figures/Matrix2x2.astro b/src/components/figures/Matrix2x2.astro
new file mode 100644
index 0000000..3f0b44b
--- /dev/null
+++ b/src/components/figures/Matrix2x2.astro
@@ -0,0 +1,32 @@
+---
+// Reusable inline 2x2 matrix: a bracket pair drawn with SVG paths around a
+// 2x2 grid of values. Meant to be dropped inside another figure's <svg> as
+// a positioned <g>, e.g. <Matrix2x2 x={120} y={40} a="1" b="2" c="3" d="4" />.
+interface Props {
+  x: number;
+  y: number;
+  a: string;
+  b: string;
+  c: string;
+  d: string;
+  color?: string;
+  scale?: number;
+}
+const { x, y, a, b, c, d, color = "#e9eef5", scale = 1 } = Astro.props;
+const rowH = 20 * scale;
+const colW = 24 * scale;
+const padX = 10 * scale;
+const padY = 8 * scale;
+const h = rowH * 2 + padY * 2 - 4 * scale;
+const w = colW * 2 + padX * 2;
+const tick = 7 * scale;
+const fontSize = 13 * scale;
+---
+<g transform={`translate(${x}, ${y})`}>
+  <path d={`M ${tick} 0 L 0 0 L 0 ${h} L ${tick} ${h}`} fill="none" stroke={color} stroke-width="1.5" />
+  <path d={`M ${w - tick} 0 L ${w} 0 L ${w} ${h} L ${w - tick} ${h}`} fill="none" stroke={color} stroke-width="1.5" />
+  <text x={padX + colW / 2} y={padY + rowH * 0.5 + 4} text-anchor="middle" fill={color} font-size={fontSize} font-family="SF Mono, Fira Code, Consolas, monospace">{a}</text>
+  <text x={padX + colW * 1.5} y={padY + rowH * 0.5 + 4} text-anchor="middle" fill={color} font-size={fontSize} font-family="SF Mono, Fira Code, Consolas, monospace">{b}</text>
+  <text x={padX + colW / 2} y={padY + rowH * 1.5 + 4} text-anchor="middle" fill={color} font-size={fontSize} font-family="SF Mono, Fira Code, Consolas, monospace">{c}</text>
+  <text x={padX + colW * 1.5} y={padY + rowH * 1.5 + 4} text-anchor="middle" fill={color} font-size={fontSize} font-family="SF Mono, Fira Code, Consolas, monospace">{d}</text>
+</g>
diff --git a/src/components/figures/MatrixVectorFigure.astro b/src/components/figures/MatrixVectorFigure.astro
new file mode 100644
index 0000000..44c6616
--- /dev/null
+++ b/src/components/figures/MatrixVectorFigure.astro
@@ -0,0 +1,32 @@
+---
+// Fig. for "Linear Algebra over Finite Fields": a matrix times a vector is
+// one dot product per row — A = [[1,2],[3,4]] turns v = (5,6) into (3,4) mod 7.
+import Matrix2x2 from "./Matrix2x2.astro";
+---
+<svg viewBox="0 0 760 510" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;display:block;">
+  <text x="380" y="26" text-anchor="middle" fill="#e9eef5" font-size="16" font-weight="800" font-family="-apple-system,Arial,sans-serif">matrix times vector</text>
+
+  <rect x="40" y="46" width="680" height="42" rx="10" fill="#111c2e" stroke="#3ab7ff" stroke-width="1.5" />
+  <text x="380" y="72" text-anchor="middle" fill="#8fdcff" font-size="13.5" font-weight="700" font-family="-apple-system,Arial,sans-serif">What does a matrix do to a vector?</text>
+
+  <text x="270" y="150" text-anchor="end" fill="#e9eef5" font-size="16" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">A =</text>
+  <Matrix2x2 x={300} y={110} a="1" b="2" c="3" d="4" scale={1.3} />
+  <text x="560" y="150" text-anchor="middle" fill="#e9eef5" font-size="16" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">v = (5, 6)</text>
+
+  <text x="380" y="216" text-anchor="middle" fill="#e9eef5" font-size="15" font-weight="800" font-family="SF Mono, Fira Code, Consolas, monospace">A &#215; v</text>
+
+  <text x="380" y="250" text-anchor="middle" fill="#8b96a8" font-size="12" font-weight="700" font-family="-apple-system,Arial,sans-serif">STEP 1 &#8212; row 1 &#8226; v</text>
+  <text x="380" y="276" text-anchor="middle" fill="#e9eef5" font-size="14.5" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">1 &#215; 5 + 2 &#215; 6 = 5 + 12 = 17 = 3</text>
+
+  <text x="380" y="308" text-anchor="middle" fill="#8b96a8" font-size="12" font-weight="700" font-family="-apple-system,Arial,sans-serif">STEP 2 &#8212; row 2 &#8226; v</text>
+  <text x="380" y="334" text-anchor="middle" fill="#e9eef5" font-size="14.5" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">3 &#215; 5 + 4 &#215; 6 = 15 + 24 = 39 = 4</text>
+
+  <rect x="260" y="356" width="240" height="42" rx="10" fill="#0e1f16" stroke="#5ddc8a" stroke-width="1.8" />
+  <text x="380" y="382" text-anchor="middle" fill="#5ddc8a" font-size="14.5" font-weight="800" font-family="SF Mono, Fira Code, Consolas, monospace">A &#215; v = (3, 4)</text>
+
+  <text x="380" y="424" text-anchor="middle" fill="#e9eef5" font-size="13" font-family="SF Mono, Fira Code, Consolas, monospace">17 = 2 &#215; 7 + 3 and 39 = 5 &#215; 7 + 4 &#10003;</text>
+
+  <line x1="40" y1="444" x2="720" y2="444" stroke="#223049" stroke-width="1" />
+  <text x="380" y="468" text-anchor="middle" fill="#8fdcff" font-size="15.5" font-weight="800" font-family="-apple-system,Arial,sans-serif">ONE ROW, ONE DOT PRODUCT</text>
+  <text x="380" y="490" text-anchor="middle" fill="#8b96a8" font-size="12.5" font-family="-apple-system,Arial,sans-serif">A matrix is a machine that turns one vector into another.</text>
+</svg>
diff --git a/src/components/figures/SolvingSystemFigure.astro b/src/components/figures/SolvingSystemFigure.astro
new file mode 100644
index 0000000..031948c
--- /dev/null
+++ b/src/components/figures/SolvingSystemFigure.astro
@@ -0,0 +1,35 @@
+---
+// Fig. for "Linear Algebra over Finite Fields": running A·v = (3,4) backwards
+// — eliminate x, divide by 5 mod 7, back-substitute — recovers v = (5,6),
+// the same vector Fig. 2 started from.
+---
+<svg viewBox="0 0 760 550" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;display:block;">
+  <text x="380" y="26" text-anchor="middle" fill="#e9eef5" font-size="16" font-weight="800" font-family="-apple-system,Arial,sans-serif">solving a system</text>
+
+  <rect x="40" y="46" width="680" height="42" rx="10" fill="#111c2e" stroke="#3ab7ff" stroke-width="1.5" />
+  <text x="380" y="72" text-anchor="middle" fill="#8fdcff" font-size="13.5" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">Which vector v = (x, y) does A turn into (3, 4)?</text>
+
+  <text x="380" y="112" text-anchor="middle" fill="#8b96a8" font-size="11.5" font-weight="700" font-family="-apple-system,Arial,sans-serif">SETUP</text>
+  <text x="380" y="136" text-anchor="middle" fill="#e9eef5" font-size="14" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">x + 2y = 3</text>
+  <text x="380" y="158" text-anchor="middle" fill="#e9eef5" font-size="14" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">3x + 4y = 4</text>
+
+  <text x="380" y="192" text-anchor="middle" fill="#8b96a8" font-size="12" font-weight="700" font-family="-apple-system,Arial,sans-serif">STEP 1 &#8212; clear x from row 2</text>
