diff --git a/src/components/figures/MultilinearHypercubeFigure.astro b/src/components/figures/MultilinearHypercubeFigure.astro
new file mode 100644
index 0000000..0fc0ad2
--- /dev/null
+++ b/src/components/figures/MultilinearHypercubeFigure.astro
@@ -0,0 +1,46 @@
+---
+// Fig. for "Multivariate & Multilinear Polynomials": a multilinear
+// polynomial has 2^n coefficients, exactly matching the 2^n corners of
+// the Boolean hypercube {0,1}^n — shown here for n = 2.
+---
+<svg viewBox="0 0 760 560" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;display:block;">
+  <text x="380" y="26" text-anchor="middle" fill="#e9eef5" font-size="16" font-weight="800" font-family="-apple-system,Arial,sans-serif">multilinear: each variable at most once</text>
+
+  <rect x="40" y="46" width="680" height="42" rx="10" fill="#111c2e" stroke="#3ab7ff" stroke-width="1.5" />
+  <text x="380" y="72" text-anchor="middle" fill="#8fdcff" font-size="13.5" font-weight="700" font-family="-apple-system,Arial,sans-serif">What if every variable may only appear to the power 1?</text>
+
+  <text x="380" y="122" text-anchor="middle" font-family="SF Mono, Fira Code, Consolas, monospace">
+    <tspan fill="#8b96a8" font-size="11.5" font-weight="700">ALLOWED&#160;&#160;&#160;</tspan><tspan fill="#5ddc8a" font-size="13.5" font-weight="700">3 + 2x + 5y + 4xy &#10003;</tspan>
+  </text>
+
+  <text x="380" y="154" text-anchor="middle" font-family="SF Mono, Fira Code, Consolas, monospace">
+    <tspan fill="#8b96a8" font-size="11.5" font-weight="700">NOT ALLOWED&#160;&#160;&#160;</tspan><tspan fill="#ff5c7a" font-size="13.5" font-weight="700">x<tspan dy="-6" font-size="65%">2</tspan><tspan dy="6"> or x</tspan><tspan dy="-6" font-size="65%">2</tspan><tspan dy="6">y &#10007;</tspan></tspan>
+  </text>
+
+  <text x="380" y="186" text-anchor="middle" font-family="SF Mono, Fira Code, Consolas, monospace">
+    <tspan fill="#8b96a8" font-size="11.5" font-weight="700">MONOMIALS&#160;&#160;&#160;</tspan><tspan fill="#e9eef5" font-size="13" font-weight="700">1, x, y, xy &#8594; 4 = 2<tspan dy="-6" font-size="65%">2</tspan><tspan dy="6"> coefficients. With n variables there are 2</tspan><tspan dy="-6" font-size="65%">n</tspan><tspan dy="6">.</tspan></tspan>
+  </text>
+
+  <!-- the Boolean hypercube {0,1}^2 -->
+  <line x1="295" y1="230" x2="465" y2="230" stroke="#8fdcff" stroke-width="1.5" />
+  <line x1="295" y1="400" x2="465" y2="400" stroke="#8fdcff" stroke-width="1.5" />
+  <line x1="295" y1="230" x2="295" y2="400" stroke="#8fdcff" stroke-width="1.5" />
+  <line x1="465" y1="230" x2="465" y2="400" stroke="#8fdcff" stroke-width="1.5" />
+  <circle cx="295" cy="230" r="6" fill="#8fdcff" />
+  <circle cx="465" cy="230" r="6" fill="#8fdcff" />
+  <circle cx="295" cy="400" r="6" fill="#8fdcff" />
+  <circle cx="465" cy="400" r="6" fill="#8fdcff" />
+  <text x="280" y="234" text-anchor="end" fill="#e9eef5" font-size="14" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">(0, 1) &#8594; 8</text>
+  <text x="480" y="234" text-anchor="start" fill="#e9eef5" font-size="14" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">(1, 1) &#8594; 14 = 1</text>
+  <text x="280" y="404" text-anchor="end" fill="#e9eef5" font-size="14" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">(0, 0) &#8594; 3</text>
+  <text x="480" y="404" text-anchor="start" fill="#e9eef5" font-size="14" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">(1, 0) &#8594; 5</text>
+  <text x="380" y="430" text-anchor="middle" fill="#8b96a8" font-size="12" font-family="SF Mono, Fira Code, Consolas, monospace">the Boolean hypercube {"{0, 1}"}<tspan dy="-6" font-size="65%">2</tspan><tspan dy="6">, all values in F(13)</tspan></text>
+
+  <text x="380" y="464" text-anchor="middle" font-family="SF Mono, Fira Code, Consolas, monospace">
+    <tspan fill="#8b96a8" font-size="11.5" font-weight="700">CHECK&#160;&#160;&#160;</tspan><tspan fill="#5ddc8a" font-size="13.5" font-weight="700">f(1, 1) = 3 + 2 + 5 + 4 = 14 = 1 &#10003;</tspan>
+  </text>
+
+  <line x1="40" y1="486" x2="720" y2="486" stroke="#223049" stroke-width="1" />
+  <text x="380" y="510" text-anchor="middle" fill="#8fdcff" font-size="15.5" font-weight="800" font-family="-apple-system,Arial,sans-serif">2&#8319; COEFFICIENTS MATCH 2&#8319; CORNERS</text>
+  <text x="380" y="532" text-anchor="middle" fill="#8b96a8" font-size="12.5" font-family="-apple-system,Arial,sans-serif">The four corner values pin down the whole polynomial.</text>
+</svg>
diff --git a/src/components/figures/OneVarToManyFigure.astro b/src/components/figures/OneVarToManyFigure.astro
new file mode 100644
index 0000000..bfedf27
--- /dev/null
+++ b/src/components/figures/OneVarToManyFigure.astro
@@ -0,0 +1,37 @@
+---
+// Fig. for "Multivariate & Multilinear Polynomials": moving from one
+// variable to several — total degree vs. degree in each variable,
+// evaluated at a point (2, 3) in F(13).
+---
+<svg viewBox="0 0 760 440" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;display:block;">
+  <text x="380" y="26" text-anchor="middle" fill="#e9eef5" font-size="16" font-weight="800" font-family="-apple-system,Arial,sans-serif">from one variable to many</text>
+
+  <rect x="40" y="46" width="680" height="42" rx="10" fill="#111c2e" stroke="#3ab7ff" stroke-width="1.5" />
+  <text x="380" y="72" text-anchor="middle" fill="#8fdcff" font-size="13" font-weight="700" font-family="-apple-system,Arial,sans-serif">What changes when a polynomial has more than one variable?</text>
+
+  <text x="380" y="122" text-anchor="middle" font-family="SF Mono, Fira Code, Consolas, monospace">
+    <tspan fill="#8b96a8" font-size="11.5" font-weight="700">ONE VARIABLE&#160;&#160;&#160;</tspan><tspan fill="#e9eef5" font-size="13.5" font-weight="700">f(x) = 2 + 3x + x<tspan dy="-6" font-size="65%">2</tspan><tspan dy="6">  (one input, degree 2)</tspan></tspan>
+  </text>
+
+  <text x="380" y="154" text-anchor="middle" font-family="SF Mono, Fira Code, Consolas, monospace">
+    <tspan fill="#8b96a8" font-size="11.5" font-weight="700">TWO VARIABLES&#160;&#160;&#160;</tspan><tspan fill="#e9eef5" font-size="13.5" font-weight="700">f(x, y) = 3x<tspan dy="-6" font-size="65%">2</tspan><tspan dy="6">y + 2xy + 5  (the input is a pair (x, y))</tspan></tspan>
+  </text>
+
+  <text x="380" y="186" text-anchor="middle" font-family="SF Mono, Fira Code, Consolas, monospace">
+    <tspan fill="#8b96a8" font-size="11.5" font-weight="700">TOTAL DEGREE&#160;&#160;&#160;</tspan><tspan fill="#e9eef5" font-size="13.5" font-weight="700">x<tspan dy="-6" font-size="65%">2</tspan><tspan dy="6">y has degree 2 + 1 = 3, so total degree = 3</tspan></tspan>
+  </text>
+
+  <text x="380" y="218" text-anchor="middle" font-family="SF Mono, Fira Code, Consolas, monospace">
+    <tspan fill="#8b96a8" font-size="11.5" font-weight="700">DEGREE IN EACH VARIABLE&#160;&#160;&#160;</tspan><tspan fill="#e9eef5" font-size="13.5" font-weight="700">x &#8594; 2, y &#8594; 1</tspan>
+  </text>
+
+  <text x="380" y="250" text-anchor="middle" fill="#8b96a8" font-size="11.5" font-weight="700" font-family="-apple-system,Arial,sans-serif">EVALUATE AT (2, 3) IN F(13)</text>
+  <text x="380" y="276" text-anchor="middle" fill="#e9eef5" font-size="13.5" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">3&#215;2<tspan dy="-6" font-size="65%">2</tspan><tspan dy="6">&#215;3 + 2&#215;2&#215;3 + 5 = 36 + 12 + 5 = 53 = 1</tspan></text>
+
+  <rect x="260" y="298" width="240" height="42" rx="10" fill="#0e1f16" stroke="#5ddc8a" stroke-width="1.8" />
+  <text x="380" y="324" text-anchor="middle" fill="#5ddc8a" font-size="14.5" font-weight="800" font-family="SF Mono, Fira Code, Consolas, monospace">f(2, 3) = 1 &#10003;</text>
+
+  <line x1="40" y1="356" x2="720" y2="356" stroke="#223049" stroke-width="1" />
+  <text x="380" y="380" text-anchor="middle" fill="#8fdcff" font-size="15.5" font-weight="800" font-family="-apple-system,Arial,sans-serif">MANY VARIABLES: ONE POINT IN, ONE NUMBER OUT</text>
+  <text x="380" y="402" text-anchor="middle" fill="#8b96a8" font-size="12.5" font-family="-apple-system,Arial,sans-serif">Total degree controls how often a random point hits zero.</text>
+</svg>
diff --git a/src/components/figures/RandomCheckFigure.astro b/src/components/figures/RandomCheckFigure.astro
new file mode 100644
index 0000000..c8c2e5f
--- /dev/null
+++ b/src/components/figures/RandomCheckFigure.astro
@@ -0,0 +1,43 @@
+---
+// Fig. for "Multivariate & Multilinear Polynomials": why a single random
+// check catches a cheating prover — tying Schwartz–Zippel to a concrete
+// soundness argument, with a cheat that happens to survive one bad-luck
+// check before a second check catches it.
+---
+<svg viewBox="0 0 760 400" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;display:block;">
+  <text x="380" y="26" text-anchor="middle" fill="#e9eef5" font-size="16" font-weight="800" font-family="-apple-system,Arial,sans-serif">one random check catches a cheater</text>
+
+  <rect x="40" y="46" width="680" height="42" rx="10" fill="#111c2e" stroke="#3ab7ff" stroke-width="1.5" />
+  <text x="380" y="72" text-anchor="middle" fill="#8fdcff" font-size="13" font-weight="700" font-family="-apple-system,Arial,sans-serif">Why does checking at one random point actually catch a lie?</text>
+
+  <text x="380" y="122" text-anchor="middle" font-family="SF Mono, Fira Code, Consolas, monospace">
+    <tspan fill="#8b96a8" font-size="11.5" font-weight="700">CLAIM&#160;&#160;&#160;</tspan><tspan fill="#e9eef5" font-size="13" font-weight="700">prover says A(x) &#215; B(x) = C(x) for every x in F(13)</tspan>
+  </text>
+
+  <text x="380" y="154" text-anchor="middle" font-family="SF Mono, Fira Code, Consolas, monospace">
+    <tspan fill="#8b96a8" font-size="11.5" font-weight="700">CHECK&#160;&#160;&#160;</tspan><tspan fill="#8fdcff" font-size="13" font-weight="700">verifier picks random r, tests A(r) &#215; B(r) =? C(r)</tspan>
+  </text>
+
+  <text x="380" y="186" text-anchor="middle" font-family="SF Mono, Fira Code, Consolas, monospace">
+    <tspan fill="#8b96a8" font-size="11" font-weight="700">WHY IT WORKS&#160;&#160;&#160;</tspan><tspan fill="#e9eef5" font-size="12.5" font-weight="700">g(x) = A(x)B(x) &#8722; C(x) is nonzero, degree &#8804; 2 &#8594; at most 2 roots</tspan>
+  </text>
+
+  <text x="380" y="218" text-anchor="middle" font-family="SF Mono, Fira Code, Consolas, monospace">
+    <tspan fill="#8b96a8" font-size="11" font-weight="700">CHEAT EXAMPLE&#160;&#160;&#160;</tspan><tspan fill="#e9eef5" font-size="12.5" font-weight="700">this false claim's g(x) happens to vanish at x = 1 and x = 7</tspan>
+  </text>
+
+  <text x="380" y="250" text-anchor="middle" font-family="SF Mono, Fira Code, Consolas, monospace">
+    <tspan fill="#8b96a8" font-size="11.5" font-weight="700">TRY r = 1&#160;&#160;&#160;</tspan><tspan fill="#ff5c7a" font-size="13" font-weight="700">g(1) = 0 &#8594; check passes, cheater gets lucky &#10007;</tspan>
+  </text>
+
+  <text x="380" y="282" text-anchor="middle" font-family="SF Mono, Fira Code, Consolas, monospace">
+    <tspan fill="#8b96a8" font-size="11.5" font-weight="700">TRY r = 2&#160;&#160;&#160;</tspan><tspan fill="#5ddc8a" font-size="13" font-weight="700">g(2) = 5 &#8800; 0 &#8594; check fails, cheater is caught &#10003;</tspan>
+  </text>
+
+  <rect x="60" y="300" width="640" height="38" rx="10" fill="#0e1f16" stroke="#5ddc8a" stroke-width="1.8" />
+  <text x="380" y="324" text-anchor="middle" fill="#5ddc8a" font-size="13" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">repeat 3 times: chance every check gets lucky &#8804; (2/13)<tspan dy="-5" font-size="65%">3</tspan><tspan dy="5"> &#8776; 0.4%</tspan></text>
+
+  <line x1="40" y1="352" x2="720" y2="352" stroke="#223049" stroke-width="1" />
+  <text x="380" y="376" text-anchor="middle" fill="#8fdcff" font-size="15" font-weight="800" font-family="-apple-system,Arial,sans-serif">A FEW RANDOM CHECKS SHRINK THE CHEATING CHANCE FAST</text>
+  <text x="380" y="394" text-anchor="middle" fill="#8b96a8" font-size="12" font-family="-apple-system,Arial,sans-serif">In a huge field, one check is already enough.</text>
+</svg>
diff --git a/src/components/figures/SchwartzZippelFigure.astro b/src/components/figures/SchwartzZippelFigure.astro
new file mode 100644
index 0000000..24718ab
--- /dev/null
+++ b/src/components/figures/SchwartzZippelFigure.astro
@@ -0,0 +1,40 @@
+---
+// Fig. for "Multivariate & Multilinear Polynomials": the Schwartz–Zippel
+// lemma — a nonzero polynomial of total degree d vanishes at a random
+// point in F(p) with chance at most d/p, checked on f(x,y) = xy and then
+// at real-proof-system scale.
+---
+<svg viewBox="0 0 760 400" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;display:block;">
+  <text x="380" y="26" text-anchor="middle" fill="#e9eef5" font-size="16" font-weight="800" font-family="-apple-system,Arial,sans-serif">how often can a polynomial hit zero?</text>
+
+  <rect x="40" y="46" width="680" height="42" rx="10" fill="#111c2e" stroke="#3ab7ff" stroke-width="1.5" />
+  <text x="380" y="72" text-anchor="middle" fill="#8fdcff" font-size="13" font-weight="700" font-family="-apple-system,Arial,sans-serif">A polynomial isn't zero everywhere. How likely is a random point to be a root anyway?</text>
+
+  <text x="380" y="122" text-anchor="middle" font-family="SF Mono, Fira Code, Consolas, monospace">
+    <tspan fill="#8b96a8" font-size="11.5" font-weight="700">ONE VARIABLE&#160;&#160;&#160;</tspan><tspan fill="#e9eef5" font-size="13" font-weight="700">degree d has at most d roots, so chance &#8804; d/p</tspan>
+  </text>
+
+  <text x="380" y="158" text-anchor="middle" font-family="SF Mono, Fira Code, Consolas, monospace">
+    <tspan fill="#8b96a8" font-size="11.5" font-weight="700">THE RULE&#160;&#160;&#160;</tspan><tspan fill="#8fdcff" font-size="13" font-weight="700">nonzero polynomial, total degree d, random point in F(p) &#8594; chance of zero &#8804; d/p</tspan>
+  </text>
+
+  <text x="380" y="194" text-anchor="middle" font-family="SF Mono, Fira Code, Consolas, monospace">
+    <tspan fill="#8b96a8" font-size="11.5" font-weight="700">EXAMPLE&#160;&#160;&#160;</tspan><tspan fill="#e9eef5" font-size="13" font-weight="700">f(x, y) = x &#215; y in F(13), total degree 2</tspan>
+  </text>
+
+  <text x="380" y="226" text-anchor="middle" font-family="SF Mono, Fira Code, Consolas, monospace">
+    <tspan fill="#8b96a8" font-size="11.5" font-weight="700">ZEROS&#160;&#160;&#160;</tspan><tspan fill="#e9eef5" font-size="13" font-weight="700">x = 0 or y = 0 &#8594; 13 + 13 &#8722; 1 = 25 points out of 169</tspan>
+  </text>
+
+  <text x="380" y="258" text-anchor="middle" font-family="SF Mono, Fira Code, Consolas, monospace">
+    <tspan fill="#8b96a8" font-size="11.5" font-weight="700">COMPARE&#160;&#160;&#160;</tspan><tspan fill="#e9eef5" font-size="12.5" font-weight="700">actual 25/169 &#8776; 14.8%, bound 2/13 = 26/169 &#8776; 15.4%  </tspan><tspan fill="#5ddc8a" font-size="12.5" font-weight="700">25 &#8804; 26 &#10003;</tspan>
+  </text>
+
+  <text x="380" y="290" text-anchor="middle" font-family="SF Mono, Fira Code, Consolas, monospace">
+    <tspan fill="#8b96a8" font-size="11.5" font-weight="700">REAL FIELD&#160;&#160;&#160;</tspan><tspan fill="#5ddc8a" font-size="13" font-weight="700">p &#8776; 2<tspan dy="-6" font-size="65%">254</tspan><tspan dy="6"> and d = 2</tspan><tspan dy="-6" font-size="65%">20</tspan><tspan dy="6"> &#8594; chance &#8804; 2</tspan><tspan dy="-6" font-size="65%">&#8722;234</tspan><tspan dy="6"></tspan></tspan>
+  </text>
+
+  <line x1="40" y1="314" x2="720" y2="314" stroke="#223049" stroke-width="1" />
+  <text x="380" y="338" text-anchor="middle" fill="#8fdcff" font-size="15" font-weight="800" font-family="-apple-system,Arial,sans-serif">A NONZERO POLYNOMIAL ALMOST NEVER VANISHES AT RANDOM</text>
+  <text x="380" y="360" text-anchor="middle" fill="#8b96a8" font-size="12.5" font-family="-apple-system,Arial,sans-serif">This bound is the Schwartz&#8211;Zippel lemma.</text>
+</svg>
diff --git a/src/components/figures/SumcheckPreviewFigure.astro b/src/components/figures/SumcheckPreviewFigure.astro
new file mode 100644
index 0000000..2c2262c
--- /dev/null
+++ b/src/components/figures/SumcheckPreviewFigure.astro
@@ -0,0 +1,39 @@
+---
+// Fig. for "Multivariate & Multilinear Polynomials": a teaser for the
+// sumcheck protocol — peeling one variable off a claimed sum at a time,
+// using the same f(x,y) = 3 + 2x + 5y + 4xy from the table-to-polynomial
+// figure, whose hypercube sum is 3 + 5 + 8 + 1 = 17 = 4 in F(13).
+---
+<svg viewBox="0 0 760 400" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;display:block;">
+  <text x="380" y="26" text-anchor="middle" fill="#e9eef5" font-size="16" font-weight="800" font-family="-apple-system,Arial,sans-serif">preview: peeling off one variable</text>
+
+  <rect x="40" y="46" width="680" height="42" rx="10" fill="#111c2e" stroke="#3ab7ff" stroke-width="1.5" />
+  <text x="380" y="72" text-anchor="middle" fill="#8fdcff" font-size="13" font-weight="700" font-family="-apple-system,Arial,sans-serif">Can a prover convince a verifier of a sum without the verifier adding it up?</text>
+
+  <text x="380" y="122" text-anchor="middle" font-family="SF Mono, Fira Code, Consolas, monospace">
+    <tspan fill="#8b96a8" font-size="11.5" font-weight="700">CLAIM&#160;&#160;&#160;</tspan><tspan fill="#e9eef5" font-size="13" font-weight="700">sum over x, y in {"{0,1}"} of f(x, y) = 4</tspan>
+  </text>
+
+  <text x="380" y="154" text-anchor="middle" font-family="SF Mono, Fira Code, Consolas, monospace">
+    <tspan fill="#8b96a8" font-size="11.5" font-weight="700">ROUND 1&#160;&#160;&#160;</tspan><tspan fill="#8fdcff" font-size="13" font-weight="700">prover sends g&#8321;(x) = f(x,0) + f(x,1) = 11 + 8x, keeping x free</tspan>
+  </text>
+
+  <text x="380" y="186" text-anchor="middle" font-family="SF Mono, Fira Code, Consolas, monospace">
+    <tspan fill="#8b96a8" font-size="11.5" font-weight="700">CHECK&#160;&#160;&#160;</tspan><tspan fill="#5ddc8a" font-size="13" font-weight="700">g&#8321;(0) + g&#8321;(1) = 11 + 19 = 4, matches the claim &#10003;</tspan>
+  </text>
+
+  <text x="380" y="218" text-anchor="middle" font-family="SF Mono, Fira Code, Consolas, monospace">
+    <tspan fill="#8b96a8" font-size="11" font-weight="700">CHALLENGE&#160;&#160;&#160;</tspan><tspan fill="#e9eef5" font-size="13" font-weight="700">verifier picks a random r = 2, prover continues at x = 2</tspan>
+  </text>
+
+  <text x="380" y="250" text-anchor="middle" font-family="SF Mono, Fira Code, Consolas, monospace">
+    <tspan fill="#8b96a8" font-size="11.5" font-weight="700">ROUND 2&#160;&#160;&#160;</tspan><tspan fill="#5ddc8a" font-size="13" font-weight="700">new claim is g&#8321;(2) = 1, and only y is left to pin down</tspan>
+  </text>
+
+  <rect x="60" y="272" width="640" height="38" rx="10" fill="#0e1f16" stroke="#5ddc8a" stroke-width="1.8" />
+  <text x="380" y="296" text-anchor="middle" fill="#5ddc8a" font-size="13" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">two variables, two rounds, one small check each &#10003;</text>
+
+  <line x1="40" y1="326" x2="720" y2="326" stroke="#223049" stroke-width="1" />
+  <text x="380" y="350" text-anchor="middle" fill="#8fdcff" font-size="15" font-weight="800" font-family="-apple-system,Arial,sans-serif">N VARIABLES, N ROUNDS, ONE VARIABLE PEELED EACH TIME</text>
+  <text x="380" y="372" text-anchor="middle" fill="#8b96a8" font-size="12" font-family="-apple-system,Arial,sans-serif">This full protocol &#8212; the sumcheck &#8212; is coming up next in the series.</text>
+</svg>
diff --git a/src/components/figures/TableToPolynomialFigure.astro b/src/components/figures/TableToPolynomialFigure.astro
new file mode 100644
index 0000000..2547404
--- /dev/null
+++ b/src/components/figures/TableToPolynomialFigure.astro
@@ -0,0 +1,45 @@
