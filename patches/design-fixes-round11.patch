index 0000000..c1ad3c6
--- /dev/null
+++ b/src/components/figures/ClockWrapFigure.astro
@@ -0,0 +1,56 @@
+---
+// Fig. for "Modular Arithmetic": the clock analogy made literal — a hand
+// at 9 o'clock, 4 hours pass, and it lands on 1, not 13. Residue-style
+// tick labels (0 at the top, not 12) to match how the rest of this lesson
+// talks about remainders.
+const r = 85;
+const leftCx = 120;
+const rightCx = 560;
+const cy = 120;
+
+function handPoint(cx: number, hour: number, len: number) {
+  const angle = (hour / 12) * 2 * Math.PI - Math.PI / 2;
+  return { x: cx + Math.cos(angle) * len, y: cy + Math.sin(angle) * len };
+}
+const ticks = [0, 3, 6, 9];
+function tickLabel(cx: number, hour: number) {
+  // Just inside the rim (not outside it), so labels never collide with the
+  // title text sitting above the circle.
+  const angle = (hour / 12) * 2 * Math.PI - Math.PI / 2;
+  return { x: cx + Math.cos(angle) * (r - 18), y: cy + Math.sin(angle) * (r - 18) + 5 };
+}
+const leftHand = handPoint(leftCx, 9, r * 0.72);
+const rightHand = handPoint(rightCx, 1, r * 0.72);
+---
+<svg viewBox="0 0 680 260" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;display:block;">
+  <text x={leftCx} y="24" text-anchor="middle" fill="#8fdcff" font-size="16" font-weight="800" font-family="-apple-system,Arial,sans-serif">9 o'clock</text>
+  <circle cx={leftCx} cy={cy} r={r} fill="url(#bodyGrad)" stroke="#3ab7ff" stroke-width="2.5" />
+  {ticks.map((h) => {
+    const p = tickLabel(leftCx, h);
+    return <text x={p.x} y={p.y} text-anchor="middle" fill="#8b96a8" font-size="12" font-family="-apple-system,Arial,sans-serif">{h}</text>;
+  })}
+  <line x1={leftCx} y1={cy} x2={leftHand.x} y2={leftHand.y} stroke="#3ab7ff" stroke-width="3.5" stroke-linecap="round" />
+  <circle cx={leftCx} cy={cy} r="4.5" fill="#3ab7ff" />
+
+  <text x="340" y="70" text-anchor="middle" fill="#c3cedd" font-size="15" font-weight="700" font-family="-apple-system,Arial,sans-serif">+ 4 hrs</text>
+  <line x1="260" y1="110" x2="420" y2="110" stroke="#3ab7ff" stroke-width="1.6" marker-end="url(#clockwrap-arrow)" />
+  <text x="340" y="150" text-anchor="middle" fill="#e9eef5" font-size="15" font-weight="700" font-family="-apple-system,Arial,sans-serif">9 + 4 = 13</text>
+  <text x="340" y="172" text-anchor="middle" fill="#8fdcff" font-size="15" font-weight="700" font-family="-apple-system,Arial,sans-serif">13 mod 12 = 1</text>
+
+  <text x={rightCx} y="24" text-anchor="middle" fill="#8fdcff" font-size="16" font-weight="800" font-family="-apple-system,Arial,sans-serif">1 o'clock</text>
+  <circle cx={rightCx} cy={cy} r={r} fill="url(#bodyGrad)" stroke="#8fdcff" stroke-width="2.5" />
+  {ticks.map((h) => {
+    const p = tickLabel(rightCx, h);
+    return <text x={p.x} y={p.y} text-anchor="middle" fill="#8b96a8" font-size="12" font-family="-apple-system,Arial,sans-serif">{h}</text>;
+  })}
+  <line x1={rightCx} y1={cy} x2={rightHand.x} y2={rightHand.y} stroke="#8fdcff" stroke-width="3.5" stroke-linecap="round" />
+  <circle cx={rightCx} cy={cy} r="4.5" fill="#8fdcff" />
+
+  <text x="340" y="240" text-anchor="middle" fill="#8fdcff" font-size="13" font-weight="700" font-family="-apple-system,Arial,sans-serif">wraps around — 13 becomes 1 inside mod 12</text>
+
+  <defs>
+    <marker id="clockwrap-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6.5" markerHeight="6.5" orient="auto-start-reverse">
+      <path d="M0,0 L10,5 L0,10 z" fill="#3ab7ff" />
+    </marker>
+  </defs>
+</svg>
