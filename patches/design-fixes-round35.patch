diff --git a/src/components/figures/EasySquareRootFigure.astro b/src/components/figures/EasySquareRootFigure.astro
new file mode 100644
index 0000000..bc224a6
--- /dev/null
+++ b/src/components/figures/EasySquareRootFigure.astro
@@ -0,0 +1,32 @@
+---
+// Fig. for "Quadratic Residues & Square Roots": the p ≡ 3 (mod 4)
+// shortcut — a single exponentiation finds a square root directly,
+// worked through √3 mod 11, with a derivation of why it works from the
+// square test in the previous figure.
+---
+<svg viewBox="0 0 760 500" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;display:block;">
+  <text x="380" y="26" text-anchor="middle" fill="#e9eef5" font-size="16" font-weight="800" font-family="-apple-system,Arial,sans-serif">an easy square root</text>
+
+  <rect x="40" y="46" width="680" height="42" rx="10" fill="#111c2e" stroke="#3ab7ff" stroke-width="1.5" />
+  <text x="380" y="72" text-anchor="middle" fill="#8fdcff" font-size="13.5" font-weight="700" font-family="-apple-system,Arial,sans-serif">Find &#8730;3 mod 11. (11 leaves remainder 3 when divided by 4.)</text>
+
+  <rect x="40" y="96" width="680" height="42" rx="10" fill="#111c2e" stroke="#3ab7ff" stroke-width="1.5" />
+  <text x="380" y="122" text-anchor="middle" fill="#8fdcff" font-size="13.5" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">if p leaves remainder 3 mod 4, then &#8730;a = a<tspan dy="-6" font-size="65%">(p+1)/4</tspan></text>
+
+  <text x="380" y="160" text-anchor="middle" fill="#8b96a8" font-size="12" font-weight="700" font-family="-apple-system,Arial,sans-serif">STEP 1 &#8212; is 3 a square?</text>
+  <text x="380" y="186" text-anchor="middle" fill="#5ddc8a" font-size="14" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">3<tspan dy="-6" font-size="65%">5</tspan><tspan dy="6"> = 243 = 22 &#215; 11 + 1 = 1 &#10003;</tspan></text>
+
+  <text x="380" y="222" text-anchor="middle" fill="#8b96a8" font-size="12" font-weight="700" font-family="-apple-system,Arial,sans-serif">STEP 2 &#8212; apply the formula</text>
+  <text x="380" y="248" text-anchor="middle" fill="#e9eef5" font-size="14" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">(11 + 1) &#247; 4 = 3, so &#8730;3 = 3<tspan dy="-6" font-size="65%">3</tspan><tspan dy="6"> = 27 = 5</tspan></text>
+
+  <text x="380" y="284" text-anchor="middle" fill="#8b96a8" font-size="12" font-weight="700" font-family="-apple-system,Arial,sans-serif">STEP 3 &#8212; check</text>
+  <text x="380" y="310" text-anchor="middle" fill="#e9eef5" font-size="14" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">5<tspan dy="-6" font-size="65%">2</tspan><tspan dy="6"> = 25 = 2 &#215; 11 + 3 = 3 &#10003;</tspan></text>
+  <text x="380" y="334" text-anchor="middle" fill="#e9eef5" font-size="13.5" font-family="SF Mono, Fira Code, Consolas, monospace">the other root is &#8722;5 = 6: 6<tspan dy="-6" font-size="65%">2</tspan><tspan dy="6"> = 36 = 3 &#215; 11 + 3 = 3 &#10003;</tspan></text>
+
+  <text x="380" y="368" text-anchor="middle" fill="#8b96a8" font-size="12" font-weight="700" font-family="-apple-system,Arial,sans-serif">STEP 4 &#8212; why it works</text>
+  <text x="380" y="392" text-anchor="middle" fill="#c3cedd" font-size="13" font-family="SF Mono, Fira Code, Consolas, monospace">(a<tspan dy="-6" font-size="65%">(p+1)&#247;4</tspan><tspan dy="6">)</tspan><tspan dy="-6" font-size="65%">2</tspan><tspan dy="6"> = a</tspan><tspan dy="-6" font-size="65%">(p+1)&#247;2</tspan><tspan dy="6"> = a &#215; a</tspan><tspan dy="-6" font-size="65%">(p&#8722;1)&#247;2</tspan><tspan dy="6"> = a &#215; 1 = a</tspan></text>
+
+  <line x1="40" y1="410" x2="720" y2="410" stroke="#223049" stroke-width="1" />
+  <text x="380" y="434" text-anchor="middle" fill="#8fdcff" font-size="15.5" font-weight="800" font-family="-apple-system,Arial,sans-serif">A SQUARE ROOT IS JUST A POWER</text>
+  <text x="380" y="456" text-anchor="middle" fill="#8b96a8" font-size="12.5" font-family="-apple-system,Arial,sans-serif">This works when p leaves remainder 3 when divided by 4.</text>
+</svg>
diff --git a/src/components/figures/HashToCurveFigure.astro b/src/components/figures/HashToCurveFigure.astro
new file mode 100644
index 0000000..e3e0f95
--- /dev/null
+++ b/src/components/figures/HashToCurveFigure.astro
@@ -0,0 +1,28 @@
+---
+// Fig. for "Quadratic Residues & Square Roots": the reverse direction of
+// point compression — mapping an arbitrary number onto the curve by
+// trying it as x, testing whether the resulting y² is a square, and
+// incrementing until one works (a basic hash-to-curve).
+---
+<svg viewBox="0 0 760 460" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;display:block;">
+  <text x="380" y="26" text-anchor="middle" fill="#e9eef5" font-size="16" font-weight="800" font-family="-apple-system,Arial,sans-serif">turning a number into a point</text>
+
+  <rect x="40" y="46" width="680" height="42" rx="10" fill="#111c2e" stroke="#3ab7ff" stroke-width="1.5" />
+  <text x="380" y="72" text-anchor="middle" fill="#8fdcff" font-size="13" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">Can we turn any number into a point on y<tspan dy="-6" font-size="65%">2</tspan><tspan dy="6"> = x</tspan><tspan dy="-6" font-size="65%">3</tspan><tspan dy="6"> + 3 mod 13?</tspan></text>
+
+  <text x="380" y="108" text-anchor="middle" fill="#8b96a8" font-size="12" font-weight="700" font-family="-apple-system,Arial,sans-serif">STEP 1 &#8212; try x = 2</text>
+  <text x="380" y="132" text-anchor="middle" fill="#ff5c7a" font-size="13.5" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">y<tspan dy="-6" font-size="65%">2</tspan><tspan dy="6"> = 2</tspan><tspan dy="-6" font-size="65%">3</tspan><tspan dy="6"> + 3 = 11. Square test: 11 = &#8722;2, so 11</tspan><tspan dy="-6" font-size="65%">6</tspan><tspan dy="6"> = (&#8722;2)</tspan><tspan dy="-6" font-size="65%">6</tspan><tspan dy="6"> = 64 = &#8722;1 &#10007;</tspan></text>
+
+  <text x="380" y="166" text-anchor="middle" fill="#8b96a8" font-size="12" font-weight="700" font-family="-apple-system,Arial,sans-serif">STEP 2 &#8212; increment to x = 3</text>
+  <text x="380" y="190" text-anchor="middle" fill="#5ddc8a" font-size="13.5" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">y<tspan dy="-6" font-size="65%">2</tspan><tspan dy="6"> = 3</tspan><tspan dy="-6" font-size="65%">3</tspan><tspan dy="6"> + 3 = 30 = 4. Square test: 4</tspan><tspan dy="-6" font-size="65%">6</tspan><tspan dy="6"> = 4096 = 315 &#215; 13 + 1 = 1 &#10003;</tspan></text>
+
+  <text x="380" y="224" text-anchor="middle" fill="#8b96a8" font-size="12" font-weight="700" font-family="-apple-system,Arial,sans-serif">STEP 3 &#8212; take the root</text>
+  <text x="380" y="250" text-anchor="middle" fill="#5ddc8a" font-size="14" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">y = 2 (or 11), giving the point (3, 2)</text>
+
+  <text x="380" y="284" text-anchor="middle" fill="#8b96a8" font-size="12.5" font-family="SF Mono, Fira Code, Consolas, monospace">2<tspan dy="-6" font-size="65%">2</tspan><tspan dy="6"> = 4 and 3</tspan><tspan dy="-6" font-size="65%">3</tspan><tspan dy="6"> + 3 = 30 = 4 &#10003;</tspan></text>
+  <text x="380" y="308" text-anchor="middle" fill="#8b96a8" font-size="12.5" font-style="italic" font-family="-apple-system,Arial,sans-serif">this is the simplest method; real systems use more careful versions</text>
+
+  <line x1="40" y1="326" x2="720" y2="326" stroke="#223049" stroke-width="1" />
+  <text x="380" y="352" text-anchor="middle" fill="#8fdcff" font-size="15.5" font-weight="800" font-family="-apple-system,Arial,sans-serif">TRY, TEST, INCREMENT</text>
+  <text x="380" y="374" text-anchor="middle" fill="#8b96a8" font-size="12.5" font-family="-apple-system,Arial,sans-serif">On a real curve about half of all x values work, so a few tries are enough.</text>
+</svg>
diff --git a/src/components/figures/LegendreSquareTestFigure.astro b/src/components/figures/LegendreSquareTestFigure.astro
new file mode 100644
index 0000000..251a875
--- /dev/null
+++ b/src/components/figures/LegendreSquareTestFigure.astro
@@ -0,0 +1,34 @@
+---
+// Fig. for "Quadratic Residues & Square Roots": the square test (the
+// Legendre symbol) — raising a to (p − 1) / 2 answers "is a a square mod
+// p?" in one exponentiation, derived from the even/odd-power picture in
+// the previous figure and checked against four example values mod 13.
+---
+<svg viewBox="0 0 760 500" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;display:block;">
+  <text x="380" y="26" text-anchor="middle" fill="#e9eef5" font-size="16" font-weight="800" font-family="-apple-system,Arial,sans-serif">the square test</text>
+
+  <rect x="40" y="46" width="680" height="42" rx="10" fill="#111c2e" stroke="#3ab7ff" stroke-width="1.5" />
+  <text x="380" y="72" text-anchor="middle" fill="#8fdcff" font-size="13.5" font-weight="700" font-family="-apple-system,Arial,sans-serif">Is there a quick test for whether a is a square mod p?</text>
+
+  <rect x="40" y="96" width="680" height="42" rx="10" fill="#111c2e" stroke="#3ab7ff" stroke-width="1.5" />
+  <text x="380" y="122" text-anchor="middle" fill="#8fdcff" font-size="13.5" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">a<tspan dy="-7" font-size="65%">(p&#8722;1)/2</tspan><tspan dy="7"> = 1 if a is a square, &#8722;1 if it is not</tspan></text>
+
+  <text x="380" y="160" text-anchor="middle" fill="#8b96a8" font-size="12" font-weight="700" font-family="-apple-system,Arial,sans-serif">STEP 1 &#8212; why it works (p = 13, so the power is 6)</text>
+  <text x="380" y="184" text-anchor="middle" fill="#e9eef5" font-size="13.5" font-family="SF Mono, Fira Code, Consolas, monospace">write a = 2<tspan dy="-6" font-size="65%">k</tspan><tspan dy="6">. Then a</tspan><tspan dy="-6" font-size="65%">6</tspan><tspan dy="6"> = 2</tspan><tspan dy="-6" font-size="65%">6k</tspan></text>
+  <text x="380" y="208" text-anchor="middle" fill="#c3cedd" font-size="13" font-family="SF Mono, Fira Code, Consolas, monospace">if k is even, 2<tspan dy="-6" font-size="65%">6k</tspan><tspan dy="6"> = (2</tspan><tspan dy="-6" font-size="65%">12</tspan><tspan dy="6">)</tspan><tspan dy="-6" font-size="65%">k&#247;2</tspan><tspan dy="6"> = 1</tspan></text>
+  <text x="380" y="232" text-anchor="middle" fill="#c3cedd" font-size="13" font-family="SF Mono, Fira Code, Consolas, monospace">if k is odd, we get 2<tspan dy="-6" font-size="65%">6</tspan><tspan dy="6"> = 64 = 12 = &#8722;1</tspan></text>
+
+  <line x1="40" y1="250" x2="720" y2="250" stroke="#223049" stroke-width="1" />
+
+  <text x="380" y="276" text-anchor="middle" fill="#8b96a8" font-size="12" font-weight="700" font-family="-apple-system,Arial,sans-serif">STEP 2 &#8212; try it</text>
+  <text x="380" y="300" text-anchor="middle" fill="#5ddc8a" font-size="13.5" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">3<tspan dy="-6" font-size="65%">6</tspan><tspan dy="6"> = 729 = 56 &#215; 13 + 1 = 1 &#10003;  square</tspan></text>
+  <text x="380" y="324" text-anchor="middle" fill="#ff5c7a" font-size="13.5" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">2<tspan dy="-6" font-size="65%">6</tspan><tspan dy="6"> = 64 = 12 = &#8722;1 &#10007;  not a square</tspan></text>
+  <text x="380" y="348" text-anchor="middle" fill="#ff5c7a" font-size="13.5" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">5<tspan dy="-6" font-size="65%">6</tspan><tspan dy="6"> = (5</tspan><tspan dy="-6" font-size="65%">2</tspan><tspan dy="6">)</tspan><tspan dy="-6" font-size="65%">3</tspan><tspan dy="6"> = (&#8722;1)</tspan><tspan dy="-6" font-size="65%">3</tspan><tspan dy="6"> = &#8722;1 &#10007;  not a square</tspan></text>
+  <text x="380" y="372" text-anchor="middle" fill="#5ddc8a" font-size="13.5" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">10<tspan dy="-6" font-size="65%">6</tspan><tspan dy="6"> = (10</tspan><tspan dy="-6" font-size="65%">3</tspan><tspan dy="6">)</tspan><tspan dy="-6" font-size="65%">2</tspan><tspan dy="6"> = (&#8722;1)</tspan><tspan dy="-6" font-size="65%">2</tspan><tspan dy="6"> = 1 &#10003;  square</tspan></text>
+
+  <text x="380" y="404" text-anchor="middle" fill="#8b96a8" font-size="12.5" font-family="-apple-system,Arial,sans-serif">matches the table: 3 and 10 are squares, 2 and 5 are not &#10003;</text>
+
+  <line x1="40" y1="422" x2="720" y2="422" stroke="#223049" stroke-width="1" />
+  <text x="380" y="448" text-anchor="middle" fill="#8fdcff" font-size="15.5" font-weight="800" font-family="-apple-system,Arial,sans-serif">ONE POWER TELLS SQUARE FROM NON-SQUARE</text>
+  <text x="380" y="470" text-anchor="middle" fill="#8b96a8" font-size="12.5" font-family="-apple-system,Arial,sans-serif">This is the Legendre symbol, written (a / p).</text>
+</svg>
diff --git a/src/components/figures/PointCompressionFigure.astro b/src/components/figures/PointCompressionFigure.astro
new file mode 100644
index 0000000..974055b
--- /dev/null
+++ b/src/components/figures/PointCompressionFigure.astro
@@ -0,0 +1,34 @@
+---
+// Fig. for "Quadratic Residues & Square Roots": point compression — a
+// curve point's x almost determines y, so storing one parity bit instead
+// of the full y coordinate is enough to rebuild it with a square root,
+// worked through the point (3, 11) on y² = x³ + 3 mod 13.
+---
+<svg viewBox="0 0 760 540" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;display:block;">
+  <text x="380" y="26" text-anchor="middle" fill="#e9eef5" font-size="16" font-weight="800" font-family="-apple-system,Arial,sans-serif">one extra bit instead of y</text>
+
+  <rect x="40" y="46" width="680" height="42" rx="10" fill="#111c2e" stroke="#3ab7ff" stroke-width="1.5" />
+  <text x="380" y="72" text-anchor="middle" fill="#8fdcff" font-size="13" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">On the curve y<tspan dy="-6" font-size="65%">2</tspan><tspan dy="6"> = x</tspan><tspan dy="-6" font-size="65%">3</tspan><tspan dy="6"> + 3 mod 13, can we store (3, 11) with x and one bit?</tspan></text>
+
+  <text x="380" y="108" text-anchor="middle" fill="#8b96a8" font-size="12" font-weight="700" font-family="-apple-system,Arial,sans-serif">STEP 1 &#8212; compress</text>
+  <text x="380" y="132" text-anchor="middle" fill="#e9eef5" font-size="13.5" font-family="SF Mono, Fira Code, Consolas, monospace">keep x = 3, and one bit for the parity of y: 11 is odd, so bit = 1</text>
+
+  <text x="380" y="166" text-anchor="middle" fill="#8b96a8" font-size="12" font-weight="700" font-family="-apple-system,Arial,sans-serif">STEP 2 &#8212; decompress, compute y<tspan dy="-5" font-size="70%">2</tspan></text>
+  <text x="380" y="190" text-anchor="middle" fill="#e9eef5" font-size="14" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">y<tspan dy="-6" font-size="65%">2</tspan><tspan dy="6"> = 3</tspan><tspan dy="-6" font-size="65%">3</tspan><tspan dy="6"> + 3 = 30 = 4 (mod 13)</tspan></text>
+
+  <text x="380" y="224" text-anchor="middle" fill="#8b96a8" font-size="12" font-weight="700" font-family="-apple-system,Arial,sans-serif">STEP 3 &#8212; take the square root</text>
+  <text x="380" y="248" text-anchor="middle" fill="#e9eef5" font-size="13.5" font-family="SF Mono, Fira Code, Consolas, monospace">y = &#177;2, so the candidates are 2 and 11 (since &#8722;2 = 11)</text>
+
+  <text x="380" y="282" text-anchor="middle" fill="#8b96a8" font-size="12" font-weight="700" font-family="-apple-system,Arial,sans-serif">STEP 4 &#8212; pick by the bit</text>
+  <text x="380" y="306" text-anchor="middle" fill="#5ddc8a" font-size="14" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">the bit says odd, so y = 11</text>
+
+  <rect x="190" y="326" width="380" height="46" rx="10" fill="#0e1f16" stroke="#5ddc8a" stroke-width="1.8" />
+  <text x="380" y="356" text-anchor="middle" fill="#5ddc8a" font-size="14.5" font-weight="800" font-family="-apple-system,Arial,sans-serif">(3, 11) recovered from x = 3 and one bit</text>
+
+  <text x="380" y="398" text-anchor="middle" fill="#8b96a8" font-size="12.5" font-family="SF Mono, Fira Code, Consolas, monospace">11<tspan dy="-6" font-size="65%">2</tspan><tspan dy="6"> = 121 = 9 &#215; 13 + 4 &#10003;</tspan></text>
+  <text x="380" y="422" text-anchor="middle" fill="#ff5c7a" font-size="12.5" font-family="-apple-system,Arial,sans-serif">if y<tspan dy="-5" font-size="70%">2</tspan><tspan dy="5"> is not a square, such as x = 2 giving 11, there is no point with that x</tspan></text>
+
+  <line x1="40" y1="442" x2="720" y2="442" stroke="#223049" stroke-width="1" />
+  <text x="380" y="468" text-anchor="middle" fill="#8fdcff" font-size="15.5" font-weight="800" font-family="-apple-system,Arial,sans-serif">A SQUARE ROOT REBUILDS THE MISSING HALF</text>
+  <text x="380" y="490" text-anchor="middle" fill="#8b96a8" font-size="12.5" font-family="-apple-system,Arial,sans-serif">Compressed public keys use this same idea.</text>
+</svg>
diff --git a/src/components/figures/QuadResSummaryFigure.astro b/src/components/figures/QuadResSummaryFigure.astro
new file mode 100644
index 0000000..610702d
--- /dev/null
+++ b/src/components/figures/QuadResSummaryFigure.astro
@@ -0,0 +1,38 @@
+---
+// Fig. for "Quadratic Residues & Square Roots": where these tools show
+// up — mirrors the three-column summary pattern used by the entropy and
+// Euclid/CRT/Euler lessons' closing figures.
+---
+<svg viewBox="0 0 760 430" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;display:block;">
+  <text x="380" y="26" text-anchor="middle" fill="#e9eef5" font-size="16" font-weight="800" font-family="-apple-system,Arial,sans-serif">where these tools show up</text>
+
+  <!-- the square test -->
+  <rect x="30" y="56" width="220" height="230" rx="12" fill="#121c2c" stroke="#3ab7ff" stroke-width="1.8" />
+  <text x="140" y="90" text-anchor="middle" fill="#8fdcff" font-size="14.5" font-weight="800" font-family="-apple-system,Arial,sans-serif">THE SQUARE TEST</text>
+  <text x="140" y="130" text-anchor="middle" fill="#c3cedd" font-size="12" font-family="-apple-system,Arial,sans-serif">is this number a square?</text>
+  <text x="140" y="148" text-anchor="middle" fill="#c3cedd" font-size="12" font-family="-apple-system,Arial,sans-serif">one exponentiation</text>
+  <text x="140" y="166" text-anchor="middle" fill="#c3cedd" font-size="12" font-family="-apple-system,Arial,sans-serif">answers it</text>
+  <text x="140" y="256" text-anchor="middle" fill="#5ddc8a" font-size="12.5" font-style="italic" font-family="-apple-system,Arial,sans-serif">A fast yes or no.</text>
+
+  <!-- square roots -->
+  <rect x="270" y="56" width="220" height="230" rx="12" fill="#121c2c" stroke="#5ddc8a" stroke-width="1.8" />
+  <text x="380" y="90" text-anchor="middle" fill="#5ddc8a" font-size="14.5" font-weight="800" font-family="-apple-system,Arial,sans-serif">SQUARE ROOTS</text>
+  <text x="380" y="130" text-anchor="middle" fill="#c3cedd" font-size="12" font-family="-apple-system,Arial,sans-serif">a shortcut when p leaves</text>
+  <text x="380" y="148" text-anchor="middle" fill="#c3cedd" font-size="12" font-family="-apple-system,Arial,sans-serif">remainder 3 mod 4,</text>
+  <text x="380" y="166" text-anchor="middle" fill="#c3cedd" font-size="12" font-family="-apple-system,Arial,sans-serif">and Tonelli&#8211;Shanks</text>
+  <text x="380" y="184" text-anchor="middle" fill="#c3cedd" font-size="12" font-family="-apple-system,Arial,sans-serif">otherwise</text>
+  <text x="380" y="256" text-anchor="middle" fill="#5ddc8a" font-size="12.5" font-style="italic" font-family="-apple-system,Arial,sans-serif">Solving y&#178; = a.</text>
+
+  <!-- compression and hash-to-curve -->
+  <rect x="510" y="56" width="220" height="230" rx="12" fill="#121c2c" stroke="#8fdcff" stroke-width="1.8" />
+  <text x="620" y="84" text-anchor="middle" fill="#8fdcff" font-size="14.5" font-weight="800" font-family="-apple-system,Arial,sans-serif">COMPRESSION AND</text>
+  <text x="620" y="104" text-anchor="middle" fill="#8fdcff" font-size="14.5" font-weight="800" font-family="-apple-system,Arial,sans-serif">HASH-TO-CURVE</text>
