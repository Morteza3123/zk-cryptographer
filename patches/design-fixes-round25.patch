+  <line x1="630" y1="101" x2="678" y2="128" stroke="#5ddc8a" stroke-width="1.6" marker-end="url(#hb-arrow-g)" />
+  <line x1="630" y1="185" x2="678" y2="158" stroke="#5ddc8a" stroke-width="1.6" marker-end="url(#hb-arrow-g)" />
+
+  <rect x="680" y="108" width="100" height="70" rx="9" fill="#0d1526" stroke="#e9eef5" stroke-width="1.8" />
+  <text x="730" y="148" text-anchor="middle" fill="#e9eef5" font-size="13.5" font-weight="700" font-family="-apple-system,Arial,sans-serif">Commit</text>
