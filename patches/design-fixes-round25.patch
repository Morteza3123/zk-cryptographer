+  <text x="800" y="120" text-anchor="middle" fill="#ff8080" font-size="11.5" font-weight="800" font-family="-apple-system,Arial,sans-serif">BLOCKED</text>
+
+  <text x="730" y="222" text-anchor="middle" fill="#8b96a8" font-size="12.5" font-family="-apple-system,Arial,sans-serif">same C cannot open to</text>
+  <text x="730" y="240" text-anchor="middle" fill="#8b96a8" font-size="12.5" font-family="-apple-system,Arial,sans-serif">two different messages</text>
