+---
+// Fig. for "Commitment Schemes": the two properties a commitment scheme
+// must have at once — hiding (C alone reveals nothing about m) and
+// binding (the same C can never be opened to two different messages).
+---
+<svg viewBox="0 0 920 460" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;display:block;">
+  <text x="460" y="30" text-anchor="middle" fill="#e9eef5" font-size="17" font-weight="800" font-family="-apple-system,Arial,sans-serif">two promises, both have to hold at once</text>
+
+  <line x1="450" y1="48" x2="450" y2="400" stroke="#1a2436" stroke-width="1" stroke-dasharray="4 5" />
+
+  <!-- LEFT: hiding -->
+  <text x="225" y="68" text-anchor="middle" fill="#5ddc8a" font-size="14" font-weight="800" font-family="-apple-system,Arial,sans-serif">HIDING</text>
+
+  <rect x="40" y="86" width="110" height="48" rx="9" fill="#121c2c" stroke="#5ddc8a" stroke-width="1.6" />
+  <text x="95" y="115" text-anchor="middle" fill="#e9eef5" font-size="14" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">m = 42</text>
+  <line x1="150" y1="110" x2="184" y2="110" stroke="#e9eef5" stroke-width="1.8" marker-end="url(#hb-arrow-w)" />
+
+  <rect x="186" y="86" width="100" height="48" rx="9" fill="#0d1526" stroke="#e9eef5" stroke-width="1.8" />
+  <text x="236" y="115" text-anchor="middle" fill="#e9eef5" font-size="13.5" font-weight="700" font-family="-apple-system,Arial,sans-serif">Commit</text>
+  <line x1="286" y1="110" x2="320" y2="110" stroke="#8fdcff" stroke-width="1.8" marker-end="url(#hb-arrow-c)" />
+
+  <rect x="322" y="86" width="60" height="48" rx="9" fill="#0a0f19" stroke="#8fdcff" stroke-width="2" />
+  <text x="352" y="117" text-anchor="middle" fill="#8fdcff" font-size="18" font-weight="800" font-family="SF Mono, Fira Code, Consolas, monospace">C</text>
+
+  <text x="235" y="196" text-anchor="middle" fill="#e9eef5" font-size="13" font-weight="700" font-family="-apple-system,Arial,sans-serif">C alone reveals</text>
+  <text x="235" y="214" text-anchor="middle" fill="#e9eef5" font-size="13" font-weight="700" font-family="-apple-system,Arial,sans-serif">NOTHING about m</text>
