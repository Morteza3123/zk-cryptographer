+  <line x1="370" y1="134" x2="400" y2="236" stroke="#5ddc8a" stroke-width="1" stroke-dasharray="3 3" />
+
+  <rect x="40" y="238" width="170" height="40" rx="18" fill="none" stroke="#5ddc8a" stroke-width="1.4" stroke-dasharray="5 4" />
+  <text x="125" y="263" text-anchor="middle" fill="#5ddc8a" font-size="13" font-family="SF Mono, Fira Code, Consolas, monospace">m = 42 ?</text>
+
+  <rect x="320" y="238" width="140" height="40" rx="18" fill="none" stroke="#5ddc8a" stroke-width="1.4" stroke-dasharray="5 4" />
+  <text x="390" y="263" text-anchor="middle" fill="#5ddc8a" font-size="13" font-family="SF Mono, Fira Code, Consolas, monospace">m = 7 ?</text>
+
+  <text x="225" y="312" text-anchor="middle" fill="#8b96a8" font-size="12.5" font-family="-apple-system,Arial,sans-serif">both are equally plausible</text>
+
+  <!-- RIGHT: binding -->
+  <text x="685" y="68" text-anchor="middle" fill="#8fdcff" font-size="14" font-weight="800" font-family="-apple-system,Arial,sans-serif">BINDING</text>
+
+  <rect x="480" y="78" width="150" height="46" rx="9" fill="#121c2c" stroke="#5ddc8a" stroke-width="1.6" />
+  <text x="555" y="106" text-anchor="middle" fill="#e9eef5" font-size="14" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">m&#8321; = 42</text>
+
