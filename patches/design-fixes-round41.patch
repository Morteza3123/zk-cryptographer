diff --git a/src/components/figures/CodewordDistanceFigure.astro b/src/components/figures/CodewordDistanceFigure.astro
new file mode 100644
index 0000000..b9e94dc
--- /dev/null
+++ b/src/components/figures/CodewordDistanceFigure.astro
@@ -0,0 +1,38 @@
+---
+// Fig. for "Coding Theory": why two Reed–Solomon codewords are forced
+// apart — two degree-1 polynomials can agree in at most one point, so
+// their codewords differ in n − k + 1 of n places.
+---
+<svg viewBox="0 0 760 380" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;display:block;">
+  <text x="380" y="26" text-anchor="middle" fill="#e9eef5" font-size="16" font-weight="800" font-family="-apple-system,Arial,sans-serif">how far apart are two codewords?</text>
+
+  <rect x="40" y="46" width="680" height="42" rx="10" fill="#111c2e" stroke="#3ab7ff" stroke-width="1.5" />
+  <text x="380" y="72" text-anchor="middle" fill="#8fdcff" font-size="13" font-weight="700" font-family="-apple-system,Arial,sans-serif">How different are two Reed&#8211;Solomon codewords, really?</text>
+
+  <text x="380" y="122" text-anchor="middle" font-family="SF Mono, Fira Code, Consolas, monospace">
+    <tspan fill="#8b96a8" font-size="11" font-weight="700">TWO MESSAGES&#160;&#160;&#160;</tspan><tspan fill="#e9eef5" font-size="13" font-weight="700">f(x) = 3 + 5x and g(x) = 1 + 6x</tspan>
+  </text>
+
+  <text x="380" y="154" text-anchor="middle" font-family="SF Mono, Fira Code, Consolas, monospace">
+    <tspan fill="#8b96a8" font-size="11.5" font-weight="700">CODEWORDS&#160;&#160;&#160;</tspan><tspan fill="#e9eef5" font-size="13" font-weight="700">f &#8594; (3,8,0,5,10) and g &#8594; (1,7,0,6,12)</tspan>
+  </text>
+
+  <text x="380" y="186" text-anchor="middle" font-family="SF Mono, Fira Code, Consolas, monospace">
+    <tspan fill="#8b96a8" font-size="11" font-weight="700">DIFFERENCE&#160;&#160;&#160;</tspan><tspan fill="#e9eef5" font-size="13" font-weight="700">f &#8722; g = 2 &#8722; x, which has only one root, x = 2</tspan>
+  </text>
+
+  <text x="380" y="218" text-anchor="middle" font-family="SF Mono, Fira Code, Consolas, monospace">
+    <tspan fill="#8b96a8" font-size="11.5" font-weight="700">AGREE&#160;&#160;&#160;</tspan><tspan fill="#e9eef5" font-size="12.5" font-weight="700">only at x = 2, where both give 0 &#8594; they differ in 4 of 5 places</tspan>
+  </text>
+
+  <text x="380" y="250" text-anchor="middle" font-family="SF Mono, Fira Code, Consolas, monospace">
+    <tspan fill="#8b96a8" font-size="11.5" font-weight="700">RULE&#160;&#160;&#160;</tspan><tspan fill="#8fdcff" font-size="12.5" font-weight="700">two different polynomials of degree below k agree in at most k &#8722; 1 points</tspan>
+  </text>
+
+  <rect x="140" y="270" width="480" height="36" rx="10" fill="#0e1f16" stroke="#5ddc8a" stroke-width="1.8" />
+  <text x="380" y="293" text-anchor="middle" fill="#5ddc8a" font-size="14" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">d = n &#8722; k + 1 = 5 &#8722; 2 + 1 = 4 &#10003;</text>
+
+  <line x1="40" y1="322" x2="720" y2="322" stroke="#223049" stroke-width="1" />
+  <text x="380" y="346" text-anchor="middle" fill="#8fdcff" font-size="15" font-weight="800" font-family="-apple-system,Arial,sans-serif">EACH EXTRA EVALUATION ADDS ANOTHER PLACE CODEWORDS DIFFER</text>
+  <text x="380" y="368" text-anchor="middle" fill="#8b96a8" font-size="12.5" font-family="-apple-system,Arial,sans-serif">The same root-counting fact behind the Schwartz&#8211;Zippel lemma.</text>
+</svg>
diff --git a/src/components/figures/CorruptedNumberFigure.astro b/src/components/figures/CorruptedNumberFigure.astro
new file mode 100644
index 0000000..6c2941f
--- /dev/null
+++ b/src/components/figures/CorruptedNumberFigure.astro
@@ -0,0 +1,38 @@
+---
+// Fig. for "Coding Theory": decoding past a single changed value by
+// finding the closest codeword, and why two errors can create a tie.
+---
+<svg viewBox="0 0 760 420" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;display:block;">
+  <text x="380" y="26" text-anchor="middle" fill="#e9eef5" font-size="16" font-weight="800" font-family="-apple-system,Arial,sans-serif">finding a corrupted number</text>
+
+  <rect x="40" y="46" width="680" height="42" rx="10" fill="#111c2e" stroke="#3ab7ff" stroke-width="1.5" />
+  <text x="380" y="72" text-anchor="middle" fill="#8fdcff" font-size="13" font-weight="700" font-family="-apple-system,Arial,sans-serif">One number was changed and we don't know which. Can we still decode?</text>
+
+  <text x="380" y="122" text-anchor="middle" font-family="SF Mono, Fira Code, Consolas, monospace">
+    <tspan fill="#8b96a8" font-size="11.5" font-weight="700">RECEIVED&#160;&#160;&#160;</tspan><tspan fill="#e9eef5" font-size="13.5" font-weight="700">(3, 8, 0, 9, 10)</tspan>
+  </text>
+
+  <text x="380" y="154" text-anchor="middle" font-family="SF Mono, Fira Code, Consolas, monospace">
+    <tspan fill="#8b96a8" font-size="11.5" font-weight="700">TRY&#160;&#160;&#160;</tspan><tspan fill="#e9eef5" font-size="13" font-weight="700">the line 3 + 5x matches 4 of 5 numbers, all except x = 3</tspan>
+  </text>
+
+  <text x="380" y="186" text-anchor="middle" font-family="SF Mono, Fira Code, Consolas, monospace">
+    <tspan fill="#8b96a8" font-size="10.5" font-weight="700">ANY OTHER CODEWORD&#160;&#160;&#160;</tspan><tspan fill="#e9eef5" font-size="12" font-weight="700">differs from the sent word in &#8805; 4 places, so matches received in &#8804; 2</tspan>
+  </text>
+
+  <rect x="80" y="206" width="600" height="38" rx="10" fill="#0e1f16" stroke="#5ddc8a" stroke-width="1.8" />
+  <text x="380" y="230" text-anchor="middle" fill="#5ddc8a" font-size="13.5" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">decode to 3 + 5x &#8212; the error is at x = 3: received 9, correct value 5 &#10003;</text>
+
+  <text x="380" y="270" text-anchor="middle" font-family="SF Mono, Fira Code, Consolas, monospace">
+    <tspan fill="#8b96a8" font-size="11" font-weight="700">TWO ERRORS&#160;&#160;&#160;</tspan><tspan fill="#ff5c7a" font-size="12.5" font-weight="700">(3,8,0,6,12) is distance 2 from both codewords</tspan>
+  </text>
+  <text x="380" y="296" text-anchor="middle" fill="#ff5c7a" font-size="13" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">a tie &#8212; we know something's wrong but not which codeword was sent &#10007;</text>
+
+  <text x="380" y="328" text-anchor="middle" font-family="SF Mono, Fira Code, Consolas, monospace">
+    <tspan fill="#8b96a8" font-size="11.5" font-weight="700">RULE&#160;&#160;&#160;</tspan><tspan fill="#8fdcff" font-size="13" font-weight="700">correcting t errors needs d &#8805; 2t + 1; here d = 4, so t = 1</tspan>
+  </text>
+
+  <line x1="40" y1="358" x2="720" y2="358" stroke="#223049" stroke-width="1" />
+  <text x="380" y="382" text-anchor="middle" fill="#8fdcff" font-size="15" font-weight="800" font-family="-apple-system,Arial,sans-serif">THE CLOSEST CODEWORD WINS, UNDER HALF THE DISTANCE</text>
+  <text x="380" y="404" text-anchor="middle" fill="#8b96a8" font-size="12.5" font-family="-apple-system,Arial,sans-serif">Real decoders find the winner fast, without trying every line.</text>
+</svg>
diff --git a/src/components/figures/ErasureRecoveryFigure.astro b/src/components/figures/ErasureRecoveryFigure.astro
new file mode 100644
index 0000000..81f6d57
--- /dev/null
+++ b/src/components/figures/ErasureRecoveryFigure.astro
@@ -0,0 +1,47 @@
+---
+// Fig. for "Coding Theory": recovering a message from two surviving
+// points after three of five sent numbers are erased — rebuilding the
+// line through (1, 8) and (3, 5) over F(13).
+---
+<svg viewBox="0 0 760 440" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;display:block;">
+  <text x="380" y="26" text-anchor="middle" fill="#e9eef5" font-size="16" font-weight="800" font-family="-apple-system,Arial,sans-serif">recovering lost numbers</text>
+
+  <rect x="40" y="46" width="680" height="42" rx="10" fill="#111c2e" stroke="#3ab7ff" stroke-width="1.5" />
+  <text x="380" y="72" text-anchor="middle" fill="#8fdcff" font-size="13" font-weight="700" font-family="-apple-system,Arial,sans-serif">Three of the five numbers are lost. Can we still get the message back?</text>
+
+  <text x="380" y="122" text-anchor="middle" font-family="SF Mono, Fira Code, Consolas, monospace">
+    <tspan fill="#8b96a8" font-size="11.5" font-weight="700">SENT&#160;&#160;&#160;</tspan><tspan fill="#e9eef5" font-size="13.5" font-weight="700">(3, 8, 0, 5, 10)</tspan>
+  </text>
+
+  <text x="380" y="154" text-anchor="middle" font-family="SF Mono, Fira Code, Consolas, monospace">
+    <tspan fill="#8b96a8" font-size="11.5" font-weight="700">RECEIVED&#160;&#160;&#160;</tspan><tspan fill="#e9eef5" font-size="13.5" font-weight="700">(?, 8, ?, 5, ?)</tspan><tspan fill="#8b96a8" font-size="11.5" font-weight="700">  &#8212; positions known</tspan>
+  </text>
+
+  <text x="380" y="186" text-anchor="middle" font-family="SF Mono, Fira Code, Consolas, monospace">
+    <tspan fill="#8b96a8" font-size="11.5" font-weight="700">KNOWN POINTS&#160;&#160;&#160;</tspan><tspan fill="#8fdcff" font-size="13.5" font-weight="700">(1, 8) and (3, 5)</tspan>
+  </text>
+
+  <text x="380" y="218" text-anchor="middle" font-family="SF Mono, Fira Code, Consolas, monospace">
+    <tspan fill="#8b96a8" font-size="11.5" font-weight="700">SLOPE&#160;&#160;&#160;</tspan><tspan fill="#e9eef5" font-size="13" font-weight="700">(5 &#8722; 8) &#247; (3 &#8722; 1) = &#8722;3 &#247; 2</tspan>
+  </text>
+
+  <text x="380" y="250" text-anchor="middle" font-family="SF Mono, Fira Code, Consolas, monospace">
+    <tspan fill="#8b96a8" font-size="11" font-weight="700">INVERSE&#160;&#160;&#160;</tspan><tspan fill="#e9eef5" font-size="12.5" font-weight="700">2<tspan dy="-5" font-size="65%">&#8722;1</tspan><tspan dy="5"> = 7 because 2&#215;7 = 14 = 1, so &#8722;3&#215;7 = &#8722;21 = 5</tspan></tspan>
+  </text>
+
+  <text x="380" y="282" text-anchor="middle" font-family="SF Mono, Fira Code, Consolas, monospace">
+    <tspan fill="#8b96a8" font-size="11.5" font-weight="700">INTERCEPT&#160;&#160;&#160;</tspan><tspan fill="#e9eef5" font-size="13" font-weight="700">8 = c + 5&#215;1, so c = 3</tspan>
+  </text>
+
+  <text x="380" y="314" text-anchor="middle" font-family="SF Mono, Fira Code, Consolas, monospace">
+    <tspan fill="#8b96a8" font-size="11.5" font-weight="700">RESULT&#160;&#160;&#160;</tspan><tspan fill="#5ddc8a" font-size="14" font-weight="700">f(x) = 3 + 5x &#8594; message (3, 5) &#10003;</tspan>
+  </text>
+
+  <text x="380" y="346" text-anchor="middle" font-family="SF Mono, Fira Code, Consolas, monospace">
+    <tspan fill="#8b96a8" font-size="11.5" font-weight="700">REBUILD&#160;&#160;&#160;</tspan><tspan fill="#5ddc8a" font-size="13.5" font-weight="700">f(0)=3, f(2)=13=0, f(4)=23=10 &#10003;</tspan>
+  </text>
+
+  <line x1="40" y1="376" x2="720" y2="376" stroke="#223049" stroke-width="1" />
+  <text x="380" y="400" text-anchor="middle" fill="#8fdcff" font-size="15" font-weight="800" font-family="-apple-system,Arial,sans-serif">ANY 2 SURVIVING NUMBERS REBUILD EVERYTHING</text>
+  <text x="380" y="422" text-anchor="middle" fill="#8b96a8" font-size="12.5" font-family="-apple-system,Arial,sans-serif">An erasure is a lost number at a known place; this code survives n &#8722; k = 3 of them.</text>
+</svg>
diff --git a/src/components/figures/ErrorCorrectionBasicsFigure.astro b/src/components/figures/ErrorCorrectionBasicsFigure.astro
new file mode 100644
index 0000000..a02c325
--- /dev/null
+++ b/src/components/figures/ErrorCorrectionBasicsFigure.astro
@@ -0,0 +1,56 @@
+---
+// Fig. for "Coding Theory": why redundancy is needed, the Hamming
+// distance between two words, and the detect/correct rules that follow
+// from keeping codewords far apart (circles of radius t must not overlap).
+---
+<svg viewBox="0 0 760 610" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;display:block;">
+  <text x="380" y="26" text-anchor="middle" fill="#e9eef5" font-size="16" font-weight="800" font-family="-apple-system,Arial,sans-serif">why send extra numbers?</text>
+
+  <rect x="40" y="46" width="680" height="42" rx="10" fill="#111c2e" stroke="#3ab7ff" stroke-width="1.5" />
+  <text x="380" y="72" text-anchor="middle" fill="#8fdcff" font-size="13" font-weight="700" font-family="-apple-system,Arial,sans-serif">How can a message survive when some numbers get changed or lost?</text>
+
+  <text x="380" y="122" text-anchor="middle" font-family="SF Mono, Fira Code, Consolas, monospace">
+    <tspan fill="#8b96a8" font-size="11.5" font-weight="700">PROBLEM&#160;&#160;&#160;</tspan><tspan fill="#ff5c7a" font-size="13" font-weight="700">send (3, 5), one number changes to (3, 9) &#8594; the receiver can't tell</tspan>
+  </text>
+
+  <text x="380" y="154" text-anchor="middle" font-family="SF Mono, Fira Code, Consolas, monospace">
+    <tspan fill="#8b96a8" font-size="11.5" font-weight="700">IDEA&#160;&#160;&#160;</tspan><tspan fill="#e9eef5" font-size="13" font-weight="700">add extra numbers computed from the message &#8212; this is redundancy</tspan>
+  </text>
+
+  <text x="380" y="186" text-anchor="middle" font-family="SF Mono, Fira Code, Consolas, monospace">
+    <tspan fill="#8b96a8" font-size="11" font-weight="700">HAMMING DISTANCE&#160;&#160;&#160;</tspan><tspan fill="#e9eef5" font-size="12.5" font-weight="700">the number of positions where two words differ</tspan>
+  </text>
+
+  <text x="380" y="218" text-anchor="middle" font-family="SF Mono, Fira Code, Consolas, monospace">
+    <tspan fill="#8b96a8" font-size="11.5" font-weight="700">EXAMPLE&#160;&#160;&#160;</tspan><tspan fill="#e9eef5" font-size="12.5" font-weight="700">(3,8,0,5,10) vs (1,7,0,6,12) differ in 4 places &#8594; distance 4</tspan>
+  </text>
+
+  <text x="380" y="250" text-anchor="middle" font-family="SF Mono, Fira Code, Consolas, monospace">
+    <tspan fill="#8b96a8" font-size="11.5" font-weight="700">CODE&#160;&#160;&#160;</tspan><tspan fill="#e9eef5" font-size="12.5" font-weight="700">a chosen set of allowed codewords; the smallest distance between two is d</tspan>
+  </text>
+
+  <!-- two codewords, d apart, each with a radius-t circle that must not overlap -->
+  <circle cx="220" cy="358" r="46" fill="none" stroke="#8fdcff" stroke-width="1.5" stroke-dasharray="4 4" />
+  <circle cx="540" cy="358" r="46" fill="none" stroke="#8fdcff" stroke-width="1.5" stroke-dasharray="4 4" />
+  <line x1="220" y1="358" x2="540" y2="358" stroke="#8b96a8" stroke-width="1" stroke-dasharray="2 4" />
+  <circle cx="220" cy="358" r="6" fill="#8fdcff" />
+  <circle cx="540" cy="358" r="6" fill="#8fdcff" />
+  <line x1="220" y1="358" x2="220" y2="314" stroke="#8b96a8" stroke-width="1.2" />
+  <line x1="540" y1="358" x2="540" y2="314" stroke="#8b96a8" stroke-width="1.2" />
+  <text x="226" y="332" fill="#8b96a8" font-size="13" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">t</text>
+  <text x="546" y="332" fill="#8b96a8" font-size="13" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">t</text>
+  <text x="380" y="346" text-anchor="middle" fill="#8fdcff" font-size="14" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">d</text>
+  <text x="380" y="430" text-anchor="middle" fill="#8b96a8" font-size="12" font-family="-apple-system,Arial,sans-serif">circles of radius t around each codeword must not overlap</text>
+
+  <text x="380" y="464" text-anchor="middle" font-family="SF Mono, Fira Code, Consolas, monospace">
+    <tspan fill="#8b96a8" font-size="11.5" font-weight="700">DETECT&#160;&#160;&#160;</tspan><tspan fill="#5ddc8a" font-size="13.5" font-weight="700">up to d &#8722; 1 errors</tspan>
+  </text>
+
+  <text x="380" y="496" text-anchor="middle" font-family="SF Mono, Fira Code, Consolas, monospace">
+    <tspan fill="#8b96a8" font-size="11.5" font-weight="700">CORRECT&#160;&#160;&#160;</tspan><tspan fill="#5ddc8a" font-size="13.5" font-weight="700">up to t errors when d &#8805; 2t + 1</tspan>
+  </text>
+
+  <line x1="40" y1="526" x2="720" y2="526" stroke="#223049" stroke-width="1" />
+  <text x="380" y="550" text-anchor="middle" fill="#8fdcff" font-size="15" font-weight="800" font-family="-apple-system,Arial,sans-serif">THE FARTHER APART THE CODEWORDS, THE MORE DAMAGE SURVIVES</text>
+  <text x="380" y="572" text-anchor="middle" fill="#8b96a8" font-size="12.5" font-family="-apple-system,Arial,sans-serif">Reed&#8211;Solomon codes make d as large as it can possibly be.</text>
+</svg>
diff --git a/src/components/figures/ReedSolomonLineFigure.astro b/src/components/figures/ReedSolomonLineFigure.astro
new file mode 100644
index 0000000..f4ae6ed
--- /dev/null
+++ b/src/components/figures/ReedSolomonLineFigure.astro
@@ -0,0 +1,36 @@
+---
+// Fig. for "Coding Theory": turning a message into a low-degree
+// polynomial and sending its evaluations — the Reed–Solomon codeword for
+// (3, 5) over F(13) at x = 0..4.
+---
+<svg viewBox="0 0 760 380" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;display:block;">
+  <text x="380" y="26" text-anchor="middle" fill="#e9eef5" font-size="16" font-weight="800" font-family="-apple-system,Arial,sans-serif">Reed&#8211;Solomon: a message as a line</text>
+
+  <rect x="40" y="46" width="680" height="42" rx="10" fill="#111c2e" stroke="#3ab7ff" stroke-width="1.5" />
+  <text x="380" y="72" text-anchor="middle" fill="#8fdcff" font-size="13" font-weight="700" font-family="-apple-system,Arial,sans-serif">How do we create extra numbers that are all tied to the message?</text>
+
+  <text x="380" y="122" text-anchor="middle" font-family="SF Mono, Fira Code, Consolas, monospace">
+    <tspan fill="#8b96a8" font-size="11.5" font-weight="700">MESSAGE&#160;&#160;&#160;</tspan><tspan fill="#e9eef5" font-size="13.5" font-weight="700">(3, 5) &#8594; the polynomial f(x) = 3 + 5x</tspan>
+  </text>
+
+  <text x="380" y="154" text-anchor="middle" font-family="SF Mono, Fira Code, Consolas, monospace">
+    <tspan fill="#8b96a8" font-size="11.5" font-weight="700">EVALUATE&#160;&#160;&#160;</tspan><tspan fill="#8fdcff" font-size="13" font-weight="700">in F(13) at x = 0, 1, 2, 3, 4</tspan>
+  </text>
+  <text x="380" y="180" text-anchor="middle" fill="#e9eef5" font-size="12.5" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">f(0)=3, f(1)=8, f(2)=13=0, f(3)=18=5, f(4)=23=10</text>
+
+  <text x="380" y="214" text-anchor="middle" font-family="SF Mono, Fira Code, Consolas, monospace">
+    <tspan fill="#8b96a8" font-size="11.5" font-weight="700">CODEWORD&#160;&#160;&#160;</tspan><tspan fill="#5ddc8a" font-size="14" font-weight="700">(3, 8, 0, 5, 10)</tspan>
+  </text>
+
+  <text x="380" y="246" text-anchor="middle" font-family="SF Mono, Fira Code, Consolas, monospace">
+    <tspan fill="#8b96a8" font-size="11.5" font-weight="700">SIZES&#160;&#160;&#160;</tspan><tspan fill="#e9eef5" font-size="13" font-weight="700">k = 2 message numbers, n = 5 sent numbers, rate k/n = 2/5</tspan>
+  </text>
+
+  <text x="380" y="278" text-anchor="middle" font-family="SF Mono, Fira Code, Consolas, monospace">
+    <tspan fill="#8b96a8" font-size="11" font-weight="700">WHY IT WORKS&#160;&#160;&#160;</tspan><tspan fill="#8fdcff" font-size="12.5" font-weight="700">any 2 points determine a line, so any 2 of the 5 numbers recover the message</tspan>
+  </text>
+
+  <line x1="40" y1="308" x2="720" y2="308" stroke="#223049" stroke-width="1" />
+  <text x="380" y="332" text-anchor="middle" fill="#8fdcff" font-size="15" font-weight="800" font-family="-apple-system,Arial,sans-serif">POINTS OF ONE LOW-DEGREE POLYNOMIAL ARE ALL TIED TOGETHER</text>
+  <text x="380" y="354" text-anchor="middle" fill="#8b96a8" font-size="12.5" font-family="-apple-system,Arial,sans-serif">Reed&#8211;Solomon means: send many evaluations of the message polynomial.</text>
+</svg>
diff --git a/src/components/figures/ReedSolomonZKFigure.astro b/src/components/figures/ReedSolomonZKFigure.astro
new file mode 100644
index 0000000..cada19b
--- /dev/null
+++ b/src/components/figures/ReedSolomonZKFigure.astro
@@ -0,0 +1,39 @@
+---
+// Fig. for "Coding Theory": fast Reed–Solomon encoding via the NTT, and
+// why proof systems and data-availability schemes both lean on
