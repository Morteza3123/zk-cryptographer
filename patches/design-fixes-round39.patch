@@ -0,0 +1,32 @@
+---
+// Fig. for "FFT and NTT": the slow way to multiply (1 + 2x)(3 + x) — multiply
+// every pair of terms, collect by power of x, then note the n×n cost.
+---
+<svg viewBox="0 0 760 520" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;display:block;">
+  <text x="380" y="26" text-anchor="middle" fill="#e9eef5" font-size="16" font-weight="800" font-family="-apple-system,Arial,sans-serif">the slow way</text>
+
+  <rect x="40" y="46" width="680" height="42" rx="10" fill="#111c2e" stroke="#3ab7ff" stroke-width="1.5" />
+  <text x="380" y="72" text-anchor="middle" fill="#8fdcff" font-size="13.5" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">How do we multiply (1 + 2x) by (3 + x)?</text>
+
+  <text x="380" y="112" text-anchor="middle" fill="#8b96a8" font-size="12" font-weight="700" font-family="-apple-system,Arial,sans-serif">STEP 1 &#8212; multiply every pair</text>
+  <text x="380" y="136" text-anchor="middle" fill="#e9eef5" font-size="14" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">1 &#215; 3 = 3</text>
+  <text x="380" y="158" text-anchor="middle" fill="#e9eef5" font-size="14" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">1 &#215; x = x</text>
+  <text x="380" y="180" text-anchor="middle" fill="#e9eef5" font-size="14" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">2x &#215; 3 = 6x</text>
+  <text x="380" y="202" text-anchor="middle" fill="#e9eef5" font-size="14" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">2x &#215; x = 2x<tspan dy="-6" font-size="65%">2</tspan><tspan dy="6"></tspan></text>
+
+  <text x="380" y="236" text-anchor="middle" fill="#8b96a8" font-size="12" font-weight="700" font-family="-apple-system,Arial,sans-serif">STEP 2 &#8212; collect by power of x</text>
+  <text x="380" y="260" text-anchor="middle" fill="#e9eef5" font-size="14" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">x<tspan dy="-6" font-size="65%">0</tspan><tspan dy="6">: 3</tspan></text>
+  <text x="380" y="282" text-anchor="middle" fill="#e9eef5" font-size="14" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">x<tspan dy="-6" font-size="65%">1</tspan><tspan dy="6">: 1 + 6 = 7</tspan></text>
+  <text x="380" y="304" text-anchor="middle" fill="#e9eef5" font-size="14" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">x<tspan dy="-6" font-size="65%">2</tspan><tspan dy="6">: 2</tspan></text>
+
+  <rect x="220" y="328" width="320" height="42" rx="10" fill="#0e1f16" stroke="#5ddc8a" stroke-width="1.8" />
+  <text x="380" y="354" text-anchor="middle" fill="#5ddc8a" font-size="14.5" font-weight="800" font-family="SF Mono, Fira Code, Consolas, monospace">(1 + 2x)(3 + x) = 3 + 7x + 2x<tspan dy="-6" font-size="65%">2</tspan><tspan dy="6"></tspan></text>
+
+  <text x="380" y="398" text-anchor="middle" fill="#e9eef5" font-size="13" font-family="SF Mono, Fira Code, Consolas, monospace">at x = 1: 3 &#215; 4 = 12 and 3 + 7 + 2 = 12 &#10003;</text>
+
+  <text x="380" y="426" text-anchor="middle" fill="#ff5c7a" font-size="12.5" font-family="-apple-system,Arial,sans-serif">2 numbers times 2 numbers = 4 multiplications. 1000 times 1000 would need 1,000,000</text>
+
+  <line x1="40" y1="450" x2="720" y2="450" stroke="#223049" stroke-width="1" />
+  <text x="380" y="474" text-anchor="middle" fill="#8fdcff" font-size="15.5" font-weight="800" font-family="-apple-system,Arial,sans-serif">DOUBLE THE SIZE, QUADRUPLE THE WORK</text>
+  <text x="380" y="496" text-anchor="middle" fill="#8b96a8" font-size="12.5" font-family="-apple-system,Arial,sans-serif">Real proofs multiply polynomials with millions of coefficients.</text>
+</svg>
diff --git a/src/components/figures/TransformMatrixFigure.astro b/src/components/figures/TransformMatrixFigure.astro
new file mode 100644
index 0000000..1bb89b6
--- /dev/null
+++ b/src/components/figures/TransformMatrixFigure.astro
@@ -0,0 +1,37 @@
+---
+// Fig. for "FFT and NTT": evaluating at all four roots of unity at once is a
+// matrix times a vector — row j, column k holds ω^(j×k) — tying evaluation
+// back to the matrix-times-vector idea from Topic 22.
+import Matrix4x4 from "./Matrix4x4.astro";
+const rows = [
+  ["1", "1", "1", "1"],
+  ["1", "5", "12", "8"],
+  ["1", "12", "1", "12"],
+  ["1", "8", "12", "5"],
+];
+---
+<svg viewBox="0 0 760 500" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;display:block;">
+  <text x="380" y="26" text-anchor="middle" fill="#e9eef5" font-size="16" font-weight="800" font-family="-apple-system,Arial,sans-serif">the transform as a matrix</text>
+
+  <rect x="40" y="46" width="680" height="42" rx="10" fill="#111c2e" stroke="#3ab7ff" stroke-width="1.5" />
+  <text x="380" y="72" text-anchor="middle" fill="#8fdcff" font-size="13.5" font-weight="700" font-family="-apple-system,Arial,sans-serif">Is there one formula for &#8220;evaluate at all four roots&#8221;?</text>
