--- /dev/null
+++ b/src/components/figures/InverseTransformFigure.astro
@@ -0,0 +1,36 @@
+---
+// Fig. for "FFT and NTT": the inverse transform is the same algorithm run
+// with ω⁻¹ instead of ω, followed by dividing every entry by n — the round
+// trip from values (12, 10, 11, 5) back to the coefficients 3 + 7x + 2x².
+---
+<svg viewBox="0 0 760 568" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;display:block;">
+  <text x="380" y="26" text-anchor="middle" fill="#e9eef5" font-size="16" font-weight="800" font-family="-apple-system,Arial,sans-serif">coming back to coefficients</text>
+
+  <rect x="40" y="46" width="680" height="42" rx="10" fill="#111c2e" stroke="#3ab7ff" stroke-width="1.5" />
+  <text x="380" y="72" text-anchor="middle" fill="#8fdcff" font-size="13" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">We have the values (12, 10, 11, 5). How do we get the coefficients back?</text>
+
+  <rect x="40" y="96" width="680" height="42" rx="10" fill="#111c2e" stroke="#3ab7ff" stroke-width="1.5" />
+  <text x="380" y="122" text-anchor="middle" fill="#8fdcff" font-size="13" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">run the same transform with &#969;<tspan dy="-6" font-size="65%">&#8722;1</tspan><tspan dy="6"> = 8, then divide by 4</tspan></text>
+
+  <text x="380" y="160" text-anchor="middle" fill="#8b96a8" font-size="12" font-weight="700" font-family="-apple-system,Arial,sans-serif">STEP 1 &#8212; the two inverses</text>
+  <text x="380" y="184" text-anchor="middle" fill="#e9eef5" font-size="13.5" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">5 &#215; 8 = 40 = 1, so &#969;<tspan dy="-6" font-size="65%">&#8722;1</tspan><tspan dy="6"> = 8</tspan></text>
+  <text x="380" y="206" text-anchor="middle" fill="#e9eef5" font-size="13.5" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">4 &#215; 10 = 40 = 1, so 1 &#247; 4 = 10</text>
+
+  <text x="380" y="240" text-anchor="middle" fill="#8b96a8" font-size="12" font-weight="700" font-family="-apple-system,Arial,sans-serif">STEP 2 &#8212; transform with 8 (powers of 8 are 1, 8, 12, 5)</text>
+  <text x="380" y="264" text-anchor="middle" fill="#e9eef5" font-size="13" font-family="SF Mono, Fira Code, Consolas, monospace">12 + 10 + 11 + 5 = 38 = 12</text>
+  <text x="380" y="286" text-anchor="middle" fill="#e9eef5" font-size="12.5" font-family="SF Mono, Fira Code, Consolas, monospace">12&#215;1 + 10&#215;8 + 11&#215;12 + 5&#215;5 = 249 = 2</text>
+  <text x="380" y="308" text-anchor="middle" fill="#e9eef5" font-size="12.5" font-family="SF Mono, Fira Code, Consolas, monospace">12 + 10&#215;12 + 11 + 5&#215;12 = 203 = 8</text>
+  <text x="380" y="330" text-anchor="middle" fill="#e9eef5" font-size="12.5" font-family="SF Mono, Fira Code, Consolas, monospace">12 + 10&#215;5 + 11&#215;12 + 5&#215;8 = 234 = 0</text>
+
+  <text x="380" y="364" text-anchor="middle" fill="#8b96a8" font-size="12" font-weight="700" font-family="-apple-system,Arial,sans-serif">STEP 3 &#8212; multiply by 10</text>
+  <text x="380" y="388" text-anchor="middle" fill="#e9eef5" font-size="13" font-family="SF Mono, Fira Code, Consolas, monospace">12 &#215; 10 = 120 = 3, 2 &#215; 10 = 20 = 7, 8 &#215; 10 = 80 = 2, 0 &#215; 10 = 0</text>
+
+  <rect x="260" y="410" width="240" height="42" rx="10" fill="#0e1f16" stroke="#5ddc8a" stroke-width="1.8" />
+  <text x="380" y="436" text-anchor="middle" fill="#5ddc8a" font-size="15" font-weight="800" font-family="SF Mono, Fira Code, Consolas, monospace">3 + 7x + 2x<tspan dy="-6" font-size="65%">2</tspan><tspan dy="6"></tspan></text>
+
+  <text x="380" y="476" text-anchor="middle" fill="#e9eef5" font-size="13" font-family="-apple-system,Arial,sans-serif">the same answer as the slow way &#10003;</text>
+
+  <line x1="40" y1="500" x2="720" y2="500" stroke="#223049" stroke-width="1" />
+  <text x="380" y="524" text-anchor="middle" fill="#8fdcff" font-size="15.5" font-weight="800" font-family="-apple-system,Arial,sans-serif">THE ROUND TRIP RETURNS THE ANSWER</text>
+  <text x="380" y="546" text-anchor="middle" fill="#8b96a8" font-size="12.5" font-family="-apple-system,Arial,sans-serif">Coefficients to values, multiply, values back to coefficients.</text>
+</svg>
diff --git a/src/components/figures/Matrix4x4.astro b/src/components/figures/Matrix4x4.astro
new file mode 100644
index 0000000..4226e12
--- /dev/null
+++ b/src/components/figures/Matrix4x4.astro
@@ -0,0 +1,55 @@
+---
+// Reusable inline 4x4 matrix: a bracket pair drawn with SVG paths around a
+// 4x4 grid of values, with an optional highlighted row (a rounded outline
+// around one row's cells, e.g. to call out the row used in a worked dot
+// product). Meant to be dropped inside another figure's <svg> as a
+// positioned <g>.
+interface Props {
+  x: number;
+  y: number;
+  rows: string[][]; // 4 rows of 4 values each
+  highlightRow?: number; // 0-indexed
+  color?: string;
+  highlightColor?: string;
+  scale?: number;
+}
+const { x, y, rows, highlightRow, color = "#e9eef5", highlightColor = "#8fdcff", scale = 1 } = Astro.props;
+const rowH = 20 * scale;
+const colW = 26 * scale;
+const padX = 10 * scale;
+const padY = 8 * scale;
+const h = rowH * 4 + padY * 2 - 4 * scale;
+const w = colW * 4 + padX * 2;
+const tick = 7 * scale;
+const fontSize = 13 * scale;
+---
+<g transform={`translate(${x}, ${y})`}>
+  <path d={`M ${tick} 0 L 0 0 L 0 ${h} L ${tick} ${h}`} fill="none" stroke={color} stroke-width="1.5" />
+  <path d={`M ${w - tick} 0 L ${w} 0 L ${w} ${h} L ${w - tick} ${h}`} fill="none" stroke={color} stroke-width="1.5" />
+  {highlightRow !== undefined && (
+    <rect
+      x={tick - 2}
+      y={padY + rowH * highlightRow - 2}
+      width={w - 2 * tick + 4}
+      height={rowH + 4}
+      rx="6"
+      fill="none"
+      stroke={highlightColor}
+      stroke-width="1.5"
+    />
+  )}
+  {rows.map((row, r) =>
+    row.map((val, c) => (
+      <text
+        x={padX + colW * c + colW / 2}
+        y={padY + rowH * r + rowH / 2 + 4}
+        text-anchor="middle"
+        fill={color}
+        font-size={fontSize}
+        font-family="SF Mono, Fira Code, Consolas, monospace"
+      >
+        {val}
+      </text>
+    ))
+  )}
+</g>
diff --git a/src/components/figures/SlowPolyMultFigure.astro b/src/components/figures/SlowPolyMultFigure.astro
new file mode 100644
index 0000000..5e229fa
