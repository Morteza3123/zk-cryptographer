@@ -0,0 +1,41 @@
+---
+// Fig. for "Bilinear Pairings": a made-up numeric example to build
+// intuition for bilinearity — scaling either input by a scalar scales
+// the output by that scalar in the exponent, and scaling both multiplies
+// the two scalars together in the exponent.
+interface Row {
+  label: string;
+  eq: string;
+}
+const rows: Row[] = [
+  { label: "e(2·P, Q)", eq: "= 5² = 25" },
+  { label: "e(P, 3·Q)", eq: "= 5³ = 125" },
+  { label: "e(2·P, 3·Q)", eq: "= 5⁶ = 15,625" },
+];
+const rowH = 54;
+const topPad = 66;
+const tableH = rows.length * rowH;
+const footerH = 48;
+const height = topPad + tableH + footerH + 10;
+---
+<svg viewBox={`0 0 680 ${height}`} xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;display:block;">
+  <text x="340" y="26" text-anchor="middle" fill="#8fdcff" font-size="14" font-weight="700" font-family="-apple-system,Arial,sans-serif">a numeric feel for it</text>
+  <text x="340" y="46" text-anchor="middle" fill="#8b96a8" font-size="13" font-family="SF Mono, Fira Code, Consolas, monospace">say e(P, Q) comes out to the number 5</text>
+  <line x1="20" y1="60" x2="660" y2="60" stroke="#223049" stroke-width="1" />
+
+  {rows.map((row, i) => {
+    const y = topPad + i * rowH;
+    return (
+      <>
+        <text x="40" y={y + 18} text-anchor="start" fill="#e9eef5" font-size="16" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">{row.label}</text>
+        <text x="640" y={y + 18} text-anchor="end" fill="#5ddc8a" font-size="16" font-weight="800" font-family="SF Mono, Fira Code, Consolas, monospace">{row.eq}</text>
+        {i < rows.length - 1 && (
+          <line x1="20" y1={y + 34} x2="660" y2={y + 34} stroke="#1a2436" stroke-width="1" />
+        )}
+      </>
+    );
+  })}
+
+  <rect x="20" y={topPad + tableH + 10} width="640" height={footerH - 14} rx="8" fill="#121c2c" stroke="#223049" stroke-width="1.5" />
+  <text x="340" y={topPad + tableH + 10 + (footerH - 14) / 2 + 5} text-anchor="middle" fill="#8fdcff" font-size="13.5" font-weight="700" font-family="-apple-system,Arial,sans-serif">the scalars 2 and 3 multiply together in the exponent</text>
+</svg>
