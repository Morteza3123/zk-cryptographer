+  <circle cx={quadXs[1] + 46} cy="122" r="9" fill="#c3cedd" />
+  <text x={quadXs[1] + 46} y="126" text-anchor="middle" fill="#121c2c" font-size="10" font-weight="800" font-family="-apple-system,Arial,sans-serif">P</text>
