diff --git a/src/components/figures/GeneratingGroupFigure.astro b/src/components/figures/GeneratingGroupFigure.astro
new file mode 100644
index 0000000..1423701
--- /dev/null
+++ b/src/components/figures/GeneratingGroupFigure.astro
@@ -0,0 +1,40 @@
+---
+// Fig. for "Groups & Cyclic Groups": watching 1 generate all of C7 by
+// repeated addition — two columns of running totals that both land on
+// every element of the group before wrapping back to the start.
+interface Row {
+  left: string;
+  right: string;
+}
+const rows: Row[] = [
+  { left: "1 + 1 = 2", right: "1 + 1 + 1 = 3" },
+  { left: "… continues …", right: "1 × 6 = 6" },
+  { left: "1 × 7 = 7 mod 7 = 0", right: "back to start" },
+];
+const rowH = 50;
+const topPad = 66;
+const tableH = rows.length * rowH;
+const footerH = 48;
+const height = topPad + tableH + footerH + 10;
+---
+<svg viewBox={`0 0 680 ${height}`} xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;display:block;">
+  <text x="340" y="26" text-anchor="middle" fill="#8fdcff" font-size="14" font-weight="700" font-family="-apple-system,Arial,sans-serif">generating C&#8327; from one element</text>
+  <text x="340" y="46" text-anchor="middle" fill="#8b96a8" font-size="13" font-family="-apple-system,Arial,sans-serif">start at 1, keep adding 1, mod 7</text>
+  <line x1="20" y1="60" x2="660" y2="60" stroke="#223049" stroke-width="1" />
+
+  {rows.map((row, i) => {
+    const y = topPad + i * rowH;
+    return (
+      <>
+        <text x="40" y={y + 18} text-anchor="start" fill="#e9eef5" font-size="15.5" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">{row.left}</text>
+        <text x="640" y={y + 18} text-anchor="end" fill="#e9eef5" font-size="15.5" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">{row.right}</text>
+        {i < rows.length - 1 && (
+          <line x1="20" y1={y + 34} x2="660" y2={y + 34} stroke="#1a2436" stroke-width="1" />
+        )}
+      </>
+    );
+  })}
+
+  <rect x="20" y={topPad + tableH + 10} width="640" height={footerH - 14} rx="8" fill="#121c2c" stroke="#223049" stroke-width="1.5" />
+  <text x="340" y={topPad + tableH + 10 + (footerH - 14) / 2 + 5} text-anchor="middle" fill="#5ddc8a" font-size="13.5" font-weight="700" font-family="-apple-system,Arial,sans-serif">1 visits every element before returning to start — a generator</text>
+</svg>
