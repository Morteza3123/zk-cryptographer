diff --git a/src/components/figures/EntropyBitsFigure.astro b/src/components/figures/EntropyBitsFigure.astro
new file mode 100644
index 0000000..6357e54
--- /dev/null
+++ b/src/components/figures/EntropyBitsFigure.astro
@@ -0,0 +1,52 @@
+---
+// Fig. for "Information Theory & Entropy": entropy counts the number of
+// yes/no questions needed to pin down an unknown. Five rows chosen to match
+// the script's read-aloud (1, 2, 8, 1024, 2^256), plus a small halving chain
+// showing why 8 outcomes costs exactly 3 questions.
+const rows = [
+  { label: "1", sup: "", subX: 0, sub: "", bits: "0 bits" },
+  { label: "2", sup: "", subX: 66, sub: "(a coin flip)", bits: "1 bit" },
+  { label: "8", sup: "", subX: 0, sub: "", bits: "3 bits" },
+  { label: "1,024", sup: "", subX: 0, sub: "", bits: "10 bits" },
+  { label: "2", sup: "256", subX: 108, sub: "(a 256-bit key)", bits: "256 bits" },
+];
+---
+<svg viewBox="0 0 760 540" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;display:block;">
+  <text x="380" y="26" text-anchor="middle" fill="#e9eef5" font-size="16" font-weight="800" font-family="-apple-system,Arial,sans-serif">entropy is counting yes/no questions</text>
+
+  <text x="40" y="58" fill="#c3cedd" font-size="12" font-weight="700" font-family="-apple-system,Arial,sans-serif">EQUALLY LIKELY OUTCOMES</text>
+  <text x="580" y="58" fill="#8fdcff" font-size="12" font-weight="700" font-family="-apple-system,Arial,sans-serif">BITS OF ENTROPY</text>
+
+  {rows.map((r, i) => (
+    <>
+      <text x="40" y={96 + i * 54} fill="#e9eef5" font-size="19" font-weight="800" font-family="SF Mono, Fira Code, Consolas, monospace">{r.label}{r.sup && <tspan font-size="12" dy="-9">{r.sup}</tspan>}</text>
+      {r.sub && <text x={40 + r.subX} y={96 + i * 54} fill="#8b96a8" font-size="13" font-style="italic" font-family="-apple-system,Arial,sans-serif">{r.sub}</text>}
+      <line x1="300" y1={90 + i * 54} x2="560" y2={90 + i * 54} stroke="#223049" stroke-width="1" stroke-dasharray="3 4" />
+      <rect x="570" y={72 + i * 54} width="150" height="34" rx="8" fill="#0d1526" stroke="#3ab7ff" stroke-width="1.6" />
+      <text x="645" y={95 + i * 54} text-anchor="middle" fill="#8fdcff" font-size="14" font-weight="800" font-family="SF Mono, Fira Code, Consolas, monospace">{r.bits}</text>
+    </>
+  ))}
+
+  <line x1="40" y1="382" x2="720" y2="382" stroke="#223049" stroke-width="1" />
+  <text x="40" y="406" fill="#c3cedd" font-size="12" font-weight="700" font-family="-apple-system,Arial,sans-serif">WHY EIGHT OUTCOMES COSTS THREE QUESTIONS</text>
+
+  {["8", "4", "2", "1"].map((n, i) => (
+    <>
+      <rect x={60 + i * 170} y="420" width="60" height="44" rx="8" fill="#121c2c" stroke="#c3cedd" stroke-width="1.4" />
+      <text x={90 + i * 170} y="448" text-anchor="middle" fill="#e9eef5" font-size="16" font-weight="800" font-family="SF Mono, Fira Code, Consolas, monospace">{n}</text>
+      {i < 3 && <line x1={120 + i * 170} y1="442" x2={158 + i * 170} y2="442" stroke="#8fdcff" stroke-width="1.6" marker-end="url(#eb-arrow)" />}
+      {i < 3 && <text x={139 + i * 170} y="432" text-anchor="middle" fill="#8b96a8" font-size="10.5" font-family="-apple-system,Arial,sans-serif">&#247;2</text>}
+    </>
+  ))}
+  <text x="648" y="448" text-anchor="start" fill="#8fdcff" font-size="13" font-weight="700" font-family="-apple-system,Arial,sans-serif">= 3 questions</text>
+
+  <line x1="40" y1="488" x2="720" y2="488" stroke="#223049" stroke-width="1" />
+  <text x="380" y="512" text-anchor="middle" fill="#8fdcff" font-size="15.5" font-weight="800" font-family="-apple-system,Arial,sans-serif">ENTROPY = THE NUMBER OF YES/NO QUESTIONS</text>
+  <text x="380" y="530" text-anchor="middle" fill="#8b96a8" font-size="12.5" font-family="-apple-system,Arial,sans-serif">Each extra bit doubles the outcomes — that's why 256 bits is beyond brute force.</text>
+
+  <defs>
+    <marker id="eb-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
+      <path d="M0,0 L10,5 L0,10 z" fill="#8fdcff" />
+    </marker>
+  </defs>
+</svg>
diff --git a/src/components/figures/EntropyFairnessFigure.astro b/src/components/figures/EntropyFairnessFigure.astro
new file mode 100644
index 0000000..65e3f6c
--- /dev/null
+++ b/src/components/figures/EntropyFairnessFigure.astro
@@ -0,0 +1,31 @@
+---
+// Fig. for "Information Theory & Entropy": the same four outcomes carry
+// different entropy depending on how likely each one is — certain (0 bits),
+// uneven (1.75 bits), and equal (the maximum, 2 bits).
+const groups = [
+  { label: "CERTAIN", bits: "0 bits", bars: [100, 0, 0, 0] },
+  { label: "UNEVEN", bits: "1.75 bits", bars: [50, 25, 12.5, 12.5] },
+  { label: "EQUAL", bits: "2 bits (maximum)", bars: [25, 25, 25, 25] },
+];
+---
+<svg viewBox="0 0 760 540" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;display:block;">
+  <text x="380" y="26" text-anchor="middle" fill="#e9eef5" font-size="16" font-weight="800" font-family="-apple-system,Arial,sans-serif">same four outcomes, different entropy</text>
+
+  {groups.map((g, gi) => (
+    <>
+      <text x="40" y={66 + gi * 140} fill="#c3cedd" font-size="13" font-weight="700" letter-spacing="0.04em" font-family="-apple-system,Arial,sans-serif">{g.label}</text>
+      {g.bars.map((p, bi) => (
+        <>
+          <rect x="40" y={78 + gi * 140 + bi * 26} width={Math.max(p * 3, 3)} height="18" rx="4" fill="#3ab7ff" opacity={p === 0 ? 0.25 : 0.85} />
+          <text x={48 + p * 3} y={92 + gi * 140 + bi * 26} fill="#e9eef5" font-size="12" font-family="-apple-system,Arial,sans-serif">{p}%</text>
+        </>
+      ))}
+      <rect x="590" y={78 + gi * 140 + 26} width="130" height="36" rx="8" fill="#0d1526" stroke="#8fdcff" stroke-width="1.6" />
+      <text x="655" y={101 + gi * 140 + 26} text-anchor="middle" fill="#8fdcff" font-size="13" font-weight="800" font-family="SF Mono, Fira Code, Consolas, monospace">{g.bits}</text>
+    </>
+  ))}
+
+  <line x1="40" y1="470" x2="720" y2="470" stroke="#223049" stroke-width="1" />
+  <text x="380" y="494" text-anchor="middle" fill="#8fdcff" font-size="15.5" font-weight="800" font-family="-apple-system,Arial,sans-serif">ENTROPY IS HIGHEST WHEN OUTCOMES ARE EQUALLY LIKELY</text>
+  <text x="380" y="514" text-anchor="middle" fill="#8b96a8" font-size="12.5" font-family="-apple-system,Arial,sans-serif">A predictable secret is a weak secret even with many possible values.</text>
+</svg>
diff --git a/src/components/figures/NullifierEntropyFigure.astro b/src/components/figures/NullifierEntropyFigure.astro
new file mode 100644
index 0000000..9ef949f
--- /dev/null
+++ b/src/components/figures/NullifierEntropyFigure.astro
@@ -0,0 +1,57 @@
+---
+// Fig. for "Information Theory & Entropy": whether a published hash N = H(nf)
+// is safe depends entirely on the entropy of nf. A guessable PIN is broken
+// (reserved red, a real violation); a 256-bit random secret is safe (green).
+---
+<svg viewBox="0 0 760 460" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;display:block;">
+  <text x="380" y="24" text-anchor="middle" fill="#e9eef5" font-size="15" font-weight="800" font-family="-apple-system,Arial,sans-serif">published: N = H(nf) — anyone can see N</text>
+
+  <!-- left: low entropy, broken -->
+  <text x="190" y="56" text-anchor="middle" fill="#ff5c7a" font-size="13.5" font-weight="700" font-family="-apple-system,Arial,sans-serif">LOW ENTROPY</text>
+  <rect x="60" y="68" width="260" height="42" rx="9" fill="#121c2c" stroke="#c3cedd" stroke-width="1.4" />
+  <text x="190" y="94" text-anchor="middle" fill="#e9eef5" font-size="13" font-weight="700" font-family="-apple-system,Arial,sans-serif">10,000 possible values</text>
+  <line x1="190" y1="110" x2="190" y2="134" stroke="#c3cedd" stroke-width="1.6" marker-end="url(#ne-arrow-w)" />
+  <rect x="60" y="136" width="260" height="42" rx="9" fill="#0d1526" stroke="#c3cedd" stroke-width="1.4" />
+  <text x="190" y="162" text-anchor="middle" fill="#e9eef5" font-size="13" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">nf = a 4-digit PIN</text>
+  <line x1="190" y1="178" x2="190" y2="202" stroke="#ff5c7a" stroke-width="1.6" marker-end="url(#ne-arrow-r)" />
+  <rect x="60" y="204" width="260" height="50" rx="9" fill="#1f0d14" stroke="#ff5c7a" stroke-width="1.4" opacity="0.9" />
+  <text x="190" y="226" text-anchor="middle" fill="#ff5c7a" font-size="11.5" font-family="SF Mono, Fira Code, Consolas, monospace">attacker tries every guess:</text>
+  <text x="190" y="244" text-anchor="middle" fill="#ff5c7a" font-size="11.5" font-family="SF Mono, Fira Code, Consolas, monospace">H(0000), H(0001), &#8230; H(9999)</text>
+  <line x1="190" y1="254" x2="190" y2="278" stroke="#ff5c7a" stroke-width="1.8" marker-end="url(#ne-arrow-r)" />
+  <rect x="60" y="280" width="260" height="46" rx="9" fill="#1f0d14" stroke="#ff5c7a" stroke-width="2" />
+  <text x="190" y="308" text-anchor="middle" fill="#ff5c7a" font-size="13" font-weight="800" font-family="-apple-system,Arial,sans-serif">one matches N: nf found</text>
+
+  <!-- right: high entropy, safe -->
+  <text x="570" y="56" text-anchor="middle" fill="#5ddc8a" font-size="13.5" font-weight="700" font-family="-apple-system,Arial,sans-serif">HIGH ENTROPY</text>
+  <rect x="440" y="68" width="260" height="42" rx="9" fill="#121c2c" stroke="#c3cedd" stroke-width="1.4" />
+  <text x="570" y="94" text-anchor="middle" fill="#e9eef5" font-size="13" font-weight="700" font-family="-apple-system,Arial,sans-serif">2&#178;&#8309;&#8310; possible values</text>
+  <line x1="570" y1="110" x2="570" y2="134" stroke="#c3cedd" stroke-width="1.6" marker-end="url(#ne-arrow-w)" />
+  <rect x="440" y="136" width="260" height="42" rx="9" fill="#0d1526" stroke="#5ddc8a" stroke-width="1.6" />
+  <text x="570" y="162" text-anchor="middle" fill="#5ddc8a" font-size="12.5" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">nf = a random 256-bit value</text>
+  <line x1="570" y1="178" x2="570" y2="202" stroke="#5ddc8a" stroke-width="1.6" marker-end="url(#ne-arrow-g)" />
+  <rect x="440" y="204" width="260" height="50" rx="9" fill="#0d1a12" stroke="#5ddc8a" stroke-width="1.4" opacity="0.9" />
+  <text x="570" y="233" text-anchor="middle" fill="#5ddc8a" font-size="13" font-family="-apple-system,Arial,sans-serif">attacker needs 2&#178;&#8309;&#8310; hashes</text>
+  <line x1="570" y1="254" x2="570" y2="278" stroke="#5ddc8a" stroke-width="1.8" marker-end="url(#ne-arrow-g)" />
+  <rect x="440" y="280" width="260" height="46" rx="9" fill="#0d1a12" stroke="#5ddc8a" stroke-width="2" />
+  <text x="570" y="302" text-anchor="middle" fill="#5ddc8a" font-size="13" font-weight="800" font-family="-apple-system,Arial,sans-serif">never finishes</text>
+  <text x="570" y="318" text-anchor="middle" fill="#8b96a8" font-size="10.5" font-style="italic" font-family="-apple-system,Arial,sans-serif">(longer than the age of the universe)</text>
+
+  <line x1="380" y1="40" x2="380" y2="338" stroke="#223049" stroke-width="1" stroke-dasharray="3 5" />
+
+  <line x1="40" y1="356" x2="720" y2="356" stroke="#223049" stroke-width="1" />
+  <text x="380" y="380" text-anchor="middle" fill="#e9eef5" font-size="15.5" font-weight="800" font-family="-apple-system,Arial,sans-serif">ONE-WAY ONLY HELPS IF THE INPUT IS UNGUESSABLE</text>
+  <text x="380" y="400" text-anchor="middle" fill="#8b96a8" font-size="12.5" font-family="-apple-system,Arial,sans-serif">A hash hides a secret only as well as the secret's entropy allows.</text>
+  <text x="380" y="418" text-anchor="middle" fill="#8b96a8" font-size="12.5" font-family="-apple-system,Arial,sans-serif">That's why nullifier secrets and blinding factors must be random.</text>
+
+  <defs>
+    <marker id="ne-arrow-w" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6.5" markerHeight="6.5" orient="auto-start-reverse">
+      <path d="M0,0 L10,5 L0,10 z" fill="#c3cedd" />
+    </marker>
+    <marker id="ne-arrow-r" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6.5" markerHeight="6.5" orient="auto-start-reverse">
+      <path d="M0,0 L10,5 L0,10 z" fill="#ff5c7a" />
+    </marker>
+    <marker id="ne-arrow-g" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6.5" markerHeight="6.5" orient="auto-start-reverse">
+      <path d="M0,0 L10,5 L0,10 z" fill="#5ddc8a" />
+    </marker>
+  </defs>
+</svg>
diff --git a/src/components/figures/PerfectHidingFigure.astro b/src/components/figures/PerfectHidingFigure.astro
new file mode 100644
index 0000000..c2ae9b5
--- /dev/null
+++ b/src/components/figures/PerfectHidingFigure.astro
@@ -0,0 +1,41 @@
+---
+// Fig. for "Information Theory & Entropy": why the Pedersen commitment from
+// the commitments lesson achieves perfect hiding. Every possible message has
+// exactly one matching random r, so C alone can't favor any message over
+// another. Messages (secrets) stay green; C, the public commitment, stays blue.
+const messages = [
+  { label: "m = 42, with some r", x: 100 },
+  { label: "m = 7, with some r", x: 380 },
+  { label: "m = 999, with some r", x: 660 },
+];
+---
+<svg viewBox="0 0 760 460" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;display:block;">
+  <text x="380" y="26" text-anchor="middle" fill="#e9eef5" font-size="16" font-weight="800" font-family="-apple-system,Arial,sans-serif">perfect hiding</text>
+
+  <rect x="255" y="44" width="250" height="56" rx="12" fill="#0d1526" stroke="#e9eef5" stroke-width="2" />
+  <text x="380" y="80" text-anchor="middle" fill="#8fdcff" font-size="22" font-weight="800" font-family="SF Mono, Fira Code, Consolas, monospace">C = g&#183;m + h&#183;r</text>
+  <text x="380" y="118" text-anchor="middle" fill="#8b96a8" font-size="12" font-style="italic" font-family="-apple-system,Arial,sans-serif">r is random over the whole field</text>
+
+  {messages.map((m) => (
+    <>
+      <rect x={m.x - 100} y="160" width="200" height="46" rx="9" fill="#0d1a12" stroke="#5ddc8a" stroke-width="1.6" stroke-dasharray="5 4" />
+      <text x={m.x} y="188" text-anchor="middle" fill="#5ddc8a" font-size="13" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">{m.label}</text>
+      <path d={`M ${m.x} 206 C ${m.x} 250 380 250 380 268`} fill="none" stroke="#5ddc8a" stroke-width="1.6" marker-end="url(#ph-arrow-g)" />
+    </>
+  ))}
+
+  <rect x="310" y="270" width="140" height="56" rx="12" fill="#121c2c" stroke="#3ab7ff" stroke-width="2.2" />
+  <text x="380" y="305" text-anchor="middle" fill="#8fdcff" font-size="24" font-weight="800" font-family="SF Mono, Fira Code, Consolas, monospace">C</text>
+  <text x="380" y="346" text-anchor="middle" fill="#8b96a8" font-size="12" font-style="italic" font-family="-apple-system,Arial,sans-serif">all the attacker sees</text>
+
+  <line x1="40" y1="368" x2="720" y2="368" stroke="#223049" stroke-width="1" />
+  <text x="380" y="392" text-anchor="middle" fill="#8b96a8" font-size="12.5" font-family="-apple-system,Arial,sans-serif">Every message has exactly one matching r, and all are equally likely.</text>
+  <text x="380" y="420" text-anchor="middle" fill="#8fdcff" font-size="15.5" font-weight="800" font-family="-apple-system,Arial,sans-serif">RANDOMNESS MAKES EVERY MESSAGE EQUALLY LIKELY</text>
+  <text x="380" y="440" text-anchor="middle" fill="#8b96a8" font-size="12.5" font-family="-apple-system,Arial,sans-serif">Even an attacker with unlimited computing power learns nothing about m from C.</text>
+
+  <defs>
+    <marker id="ph-arrow-g" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6.5" markerHeight="6.5" orient="auto-start-reverse">
+      <path d="M0,0 L10,5 L0,10 z" fill="#5ddc8a" />
+    </marker>
+  </defs>
+</svg>
diff --git a/src/components/figures/SecurityTypesFigure.astro b/src/components/figures/SecurityTypesFigure.astro
new file mode 100644
index 0000000..e870877
--- /dev/null
+++ b/src/components/figures/SecurityTypesFigure.astro
@@ -0,0 +1,35 @@
+---
+// Fig. for "Information Theory & Entropy": the two kinds of security a
+// scheme can offer. Neither column is a secret/public distinction, so this
+// uses the site's neutral white/blue pairing (as in VectorCommitmentFigure's
+// two-method comparison) rather than the green/red secret-violation pair.
+---
+<svg viewBox="0 0 760 480" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;display:block;">
+  <text x="380" y="26" text-anchor="middle" fill="#e9eef5" font-size="16" font-weight="800" font-family="-apple-system,Arial,sans-serif">what hiding and binding rest on</text>
+
+  <rect x="40" y="56" width="330" height="266" rx="12" fill="#121c2c" stroke="#e9eef5" stroke-width="1.6" />
+  <text x="205" y="88" text-anchor="middle" fill="#e9eef5" font-size="14.5" font-weight="800" font-family="-apple-system,Arial,sans-serif">BASED ON ENTROPY</text>
+  <line x1="66" y1="102" x2="344" y2="102" stroke="#223049" stroke-width="1" />
+  <text x="205" y="140" text-anchor="middle" fill="#c3cedd" font-size="13" font-family="-apple-system,Arial,sans-serif">Pedersen hiding</text>
+  <text x="205" y="176" text-anchor="middle" fill="#c3cedd" font-size="13" font-family="-apple-system,Arial,sans-serif">holds even against unlimited</text>
+  <text x="205" y="196" text-anchor="middle" fill="#c3cedd" font-size="13" font-family="-apple-system,Arial,sans-serif">computing power</text>
+  <text x="205" y="232" text-anchor="middle" fill="#c3cedd" font-size="13" font-family="-apple-system,Arial,sans-serif">but only if r is truly random</text>
+  <text x="205" y="268" text-anchor="middle" fill="#8fdcff" font-size="13" font-weight="700" font-family="-apple-system,Arial,sans-serif">called information-theoretic</text>
+
+  <rect x="390" y="56" width="330" height="266" rx="12" fill="#121c2c" stroke="#3ab7ff" stroke-width="1.8" />
+  <text x="555" y="88" text-anchor="middle" fill="#8fdcff" font-size="14.5" font-weight="800" font-family="-apple-system,Arial,sans-serif">BASED ON HARD PROBLEMS</text>
+  <line x1="416" y1="102" x2="694" y2="102" stroke="#223049" stroke-width="1" />
+  <text x="555" y="140" text-anchor="middle" fill="#c3cedd" font-size="13" font-family="-apple-system,Arial,sans-serif">Pedersen binding relies on the</text>
+  <text x="555" y="160" text-anchor="middle" fill="#c3cedd" font-size="13" font-family="-apple-system,Arial,sans-serif">discrete log problem (Topic 11)</text>
+  <text x="555" y="196" text-anchor="middle" fill="#c3cedd" font-size="13" font-family="-apple-system,Arial,sans-serif">hash collision resistance (Topic 14)</text>
+  <text x="555" y="232" text-anchor="middle" fill="#c3cedd" font-size="13" font-family="-apple-system,Arial,sans-serif">holds only while the problem stays hard</text>
+  <text x="555" y="268" text-anchor="middle" fill="#8fdcff" font-size="13" font-weight="700" font-family="-apple-system,Arial,sans-serif">called computational</text>
+
+  <rect x="80" y="340" width="600" height="40" rx="9" fill="#0d1526" stroke="#223049" stroke-width="1.4" />
+  <text x="380" y="365" text-anchor="middle" fill="#e9eef5" font-size="13" font-weight="700" font-family="-apple-system,Arial,sans-serif">No commitment can be perfectly hiding and perfectly binding at once.</text>
+
+  <line x1="40" y1="400" x2="720" y2="400" stroke="#223049" stroke-width="1" />
+  <text x="380" y="424" text-anchor="middle" fill="#8fdcff" font-size="15.5" font-weight="800" font-family="-apple-system,Arial,sans-serif">TWO KINDS OF SECURITY, ONE TRADE-OFF</text>
+  <text x="380" y="444" text-anchor="middle" fill="#8b96a8" font-size="12.5" font-family="-apple-system,Arial,sans-serif">Pedersen picks perfect hiding and computational binding.</text>
+  <text x="380" y="462" text-anchor="middle" fill="#8b96a8" font-size="12.5" font-family="-apple-system,Arial,sans-serif">Other schemes choose the other way around.</text>
+</svg>
diff --git a/src/components/figures/SimulationArgumentFigure.astro b/src/components/figures/SimulationArgumentFigure.astro
new file mode 100644
index 0000000..b2f87be
--- /dev/null
+++ b/src/components/figures/SimulationArgumentFigure.astro
@@ -0,0 +1,62 @@
+---
+// Fig. for "Information Theory & Entropy": the simulation argument behind
+// zero-knowledge. Real proof shown first (left, uses the actual secret x —
+// green), simulated proof second (right, built backwards with no secret —
