+---
+// Fig. for "Hash Functions & Random Oracles": the payoff — the Fiat-Shamir
+// transform. On the left, an interactive proof needs prover and verifier
+// online together. On the right, the prover derives the verifier's
+// challenge itself by hashing the transcript, so the whole proof can be
+// sent as one package and checked later, offline.
+---
+<svg viewBox="0 0 920 540" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;display:block;">
+  <text x="460" y="30" text-anchor="middle" fill="#e9eef5" font-size="17" font-weight="800" font-family="-apple-system,Arial,sans-serif">the hash removes the verifier from the room</text>
+
+  <line x1="460" y1="52" x2="460" y2="420" stroke="#1a2436" stroke-width="1" stroke-dasharray="4 5" />
+
+  <!-- LEFT: interactive -->
+  <text x="225" y="66" text-anchor="middle" fill="#c3cedd" font-size="13.5" font-weight="700" font-family="-apple-system,Arial,sans-serif">INTERACTIVE</text>
+
+  <rect x="40" y="86" width="150" height="52" rx="9" fill="#121c2c" stroke="#5ddc8a" stroke-width="1.6" />
+  <text x="115" y="118" text-anchor="middle" fill="#5ddc8a" font-size="15" font-weight="700" font-family="-apple-system,Arial,sans-serif">Prover</text>
+
+  <rect x="300" y="86" width="150" height="52" rx="9" fill="#121c2c" stroke="#ff8080" stroke-width="1.6" />
+  <text x="375" y="118" text-anchor="middle" fill="#ff8080" font-size="15" font-weight="700" font-family="-apple-system,Arial,sans-serif">Verifier</text>
+
+  <line x1="115" y1="138" x2="115" y2="370" stroke="#223049" stroke-width="1" stroke-dasharray="3 4" />
+  <line x1="375" y1="138" x2="375" y2="370" stroke="#223049" stroke-width="1" stroke-dasharray="3 4" />
+
+  <text x="245" y="178" text-anchor="middle" fill="#e9eef5" font-size="13" font-family="-apple-system,Arial,sans-serif">1. commitment a</text>
+  <line x1="115" y1="192" x2="375" y2="192" stroke="#e9eef5" stroke-width="1.8" marker-end="url(#fs-arrow-w)" />
+
+  <text x="245" y="240" text-anchor="middle" fill="#8fdcff" font-size="13" font-family="-apple-system,Arial,sans-serif">2. random challenge c</text>
+  <line x1="375" y1="254" x2="115" y2="254" stroke="#8fdcff" stroke-width="1.8" marker-end="url(#fs-arrow-blue)" />
+
+  <text x="245" y="302" text-anchor="middle" fill="#e9eef5" font-size="13" font-family="-apple-system,Arial,sans-serif">3. response z</text>
+  <line x1="115" y1="316" x2="375" y2="316" stroke="#e9eef5" stroke-width="1.8" marker-end="url(#fs-arrow-w)" />
+
+  <text x="245" y="356" text-anchor="middle" fill="#8b96a8" font-size="12.5" font-family="-apple-system,Arial,sans-serif">both online at once</text>
+
+  <!-- RIGHT: non-interactive -->
+  <text x="690" y="66" text-anchor="middle" fill="#c3cedd" font-size="13.5" font-weight="700" font-family="-apple-system,Arial,sans-serif">NON-INTERACTIVE</text>
+
+  <rect x="565" y="86" width="150" height="52" rx="9" fill="#121c2c" stroke="#5ddc8a" stroke-width="1.6" />
+  <text x="640" y="118" text-anchor="middle" fill="#5ddc8a" font-size="15" font-weight="700" font-family="-apple-system,Arial,sans-serif">Prover</text>
+
+  <rect x="810" y="86" width="100" height="52" rx="9" fill="#0a0f19" stroke="#ff8080" stroke-width="1.6" stroke-dasharray="5 5" />
+  <text x="860" y="118" text-anchor="middle" fill="#ff8080" font-size="14" font-weight="700" font-family="-apple-system,Arial,sans-serif">Verifier</text>
+
+  <line x1="640" y1="138" x2="640" y2="172" stroke="#3ab7ff" stroke-width="1.8" marker-end="url(#fs-arrow-cyan)" />
+
+  <text x="755" y="166" text-anchor="middle" fill="#8fdcff" font-size="12.5" font-weight="700" font-family="-apple-system,Arial,sans-serif">prover derives the challenge</text>
+  <rect x="610" y="178" width="290" height="56" rx="10" fill="#0d1526" stroke="#8fdcff" stroke-width="1.8" />
+  <text x="755" y="213" text-anchor="middle" fill="#e9eef5" font-size="17" font-weight="800" font-family="SF Mono, Fira Code, Consolas, monospace">c = H(transcript)</text>
+
