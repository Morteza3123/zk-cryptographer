+    </marker>
+    <marker id="fs-arrow-blue" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6.5" markerHeight="6.5" orient="auto-start-reverse">
+      <path d="M0,0 L10,5 L0,10 z" fill="#8fdcff" />
+    </marker>
+    <marker id="fs-arrow-cyan" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6.5" markerHeight="6.5" orient="auto-start-reverse">
+      <path d="M0,0 L10,5 L0,10 z" fill="#3ab7ff" />
+    </marker>
+  </defs>
+</svg>
diff --git a/src/components/figures/HashFunctionFigure.astro b/src/components/figures/HashFunctionFigure.astro
new file mode 100644
index 0000000..6e5852b
--- /dev/null
+++ b/src/components/figures/HashFunctionFigure.astro
@@ -0,0 +1,55 @@
+---
+// Fig. for "Hash Functions & Random Oracles": what a hash function does —
+// any-size input compresses to a fixed-size output, deterministically.
+interface Row {
+  y: number;
+  input: string;
+  output: string;
+}
+const rows: Row[] = [
+  { y: 96, input: "Hi", output: "2cf24dba… 9824" },
+  { y: 218, input: "Hello, world!", output: "315f5bdb… f2d3" },
+  { y: 340, input: "A 5 GB video file", output: "e3b0c442… b855" },
+];
+const hx = { x: 280, y: 158, w: 140, h: 120 };
+const cx = hx.x + hx.w / 2;
+const cy = hx.y + hx.h / 2;
+const boxW = 220;
+const boxH = 56;
+---
+<svg viewBox="0 0 700 460" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;display:block;">
+  <text x="350" y="30" text-anchor="middle" fill="#e9eef5" font-size="16" font-weight="800" font-family="-apple-system,Arial,sans-serif">any size in, the same size out</text>
+
+  <text x="40" y="64" text-anchor="start" fill="#5ddc8a" font-size="13" font-weight="700" font-family="-apple-system,Arial,sans-serif">input: any size</text>
+  <text x="660" y="64" text-anchor="end" fill="#8fdcff" font-size="13" font-weight="700" font-family="-apple-system,Arial,sans-serif">digest: fixed size</text>
+
+  {rows.map((row) => (
+    <>
+      <rect x="20" y={row.y - boxH / 2} width={boxW} height={boxH} rx="9" fill="#121c2c" stroke="#5ddc8a" stroke-width="1.6" />
+      <text x={20 + boxW / 2} y={row.y + 6} text-anchor="middle" fill="#e9eef5" font-size="15" font-weight="700" font-family="-apple-system,Arial,sans-serif">{row.input}</text>
+
+      <line x1="240" y1={row.y} x2={hx.x - 4} y2={cy} stroke="#3ab7ff" stroke-width="1.6" marker-end="url(#hf-arrow-in)" />
+
+      <line x1={hx.x + hx.w + 4} y1={cy} x2="460" y2={row.y} stroke="#3ab7ff" stroke-width="1.6" marker-end="url(#hf-arrow-out)" />
+
+      <rect x="460" y={row.y - boxH / 2} width={boxW} height={boxH} rx="9" fill="#121c2c" stroke="#8fdcff" stroke-width="1.6" />
+      <text x={460 + boxW / 2} y={row.y + 5} text-anchor="middle" fill="#c3cedd" font-size="14" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">{row.output}</text>
+    </>
+  ))}
+
+  <rect x={hx.x} y={hx.y} width={hx.w} height={hx.h} rx="12" fill="#0a0f19" stroke="#e9eef5" stroke-width="2" />
+  <text x={cx} y={cy + 10} text-anchor="middle" fill="#e9eef5" font-size="30" font-weight="800" font-family="SF Mono, Fira Code, Consolas, monospace">H(x)</text>
+
+  <line x1="20" y1="402" x2="680" y2="402" stroke="#223049" stroke-width="1" />
+  <text x="350" y="426" text-anchor="middle" fill="#8fdcff" font-size="14.5" font-weight="800" font-family="-apple-system,Arial,sans-serif">DETERMINISTIC &#183; FIXED SIZE &#183; ONE-WAY</text>
+  <text x="350" y="448" text-anchor="middle" fill="#8b96a8" font-size="12.5" font-family="-apple-system,Arial,sans-serif">same input always gives the same digest — change one bit and it changes completely</text>
+
+  <defs>
+    <marker id="hf-arrow-in" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6.5" markerHeight="6.5" orient="auto-start-reverse">
+      <path d="M0,0 L10,5 L0,10 z" fill="#3ab7ff" />
+    </marker>
+    <marker id="hf-arrow-out" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6.5" markerHeight="6.5" orient="auto-start-reverse">
+      <path d="M0,0 L10,5 L0,10 z" fill="#3ab7ff" />
+    </marker>
+  </defs>
+</svg>
diff --git a/src/components/figures/OneWayHashFigure.astro b/src/components/figures/OneWayHashFigure.astro
new file mode 100644
index 0000000..9c7ca0b
--- /dev/null
+++ b/src/components/figures/OneWayHashFigure.astro
@@ -0,0 +1,37 @@
+---
+// Fig. for "Hash Functions & Random Oracles": the one-way property of a
+// hash function — computing H(x) from x is easy, but recovering x from
+// H(x) is infeasible. (Named distinctly from OneWayFunctionFigure, which
+// is the earlier prime-factorization one-way figure used in
+// "Divisibility, Factors & Primes" — same underlying idea, different
+// lesson and different visual.)
+---
+<svg viewBox="0 0 640 320" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;display:block;">
+  <text x="320" y="30" text-anchor="middle" fill="#e9eef5" font-size="16" font-weight="800" font-family="-apple-system,Arial,sans-serif">easy to compute, infeasible to reverse</text>
+
+  <circle cx="120" cy="170" r="66" fill="#0a0f19" stroke="#5ddc8a" stroke-width="2.4" />
+  <text x="120" y="182" text-anchor="middle" fill="#e9eef5" font-size="30" font-weight="800" font-family="SF Mono, Fira Code, Consolas, monospace">x</text>
+
+  <circle cx="520" cy="170" r="66" fill="#0a0f19" stroke="#3ab7ff" stroke-width="2.4" />
+  <text x="520" y="182" text-anchor="middle" fill="#e9eef5" font-size="26" font-weight="800" font-family="SF Mono, Fira Code, Consolas, monospace">f(x)</text>
+
+  <line x1="196" y1="150" x2="444" y2="150" stroke="#5ddc8a" stroke-width="2" marker-end="url(#owf-arrow-fwd)" />
+  <text x="320" y="126" text-anchor="middle" fill="#5ddc8a" font-size="14.5" font-weight="800" font-family="-apple-system,Arial,sans-serif">EASY</text>
+  <text x="320" y="142" text-anchor="middle" fill="#8b96a8" font-size="12" font-family="SF Mono, Fira Code, Consolas, monospace">compute f(x) from x</text>
+
+  <line x1="444" y1="200" x2="196" y2="200" stroke="#ff8080" stroke-width="2" stroke-dasharray="7 6" marker-end="url(#owf-arrow-back)" />
+  <text x="320" y="228" text-anchor="middle" fill="#ff8080" font-size="14.5" font-weight="800" font-family="-apple-system,Arial,sans-serif">INFEASIBLE</text>
+  <text x="320" y="244" text-anchor="middle" fill="#8b96a8" font-size="12" font-family="SF Mono, Fira Code, Consolas, monospace">cannot recover x from f(x)</text>
+
+  <line x1="20" y1="276" x2="620" y2="276" stroke="#223049" stroke-width="1" />
+  <text x="320" y="300" text-anchor="middle" fill="#8fdcff" font-size="14.5" font-weight="800" font-family="-apple-system,Arial,sans-serif">EASY FORWARD &#183; IMPOSSIBLE BACKWARD</text>
+
+  <defs>
+    <marker id="owf-arrow-fwd" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6.5" markerHeight="6.5" orient="auto-start-reverse">
+      <path d="M0,0 L10,5 L0,10 z" fill="#5ddc8a" />
+    </marker>
+    <marker id="owf-arrow-back" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6.5" markerHeight="6.5" orient="auto-start-reverse">
+      <path d="M0,0 L10,5 L0,10 z" fill="#ff8080" />
+    </marker>
+  </defs>
+</svg>
diff --git a/src/components/figures/RandomOracleFigure.astro b/src/components/figures/RandomOracleFigure.astro
new file mode 100644
index 0000000..e9d0336
--- /dev/null
+++ b/src/components/figures/RandomOracleFigure.astro
@@ -0,0 +1,59 @@
+---
+// Fig. for "Hash Functions & Random Oracles": the random oracle model —
+// a magic box that hands back fresh randomness on a new query, and the
+// exact same answer again on a repeated query.
+interface Row {
+  y: number;
+  query: string;
+  response: string;
+  repeat?: boolean;
+}
+const rows: Row[] = [
+  { y: 100, query: "x₁", response: "r₁ random" },
+  { y: 222, query: "x₂", response: "r₂ random" },
+  { y: 344, query: "x₁ again", response: "r₁ again", repeat: true },
+];
+const ox = { x: 280, y: 158, w: 140, h: 170 };
+const cx = ox.x + ox.w / 2;
+const boxW = 220;
+const boxH = 56;
+---
+<svg viewBox="0 0 700 460" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;display:block;">
+  <text x="350" y="30" text-anchor="middle" fill="#e9eef5" font-size="16" font-weight="800" font-family="-apple-system,Arial,sans-serif">O(x): truly random, yet consistent</text>
+
+  <text x="40" y="64" text-anchor="start" fill="#5ddc8a" font-size="13" font-weight="700" font-family="-apple-system,Arial,sans-serif">queries</text>
+  <text x="660" y="64" text-anchor="end" fill="#8fdcff" font-size="13" font-weight="700" font-family="-apple-system,Arial,sans-serif">responses</text>
+
+  {rows.map((row) => (
+    <>
+      <rect x="20" y={row.y - boxH / 2} width={boxW} height={boxH} rx="9" fill="#121c2c" stroke={row.repeat ? "#8fdcff" : "#5ddc8a"} stroke-width="1.6" />
+      <text x={20 + boxW / 2} y={row.y + 6} text-anchor="middle" fill="#e9eef5" font-size="16" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">{row.query}</text>
+
+      <line x1="240" y1={row.y} x2={ox.x - 4} y2={row.y} stroke="#3ab7ff" stroke-width="1.6" marker-end="url(#ro-arrow-in)" />
+      <line x1={ox.x + ox.w + 4} y1={row.y} x2="460" y2={row.y} stroke="#3ab7ff" stroke-width="1.6" marker-end="url(#ro-arrow-out)" />
+
+      <rect x="460" y={row.y - boxH / 2} width={boxW} height={boxH} rx="9" fill="#121c2c" stroke={row.repeat ? "#8fdcff" : "#ff8080"} stroke-width="1.6" />
+      <text x={460 + boxW / 2} y={row.y + 6} text-anchor="middle" fill="#e9eef5" font-size="15" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">{row.response}</text>
+    </>
+  ))}
+
