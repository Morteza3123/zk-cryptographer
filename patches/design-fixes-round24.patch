+  <line x1="640" y1="300" x2="858" y2="300" stroke="#e9eef5" stroke-width="1.8" marker-end="url(#fs-arrow-w)" />
+
+  <text x="755" y="356" text-anchor="middle" fill="#8b96a8" font-size="12.5" font-family="-apple-system,Arial,sans-serif">verifier checks later, offline</text>
+
+  <line x1="40" y1="398" x2="900" y2="398" stroke="#223049" stroke-width="1" />
+  <text x="460" y="424" text-anchor="middle" fill="#8fdcff" font-size="15.5" font-weight="800" font-family="-apple-system,Arial,sans-serif">THE HASH PLAYS THE VERIFIER'S ROLE</text>
+  <text x="460" y="448" text-anchor="middle" fill="#8b96a8" font-size="12.5" font-family="-apple-system,Arial,sans-serif">it acts as a random oracle, so H(transcript) gives a fresh, unpredictable challenge</text>
+
