diff --git a/src/components/figures/PolynomialRootsFigure.astro b/src/components/figures/PolynomialRootsFigure.astro
new file mode 100644
index 0000000..7bda830
--- /dev/null
+++ b/src/components/figures/PolynomialRootsFigure.astro
@@ -0,0 +1,42 @@
+---
+// Fig. for "Polynomials": testing candidates against p(x) = x² - 5x + 6 —
+// two land on zero (the roots), one doesn't.
+interface Row {
+  label: string;
+  eq: string;
+  isRoot: boolean;
+}
+const rows: Row[] = [
+  { label: "check x = 2", eq: "2² − 5(2) + 6 = 4 − 10 + 6 = 0", isRoot: true },
+  { label: "check x = 3", eq: "3² − 5(3) + 6 = 9 − 15 + 6 = 0", isRoot: true },
+  { label: "check x = 1", eq: "1² − 5(1) + 6 = 1 − 5 + 6 = 2", isRoot: false },
+];
+const rowH = 48;
+const topPad = 62;
+const tableH = rows.length * rowH;
+const footerH = 56;
+const height = topPad + tableH + footerH + 10;
+---
+<svg viewBox={`0 0 680 ${height}`} xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;display:block;">
+  <text x="340" y="26" text-anchor="middle" fill="#8fdcff" font-size="14" font-weight="700" font-family="-apple-system,Arial,sans-serif">roots — where p(x) = 0</text>
+  <text x="340" y="48" text-anchor="middle" fill="#e9eef5" font-size="16" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">p(x) = x² − 5x + 6</text>
+  <line x1="20" y1="58" x2="660" y2="58" stroke="#223049" stroke-width="1" />
+
+  {rows.map((row, i) => {
+    const y = topPad + i * rowH;
+    const color = row.isRoot ? "#5ddc8a" : "#ff8080";
+    const verdict = row.isRoot ? "✓ root" : "✗ not a root";
+    return (
+      <>
+        <text x="40" y={y + 16} text-anchor="start" fill="#c3cedd" font-size="14.5" font-weight="700" font-family="-apple-system,Arial,sans-serif">{row.label}</text>
+        <text x="420" y={y + 16} text-anchor="middle" fill="#cdd9e8" font-size="14" font-family="SF Mono, Fira Code, Consolas, monospace">{row.eq}</text>
+        <text x="640" y={y + 16} text-anchor="end" fill={color} font-size="14" font-weight="800" font-family="-apple-system,Arial,sans-serif">{verdict}</text>
+        {i < rows.length - 1 && (
+          <line x1="20" y1={y + rowH - 12} x2="660" y2={y + rowH - 12} stroke="#1a2436" stroke-width="1" />
+        )}
+      </>
+    );
+  })}
+
+  <text x="340" y={topPad + tableH + footerH / 2 + 5} text-anchor="middle" fill="#5ddc8a" font-size="14" font-weight="700" font-family="-apple-system,Arial,sans-serif">2 and 3 are the roots — this polynomial factors as (x−2)(x−3)</text>
+</svg>
