+---
+track: math
+module: "The Bridge"
+lessonNumber: "18"
+title: "Euclid, CRT & Euler"
+duration: "18:15"
+description: "A faster way to find the gcd and the inverse for any modulus, not just a prime; how two small congruences combine into one big one through the Chinese Remainder Theorem; and Euler's theorem, the one formula that makes Fermat's little theorem from Topic 5 just its prime special case."
+order: 18
+youtubeHref: "https://youtu.be/5dkVbJZWJ0U"
+prevTitle: "Information Theory & Entropy"
+prevHref: "/learn/math/information-theory-entropy"
+---
+
+import MathBox from "../../components/MathBox.astro";
+import Figure from "../../components/Figure.astro";
+import GcdEuclidFigure from "../../components/figures/GcdEuclidFigure.astro";
+import ExtendedEuclidForwardFigure from "../../components/figures/ExtendedEuclidForwardFigure.astro";
+import ExtendedEuclidBackwardFigure from "../../components/figures/ExtendedEuclidBackwardFigure.astro";
+import NoInverseFigure from "../../components/figures/NoInverseFigure.astro";
+import CRTSearchFigure from "../../components/figures/CRTSearchFigure.astro";
