diff --git a/src/components/figures/ExtendedEuclidBackwardFigure.astro b/src/components/figures/ExtendedEuclidBackwardFigure.astro
new file mode 100644
index 0000000..13994c2
--- /dev/null
+++ b/src/components/figures/ExtendedEuclidBackwardFigure.astro
@@ -0,0 +1,44 @@
+---
+// Fig. for "Euclid, CRT & Euler": back-substituting the three kept lines
+// from the forward Euclid pass on (26, 7) to isolate 1 as a combination of
+// 26 and 7, then reducing the 7-coefficient to a positive residue — the
+// inverse itself.
+---
+<svg viewBox="0 0 760 520" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;display:block;">
+  <text x="380" y="26" text-anchor="middle" fill="#e9eef5" font-size="16" font-weight="800" font-family="-apple-system,Arial,sans-serif">working backwards to find the inverse</text>
+
+  <rect x="40" y="42" width="680" height="64" rx="10" fill="#111c2e" stroke="#223049" stroke-width="1" />
+  <text x="60" y="62" fill="#8b96a8" font-size="11.5" font-weight="700" font-family="-apple-system,Arial,sans-serif">THE THREE LINES FROM PART 1</text>
+  <text x="60" y="84" fill="#8fdcff" font-size="14" font-family="SF Mono, Fira Code, Consolas, monospace">26 = 3&#215;7 + 5</text>
+  <text x="300" y="84" fill="#8fdcff" font-size="14" font-family="SF Mono, Fira Code, Consolas, monospace">7 = 1&#215;5 + 2</text>
+  <text x="540" y="84" fill="#8fdcff" font-size="14" font-family="SF Mono, Fira Code, Consolas, monospace">5 = 2&#215;2 + 1</text>
+  <text x="60" y="100" fill="#8b96a8" font-size="11" font-family="-apple-system,Arial,sans-serif">(line 1)</text>
+  <text x="300" y="100" fill="#8b96a8" font-size="11" font-family="-apple-system,Arial,sans-serif">(line 2)</text>
+  <text x="540" y="100" fill="#8b96a8" font-size="11" font-family="-apple-system,Arial,sans-serif">(line 3)</text>
+
+  <text x="40" y="138" fill="#8b96a8" font-size="12" font-weight="700" font-family="-apple-system,Arial,sans-serif">STEP 1 &#8212; start from line 3</text>
+  <text x="720" y="138" text-anchor="end" fill="#e9eef5" font-size="16.5" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">1 = 5 &#8722; 2&#215;2</text>
+
+  <text x="40" y="180" fill="#8b96a8" font-size="12" font-weight="700" font-family="-apple-system,Arial,sans-serif">STEP 2 &#8212; replace 2 using line 2 (2 = 7 &#8722; 5)</text>
+  <text x="720" y="180" text-anchor="end" fill="#e9eef5" font-size="16.5" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">1 = 3&#215;<tspan fill="#8fdcff">5</tspan> &#8722; 2&#215;7</text>
+
+  <text x="40" y="222" fill="#8b96a8" font-size="12" font-weight="700" font-family="-apple-system,Arial,sans-serif">STEP 3 &#8212; replace 5 using line 1 (5 = 26 &#8722; 3&#215;7)</text>
+  <text x="720" y="222" text-anchor="end" fill="#e9eef5" font-size="16.5" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">1 = 3&#215;26 &#8722; 11&#215;7</text>
+
+  <text x="40" y="264" fill="#8b96a8" font-size="12" font-weight="700" font-family="-apple-system,Arial,sans-serif">STEP 4 &#8212; drop the 26-term (it's 0 mod 26)</text>
+  <text x="720" y="264" text-anchor="end" fill="#e9eef5" font-size="16.5" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">1 &#8801; &#8722;11&#215;7 (mod 26)</text>
+
+  <text x="40" y="306" fill="#8b96a8" font-size="12" font-weight="700" font-family="-apple-system,Arial,sans-serif">STEP 5 &#8212; add 26 to make the coefficient positive</text>
+  <text x="720" y="306" text-anchor="end" fill="#e9eef5" font-size="16.5" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">&#8722;11 + 26 = <tspan fill="#5ddc8a">15</tspan></text>
+
+  <line x1="40" y1="330" x2="720" y2="330" stroke="#1a2436" stroke-width="1" />
+
+  <rect x="220" y="350" width="320" height="52" rx="10" fill="#0d1a12" stroke="#5ddc8a" stroke-width="2" />
+  <text x="380" y="384" text-anchor="middle" fill="#5ddc8a" font-size="17" font-weight="800" font-family="SF Mono, Fira Code, Consolas, monospace">7<tspan dy="-7" font-size="65%">-1</tspan><tspan dy="7"> &#8801; 15 (mod 26)</tspan></text>
+
+  <text x="380" y="428" text-anchor="middle" fill="#8b96a8" font-size="12.5" font-family="-apple-system,Arial,sans-serif">Check: 7 &#215; 15 = 105 = 4 &#215; 26 + 1.</text>
+
+  <line x1="40" y1="446" x2="720" y2="446" stroke="#223049" stroke-width="1" />
+  <text x="380" y="470" text-anchor="middle" fill="#8fdcff" font-size="15.5" font-weight="800" font-family="-apple-system,Arial,sans-serif">THE INVERSE OF 7 MOD 26 IS 15</text>
+  <text x="380" y="490" text-anchor="middle" fill="#8b96a8" font-size="12.5" font-family="-apple-system,Arial,sans-serif">This works for any modulus, not just a prime.</text>
+</svg>
diff --git a/src/components/figures/ExtendedEuclidForwardFigure.astro b/src/components/figures/ExtendedEuclidForwardFigure.astro
new file mode 100644
index 0000000..9b8f9cb
--- /dev/null
+++ b/src/components/figures/ExtendedEuclidForwardFigure.astro
@@ -0,0 +1,37 @@
+---
+// Fig. for "Euclid, CRT & Euler": the forward Euclid pass on (26, 7). Three
+// of the four steps (green) land on a nonzero remainder and get kept for
+// back-substitution; the last step (muted) only confirms the gcd is 1.
+---
+<svg viewBox="0 0 760 460" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;display:block;">
+  <text x="380" y="26" text-anchor="middle" fill="#e9eef5" font-size="16" font-weight="800" font-family="-apple-system,Arial,sans-serif">does 7 have an inverse mod 26?</text>
+  <text x="380" y="50" text-anchor="middle" fill="#8b96a8" font-size="12" font-style="italic" font-family="-apple-system,Arial,sans-serif">run the same division chain on (26, 7)</text>
+
+  <text x="40" y="84" fill="#8b96a8" font-size="12" font-weight="700" font-family="-apple-system,Arial,sans-serif">STEP 1</text>
+  <rect x="640" y="68" width="80" height="22" rx="5" fill="#0d1a12" stroke="#5ddc8a" stroke-width="1" />
+  <text x="680" y="83" text-anchor="middle" fill="#5ddc8a" font-size="11" font-weight="700" font-family="-apple-system,Arial,sans-serif">KEEP</text>
+  <text x="40" y="106" fill="#e9eef5" font-size="18" font-weight="800" font-family="SF Mono, Fira Code, Consolas, monospace">26 = 3 &#215; 7 + <tspan fill="#5ddc8a">5</tspan></text>
+
+  <text x="40" y="148" fill="#8b96a8" font-size="12" font-weight="700" font-family="-apple-system,Arial,sans-serif">STEP 2</text>
+  <rect x="640" y="132" width="80" height="22" rx="5" fill="#0d1a12" stroke="#5ddc8a" stroke-width="1" />
+  <text x="680" y="147" text-anchor="middle" fill="#5ddc8a" font-size="11" font-weight="700" font-family="-apple-system,Arial,sans-serif">KEEP</text>
+  <text x="40" y="170" fill="#e9eef5" font-size="18" font-weight="800" font-family="SF Mono, Fira Code, Consolas, monospace">7 = 1 &#215; 5 + <tspan fill="#5ddc8a">2</tspan></text>
+
+  <text x="40" y="212" fill="#8b96a8" font-size="12" font-weight="700" font-family="-apple-system,Arial,sans-serif">STEP 3</text>
+  <rect x="640" y="196" width="80" height="22" rx="5" fill="#0d1a12" stroke="#5ddc8a" stroke-width="1" />
+  <text x="680" y="211" text-anchor="middle" fill="#5ddc8a" font-size="11" font-weight="700" font-family="-apple-system,Arial,sans-serif">KEEP</text>
+  <text x="40" y="234" fill="#e9eef5" font-size="18" font-weight="800" font-family="SF Mono, Fira Code, Consolas, monospace">5 = 2 &#215; 2 + <tspan fill="#5ddc8a">1</tspan></text>
+
+  <text x="40" y="276" fill="#8b96a8" font-size="12" font-weight="700" font-family="-apple-system,Arial,sans-serif">STEP 4</text>
+  <text x="40" y="298" fill="#8b96a8" font-size="18" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">2 = 2 &#215; 1 + 0</text>
+  <text x="720" y="298" text-anchor="end" fill="#8b96a8" font-size="12.5" font-family="-apple-system,Arial,sans-serif">remainder 0 — just confirms the chain is done</text>
+
+  <rect x="200" y="320" width="360" height="50" rx="10" fill="#0d1a12" stroke="#5ddc8a" stroke-width="2" />
+  <text x="380" y="352" text-anchor="middle" fill="#5ddc8a" font-size="16" font-weight="800" font-family="SF Mono, Fira Code, Consolas, monospace">gcd(26, 7) = 1 &#8594; an inverse exists</text>
+
+  <text x="380" y="394" text-anchor="middle" fill="#8b96a8" font-size="12.5" font-family="-apple-system,Arial,sans-serif">26 and 7 share no factor except 1.</text>
+
+  <line x1="40" y1="412" x2="720" y2="412" stroke="#223049" stroke-width="1" />
+  <text x="380" y="436" text-anchor="middle" fill="#8fdcff" font-size="15.5" font-weight="800" font-family="-apple-system,Arial,sans-serif">KEEP EVERY LINE — WE NEED THEM NEXT</text>
+  <text x="380" y="456" text-anchor="middle" fill="#8b96a8" font-size="12.5" font-family="-apple-system,Arial,sans-serif">Part 2 uses these three lines to find the inverse.</text>
+</svg>
diff --git a/src/components/figures/GcdEuclidFigure.astro b/src/components/figures/GcdEuclidFigure.astro
new file mode 100644
index 0000000..0d83bc5
--- /dev/null
+++ b/src/components/figures/GcdEuclidFigure.astro
@@ -0,0 +1,39 @@
+---
+// Fig. for "Euclid, CRT & Euler": gcd(252, 105) by repeated division — each
+// step's divisor and remainder (blue) become the next step's pair, until a
+// remainder of zero stops the chain and the last nonzero remainder (green)
+// is the gcd.
+---
+<svg viewBox="0 0 760 480" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;display:block;">
+  <text x="380" y="26" text-anchor="middle" fill="#e9eef5" font-size="16" font-weight="800" font-family="-apple-system,Arial,sans-serif">finding the gcd by repeated division</text>
+  <text x="380" y="50" text-anchor="middle" fill="#8b96a8" font-size="12" font-style="italic" font-family="-apple-system,Arial,sans-serif">a = b &#215; q + r &#8212; b and r become the next pair</text>
+
+  <text x="40" y="94" fill="#8b96a8" font-size="12" font-weight="700" font-family="-apple-system,Arial,sans-serif">STEP 1</text>
+  <text x="40" y="118" fill="#e9eef5" font-size="19" font-weight="800" font-family="SF Mono, Fira Code, Consolas, monospace">252 = 2 &#215; <tspan fill="#8fdcff">105</tspan> + <tspan fill="#8fdcff">42</tspan></text>
+  <text x="720" y="118" text-anchor="end" fill="#8b96a8" font-size="12.5" font-family="-apple-system,Arial,sans-serif">105 fits in 252 twice (210). Left over: 42.</text>
+  <path d="M 100 130 C 100 155 60 155 60 178" fill="none" stroke="#8fdcff" stroke-width="1.4" marker-end="url(#ge-arrow)" />
+
+  <text x="40" y="188" fill="#8b96a8" font-size="12" font-weight="700" font-family="-apple-system,Arial,sans-serif">STEP 2</text>
+  <text x="40" y="212" fill="#e9eef5" font-size="19" font-weight="800" font-family="SF Mono, Fira Code, Consolas, monospace">105 = 2 &#215; <tspan fill="#8fdcff">42</tspan> + <tspan fill="#8fdcff">21</tspan></text>
+  <text x="720" y="212" text-anchor="end" fill="#8b96a8" font-size="12.5" font-family="-apple-system,Arial,sans-serif">42 fits in 105 twice (84). Left over: 21.</text>
+  <path d="M 90 224 C 90 249 60 249 60 272" fill="none" stroke="#8fdcff" stroke-width="1.4" marker-end="url(#ge-arrow)" />
+
+  <text x="40" y="282" fill="#8b96a8" font-size="12" font-weight="700" font-family="-apple-system,Arial,sans-serif">STEP 3</text>
+  <text x="40" y="306" fill="#e9eef5" font-size="19" font-weight="800" font-family="SF Mono, Fira Code, Consolas, monospace">42 = 2 &#215; <tspan fill="#8fdcff">21</tspan> + <tspan fill="#5ddc8a">0</tspan></text>
+  <text x="720" y="306" text-anchor="end" fill="#8b96a8" font-size="12.5" font-family="-apple-system,Arial,sans-serif">21 fits in 42 exactly. Left over: 0. Stop.</text>
+
+  <rect x="260" y="330" width="240" height="50" rx="10" fill="#0d1a12" stroke="#5ddc8a" stroke-width="2" />
+  <text x="380" y="362" text-anchor="middle" fill="#5ddc8a" font-size="17" font-weight="800" font-family="SF Mono, Fira Code, Consolas, monospace">gcd(252, 105) = 21</text>
+
+  <text x="380" y="404" text-anchor="middle" fill="#8b96a8" font-size="12.5" font-family="-apple-system,Arial,sans-serif">Check: 252 &#247; 21 = 12 and 105 &#247; 21 = 5 &#8212; both divide evenly.</text>
+
+  <line x1="40" y1="422" x2="720" y2="422" stroke="#223049" stroke-width="1" />
+  <text x="380" y="446" text-anchor="middle" fill="#8fdcff" font-size="15.5" font-weight="800" font-family="-apple-system,Arial,sans-serif">THE LAST NONZERO REMAINDER IS THE GCD</text>
+  <text x="380" y="466" text-anchor="middle" fill="#8b96a8" font-size="12.5" font-family="-apple-system,Arial,sans-serif">Each step shrinks the numbers, so it finishes fast.</text>
+
+  <defs>
+    <marker id="ge-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
+      <path d="M0,0 L10,5 L0,10 z" fill="#8fdcff" />
+    </marker>
+  </defs>
+</svg>
diff --git a/src/components/figures/NoInverseFigure.astro b/src/components/figures/NoInverseFigure.astro
new file mode 100644
index 0000000..5a5c0c6
--- /dev/null
+++ b/src/components/figures/NoInverseFigure.astro
@@ -0,0 +1,39 @@
+---
+// Fig. for "Euclid, CRT & Euler": 6 mod 9 has no inverse — every product
+// 6x mod 9 is checked and none ever lands on 1, which Euclid's algorithm
+// explains directly: gcd(9, 6) = 3, not 1.
+const xs = [1, 2, 3, 4, 5, 6, 7, 8, 9];
+const products = [6, 12, 18, 24, 30, 36, 42, 48, 54];
+const remainders = [6, 3, 0, 6, 3, 0, 6, 3, 0];
+const cols = [92, 164, 236, 308, 380, 452, 524, 596, 668];
+---
+<svg viewBox="0 0 760 420" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;display:block;">
+  <text x="380" y="26" text-anchor="middle" fill="#e9eef5" font-size="16" font-weight="800" font-family="-apple-system,Arial,sans-serif">when an inverse does not exist</text>
+  <text x="380" y="50" text-anchor="middle" fill="#8b96a8" font-size="12" font-style="italic" font-family="-apple-system,Arial,sans-serif">does 6 have an inverse mod 9?</text>
+
+  <text x="40" y="76" fill="#8b96a8" font-size="12" font-weight="700" font-family="-apple-system,Arial,sans-serif">STEP 1 &#8212; check every 6x mod 9</text>
+  {cols.map((cx, i) => (
+    <>
+      <text x={cx} y="98" text-anchor="middle" fill="#8fdcff" font-size="12.5" font-family="SF Mono, Fira Code, Consolas, monospace">x={xs[i]}</text>
+      <text x={cx} y="120" text-anchor="middle" fill="#e9eef5" font-size="13.5" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">{products[i]}</text>
+      <text x={cx} y="142" text-anchor="middle" fill="#c3cedd" font-size="13.5" font-family="SF Mono, Fira Code, Consolas, monospace">&#8801;{remainders[i]}</text>
+    </>
+  ))}
+  <text x="380" y="166" text-anchor="middle" fill="#ff5c7a" font-size="13" font-weight="700" font-family="-apple-system,Arial,sans-serif">no x ever makes 6x &#8801; 1 (mod 9)</text>
+
+  <line x1="40" y1="184" x2="720" y2="184" stroke="#1a2436" stroke-width="1" />
+
+  <text x="40" y="212" fill="#8b96a8" font-size="12" font-weight="700" font-family="-apple-system,Arial,sans-serif">STEP 2 &#8212; Euclid's algorithm explains why</text>
+  <text x="720" y="212" text-anchor="end" fill="#e9eef5" font-size="16" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">9 = 1 &#215; 6 + 3</text>
+  <text x="720" y="238" text-anchor="end" fill="#e9eef5" font-size="16" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">6 = 2 &#215; 3 + 0</text>
+
+  <rect x="200" y="258" width="360" height="52" rx="10" fill="#1f0f14" stroke="#ff5c7a" stroke-width="2" />
+  <text x="380" y="283" text-anchor="middle" fill="#ff5c7a" font-size="15" font-weight="800" font-family="SF Mono, Fira Code, Consolas, monospace">gcd(9, 6) = 3, not 1</text>
+  <text x="380" y="301" text-anchor="middle" fill="#ff8fa3" font-size="12" font-family="-apple-system,Arial,sans-serif">so 6 has no inverse mod 9</text>
+
+  <text x="380" y="332" text-anchor="middle" fill="#8b96a8" font-size="12.5" font-family="-apple-system,Arial,sans-serif">Compare: gcd(26, 7) = 1, so 7 does have an inverse mod 26.</text>
+
+  <line x1="40" y1="350" x2="720" y2="350" stroke="#223049" stroke-width="1" />
+  <text x="380" y="374" text-anchor="middle" fill="#8fdcff" font-size="15.5" font-weight="800" font-family="-apple-system,Arial,sans-serif">AN INVERSE EXISTS ONLY WHEN THE GCD IS 1</text>
+  <text x="380" y="394" text-anchor="middle" fill="#8b96a8" font-size="12.5" font-family="-apple-system,Arial,sans-serif">With a prime modulus, every nonzero number qualifies.</text>
+</svg>
