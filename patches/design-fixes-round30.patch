diff --git a/src/components/figures/BridgeToolsSummaryFigure.astro b/src/components/figures/BridgeToolsSummaryFigure.astro
new file mode 100644
index 0000000..4f86224
--- /dev/null
+++ b/src/components/figures/BridgeToolsSummaryFigure.astro
@@ -0,0 +1,48 @@
+---
+// Fig. for "Euclid, CRT & Euler": the three tools this lesson adds, and
+// what each one is for — mirrors the three-column summary pattern from the
+// entropy lesson's "three promises" figure.
+---
+<svg viewBox="0 0 760 430" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;display:block;">
+  <text x="380" y="26" text-anchor="middle" fill="#e9eef5" font-size="16" font-weight="800" font-family="-apple-system,Arial,sans-serif">three tools, one bridge to the next topics</text>
+
+  <!-- euclid -->
+  <rect x="30" y="56" width="220" height="260" rx="12" fill="#121c2c" stroke="#3ab7ff" stroke-width="1.8" />
+  <text x="140" y="84" text-anchor="middle" fill="#8fdcff" font-size="14.5" font-weight="800" font-family="-apple-system,Arial,sans-serif">EUCLID</text>
+  <text x="140" y="108" text-anchor="middle" fill="#c3cedd" font-size="12" font-family="-apple-system,Arial,sans-serif">finds gcd(a, n) fast, and the</text>
+  <text x="140" y="126" text-anchor="middle" fill="#c3cedd" font-size="12" font-family="-apple-system,Arial,sans-serif">inverse of a mod any n</text>
+  <line x1="50" y1="146" x2="230" y2="146" stroke="#223049" stroke-width="1" />
+  <text x="140" y="166" text-anchor="middle" fill="#8b96a8" font-size="11" font-style="italic" font-family="-apple-system,Arial,sans-serif">replaces</text>
+  <text x="140" y="196" text-anchor="middle" fill="#e9eef5" font-size="12" font-family="-apple-system,Arial,sans-serif">the brute-force search from</text>
+  <text x="140" y="214" text-anchor="middle" fill="#e9eef5" font-size="12" font-family="-apple-system,Arial,sans-serif">Modular Inverses (Topic 5)</text>
+  <text x="140" y="244" text-anchor="middle" fill="#e9eef5" font-size="12" font-family="-apple-system,Arial,sans-serif">works for any modulus, not</text>
+  <text x="140" y="262" text-anchor="middle" fill="#e9eef5" font-size="12" font-family="-apple-system,Arial,sans-serif">only a prime one</text>
+
+  <!-- crt -->
+  <rect x="270" y="56" width="220" height="260" rx="12" fill="#121c2c" stroke="#5ddc8a" stroke-width="1.8" />
+  <text x="380" y="84" text-anchor="middle" fill="#5ddc8a" font-size="14.5" font-weight="800" font-family="-apple-system,Arial,sans-serif">CRT</text>
+  <text x="380" y="108" text-anchor="middle" fill="#c3cedd" font-size="12" font-family="-apple-system,Arial,sans-serif">splits one big modulus into</text>
+  <text x="380" y="126" text-anchor="middle" fill="#c3cedd" font-size="12" font-family="-apple-system,Arial,sans-serif">several small coprime ones</text>
+  <line x1="290" y1="146" x2="470" y2="146" stroke="#223049" stroke-width="1" />
+  <text x="380" y="166" text-anchor="middle" fill="#8b96a8" font-size="11" font-style="italic" font-family="-apple-system,Arial,sans-serif">used for</text>
+  <text x="380" y="196" text-anchor="middle" fill="#e9eef5" font-size="12" font-family="-apple-system,Arial,sans-serif">fast modular exponentiation</text>
+  <text x="380" y="214" text-anchor="middle" fill="#e9eef5" font-size="12" font-family="-apple-system,Arial,sans-serif">(the RSA speedup)</text>
+  <text x="380" y="244" text-anchor="middle" fill="#e9eef5" font-size="12" font-family="-apple-system,Arial,sans-serif">batching many small checks</text>
+  <text x="380" y="262" text-anchor="middle" fill="#e9eef5" font-size="12" font-family="-apple-system,Arial,sans-serif">into one combined answer</text>
+
+  <!-- euler -->
+  <rect x="510" y="56" width="220" height="260" rx="12" fill="#121c2c" stroke="#8fdcff" stroke-width="1.8" />
+  <text x="620" y="84" text-anchor="middle" fill="#8fdcff" font-size="14.5" font-weight="800" font-family="-apple-system,Arial,sans-serif">EULER</text>
+  <text x="620" y="108" text-anchor="middle" fill="#c3cedd" font-size="12" font-family="SF Mono, Fira Code, Consolas, monospace">a<tspan dy="-6" font-size="70%">&#981;(n)</tspan><tspan dy="6"> &#8801; 1 (mod n)</tspan></text>
+  <text x="620" y="126" text-anchor="middle" fill="#c3cedd" font-size="12" font-family="-apple-system,Arial,sans-serif">whenever gcd(a, n) = 1</text>
+  <line x1="530" y1="146" x2="710" y2="146" stroke="#223049" stroke-width="1" />
+  <text x="620" y="166" text-anchor="middle" fill="#8b96a8" font-size="11" font-style="italic" font-family="-apple-system,Arial,sans-serif">generalizes</text>
+  <text x="620" y="196" text-anchor="middle" fill="#e9eef5" font-size="12" font-family="-apple-system,Arial,sans-serif">Fermat's little theorem, its</text>
+  <text x="620" y="214" text-anchor="middle" fill="#e9eef5" font-size="12" font-family="-apple-system,Arial,sans-serif">prime special case (Topic 5)</text>
+  <text x="620" y="244" text-anchor="middle" fill="#e9eef5" font-size="12" font-family="-apple-system,Arial,sans-serif">to any modulus, prime or</text>
+  <text x="620" y="262" text-anchor="middle" fill="#e9eef5" font-size="12" font-family="-apple-system,Arial,sans-serif">composite</text>
+
+  <line x1="30" y1="346" x2="730" y2="346" stroke="#223049" stroke-width="1" />
+  <text x="380" y="370" text-anchor="middle" fill="#8fdcff" font-size="15.5" font-weight="800" font-family="-apple-system,Arial,sans-serif">FASTER INVERSES, BIGGER NUMBERS, ONE BIG IDEA</text>
+  <text x="380" y="392" text-anchor="middle" fill="#8b96a8" font-size="12.5" font-family="-apple-system,Arial,sans-serif">Next up: subgroups, cosets, and roots of unity.</text>
+</svg>
diff --git a/src/components/figures/CRTFormulaFigure.astro b/src/components/figures/CRTFormulaFigure.astro
new file mode 100644
index 0000000..ddb34f9
--- /dev/null
+++ b/src/components/figures/CRTFormulaFigure.astro
@@ -0,0 +1,38 @@
+---
+// Fig. for "Euclid, CRT & Euler": the CRT formula, built from the same two
+// congruences as the search figure — each term is scaled so it keeps its
+// own remainder and vanishes under the other modulus (the inverses doing
+// the work come from the earlier Euclid lesson).
+---
+<svg viewBox="0 0 760 446" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;display:block;">
+  <text x="380" y="26" text-anchor="middle" fill="#e9eef5" font-size="16" font-weight="800" font-family="-apple-system,Arial,sans-serif">building x without searching</text>
+  <text x="380" y="50" text-anchor="middle" fill="#8b96a8" font-size="12.5" font-family="SF Mono, Fira Code, Consolas, monospace">m<tspan dy="4" font-size="70%">1</tspan><tspan dy="-4">=3, a</tspan><tspan dy="4" font-size="70%">1</tspan><tspan dy="-4">=2    m</tspan><tspan dy="4" font-size="70%">2</tspan><tspan dy="-4">=5, a</tspan><tspan dy="4" font-size="70%">2</tspan><tspan dy="-4">=3    M=15</tspan></text>
+
+  <text x="40" y="84" fill="#8b96a8" font-size="12" font-weight="700" font-family="-apple-system,Arial,sans-serif">STEP 1 &#8212; find each M</text>
+  <text x="200" y="112" text-anchor="middle" fill="#8fdcff" font-size="16" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">M<tspan dy="5" font-size="65%">1</tspan><tspan dy="-5"> = 15 &#247; 3 = 5</tspan></text>
+  <text x="560" y="112" text-anchor="middle" fill="#5ddc8a" font-size="16" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">M<tspan dy="5" font-size="65%">2</tspan><tspan dy="-5"> = 15 &#247; 5 = 3</tspan></text>
+
+  <line x1="40" y1="130" x2="720" y2="130" stroke="#1a2436" stroke-width="1" />
+
+  <text x="40" y="158" fill="#8b96a8" font-size="12" font-weight="700" font-family="-apple-system,Arial,sans-serif">STEP 2 &#8212; invert each M mod its own modulus</text>
+  <text x="200" y="186" text-anchor="middle" fill="#8fdcff" font-size="16" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">5<tspan dy="-7" font-size="65%">-1</tspan><tspan dy="7"> mod 3 = 2</tspan></text>
+  <text x="560" y="186" text-anchor="middle" fill="#5ddc8a" font-size="16" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">3<tspan dy="-7" font-size="65%">-1</tspan><tspan dy="7"> mod 5 = 2</tspan></text>
+
+  <line x1="40" y1="204" x2="720" y2="204" stroke="#1a2436" stroke-width="1" />
+
+  <text x="40" y="232" fill="#8b96a8" font-size="12" font-weight="700" font-family="-apple-system,Arial,sans-serif">STEP 3 &#8212; combine both terms</text>
+  <text x="40" y="256" fill="#e9eef5" font-size="17" font-weight="800" font-family="SF Mono, Fira Code, Consolas, monospace">x = <tspan fill="#8fdcff">2 &#215; 5 &#215; 2</tspan> + <tspan fill="#5ddc8a">3 &#215; 3 &#215; 2</tspan></text>
+  <text x="720" y="256" text-anchor="end" fill="#e9eef5" font-size="17" font-weight="800" font-family="SF Mono, Fira Code, Consolas, monospace">= <tspan fill="#8fdcff">20</tspan> + <tspan fill="#5ddc8a">18</tspan> = 38</text>
+
+  <line x1="40" y1="274" x2="720" y2="274" stroke="#1a2436" stroke-width="1" />
+
+  <text x="40" y="302" fill="#8b96a8" font-size="12" font-weight="700" font-family="-apple-system,Arial,sans-serif">STEP 4 &#8212; reduce mod M</text>
+  <text x="720" y="302" text-anchor="end" fill="#e9eef5" font-size="17" font-weight="800" font-family="SF Mono, Fira Code, Consolas, monospace">38 mod 15 = 8</text>
+
+  <rect x="220" y="322" width="320" height="48" rx="10" fill="#0d1a12" stroke="#5ddc8a" stroke-width="2" />
+  <text x="380" y="352" text-anchor="middle" fill="#5ddc8a" font-size="15.5" font-weight="800" font-family="SF Mono, Fira Code, Consolas, monospace">same answer: x &#8801; 8 (mod 15)</text>
+
+  <line x1="40" y1="390" x2="720" y2="390" stroke="#223049" stroke-width="1" />
+  <text x="380" y="414" text-anchor="middle" fill="#8fdcff" font-size="15.5" font-weight="800" font-family="-apple-system,Arial,sans-serif">EACH TERM KEEPS ITS OWN REMAINDER, ZEROES THE OTHER</text>
+  <text x="380" y="434" text-anchor="middle" fill="#8b96a8" font-size="12.5" font-family="-apple-system,Arial,sans-serif">The inverses from the last lesson do the work.</text>
+</svg>
diff --git a/src/components/figures/CRTSearchFigure.astro b/src/components/figures/CRTSearchFigure.astro
new file mode 100644
index 0000000..393dee1
--- /dev/null
+++ b/src/components/figures/CRTSearchFigure.astro
@@ -0,0 +1,56 @@
+---
+// Fig. for "Euclid, CRT & Euler": solving two congruences by search — list
+// candidates satisfying the mod-5 clue, check each against the mod-3 clue,
+// and notice the matches repeat every 15 (3 × 5), the period of the
+// combined answer.
+const candidates = [3, 8, 13, 18, 23];
+const mod3 = [0, 2, 1, 0, 2];
+const cols = [100, 240, 380, 520, 660];
+---
+<svg viewBox="0 0 760 440" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;display:block;">
+  <text x="380" y="26" text-anchor="middle" fill="#e9eef5" font-size="16" font-weight="800" font-family="-apple-system,Arial,sans-serif">two clues about one number</text>
+  <text x="380" y="50" text-anchor="middle" fill="#8b96a8" font-size="13" font-family="SF Mono, Fira Code, Consolas, monospace">x &#8801; <tspan fill="#8fdcff">2 (mod 3)</tspan>  and  x &#8801; <tspan fill="#5ddc8a">3 (mod 5)</tspan></text>
+
+  <text x="40" y="84" fill="#8b96a8" font-size="12" font-weight="700" font-family="-apple-system,Arial,sans-serif">STEP 1 &#8212; list numbers that satisfy the mod-5 clue</text>
+  {cols.map((cx, i) => (
+    <text x={cx} y="110" text-anchor="middle" fill="#5ddc8a" font-size="17" font-weight="800" font-family="SF Mono, Fira Code, Consolas, monospace">{candidates[i]}</text>
+  ))}
+
+  <text x="40" y="150" fill="#8b96a8" font-size="12" font-weight="700" font-family="-apple-system,Arial,sans-serif">STEP 2 &#8212; check each against the mod-3 clue</text>
+  {cols.map((cx, i) => {
+    const isMatch = mod3[i] === 2;
+    const color = isMatch ? "#5ddc8a" : "#8b96a8";
+    return (
+      <>
+        <text x={cx} y="176" text-anchor="middle" fill={color} font-size="13" font-family="SF Mono, Fira Code, Consolas, monospace">&#8801;{mod3[i]} (mod 3)</text>
+        {isMatch && <text x={cx} y="196" text-anchor="middle" fill="#5ddc8a" font-size="12" font-weight="700" font-family="-apple-system,Arial,sans-serif">&#10003; matches</text>}
+      </>
+    );
+  })}
+
+  <line x1="40" y1="214" x2="720" y2="214" stroke="#1a2436" stroke-width="1" />
+
+  <text x="40" y="242" fill="#8b96a8" font-size="12" font-weight="700" font-family="-apple-system,Arial,sans-serif">STEP 3 &#8212; the matches repeat every 15 (3 &#215; 5)</text>
+  <text x="140" y="276" text-anchor="middle" fill="#5ddc8a" font-size="19" font-weight="800" font-family="SF Mono, Fira Code, Consolas, monospace">8</text>
+  <path d="M 170 272 L 300 272" fill="none" stroke="#8fdcff" stroke-width="1.4" marker-end="url(#crt-arrow)" />
+  <text x="235" y="262" text-anchor="middle" fill="#8fdcff" font-size="11.5" font-family="-apple-system,Arial,sans-serif">+15</text>
+  <text x="330" y="276" text-anchor="middle" fill="#5ddc8a" font-size="19" font-weight="800" font-family="SF Mono, Fira Code, Consolas, monospace">23</text>
+  <path d="M 360 272 L 490 272" fill="none" stroke="#8fdcff" stroke-width="1.4" marker-end="url(#crt-arrow)" />
+  <text x="425" y="262" text-anchor="middle" fill="#8fdcff" font-size="11.5" font-family="-apple-system,Arial,sans-serif">+15</text>
+  <text x="520" y="276" text-anchor="middle" fill="#5ddc8a" font-size="19" font-weight="800" font-family="SF Mono, Fira Code, Consolas, monospace">38</text>
+
+  <rect x="260" y="296" width="240" height="50" rx="10" fill="#0d1a12" stroke="#5ddc8a" stroke-width="2" />
+  <text x="380" y="328" text-anchor="middle" fill="#5ddc8a" font-size="17" font-weight="800" font-family="SF Mono, Fira Code, Consolas, monospace">x &#8801; 8 (mod 15)</text>
+
+  <text x="380" y="370" text-anchor="middle" fill="#8b96a8" font-size="12.5" font-family="-apple-system,Arial,sans-serif">Check: 8 mod 3 = 2 and 8 mod 5 = 3 &#8212; both clues hold.</text>
+
+  <line x1="40" y1="388" x2="720" y2="388" stroke="#223049" stroke-width="1" />
+  <text x="380" y="412" text-anchor="middle" fill="#8fdcff" font-size="15.5" font-weight="800" font-family="-apple-system,Arial,sans-serif">ONE ANSWER MOD 15 FITS BOTH CLUES</text>
+  <text x="380" y="432" text-anchor="middle" fill="#8b96a8" font-size="12.5" font-family="-apple-system,Arial,sans-serif">The two moduli, 3 and 5, share no factor.</text>
+
+  <defs>
+    <marker id="crt-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
+      <path d="M0,0 L10,5 L0,10 z" fill="#8fdcff" />
+    </marker>
+  </defs>
+</svg>
diff --git a/src/components/figures/EulerTheoremFigure.astro b/src/components/figures/EulerTheoremFigure.astro
new file mode 100644
index 0000000..62ec658
--- /dev/null
+++ b/src/components/figures/EulerTheoremFigure.astro
@@ -0,0 +1,34 @@
+---
+// Fig. for "Euclid, CRT & Euler": Euler's theorem, worked through n=9,
+// a=2 — raising a to φ(n) lands on 1 mod n, and splitting the exponent by
+// one gives the inverse directly, the same trick as Fermat's little
+// theorem (its special case when n is prime).
+---
+<svg viewBox="0 0 760 464" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;display:block;">
+  <text x="380" y="26" text-anchor="middle" fill="#e9eef5" font-size="16" font-weight="800" font-family="-apple-system,Arial,sans-serif">Euler's theorem</text>
+  <text x="380" y="50" text-anchor="middle" fill="#8b96a8" font-size="12" font-style="italic" font-family="-apple-system,Arial,sans-serif">raise a to &#981;(n) and the result always lands on 1</text>
+
+  <rect x="40" y="62" width="680" height="46" rx="10" fill="#111c2e" stroke="#223049" stroke-width="1" />
+  <text x="380" y="91" text-anchor="middle" fill="#e9eef5" font-size="16" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">a<tspan dy="-7" font-size="65%">&#981;(n)</tspan><tspan dy="7"> &#8801; 1 (mod n)   when gcd(a, n) = 1</tspan></text>
+
+  <text x="40" y="136" fill="#8b96a8" font-size="12" font-weight="700" font-family="-apple-system,Arial,sans-serif">STEP 1 &#8212; n=9, a=2, &#981;(9)=6 &#8212; compute a to the &#981;(n)</text>
+  <text x="720" y="136" text-anchor="end" fill="#e9eef5" font-size="17" font-weight="800" font-family="SF Mono, Fira Code, Consolas, monospace">2<tspan dy="-7" font-size="65%">6</tspan><tspan dy="7"> = 64</tspan></text>
+
+  <text x="40" y="178" fill="#8b96a8" font-size="12" font-weight="700" font-family="-apple-system,Arial,sans-serif">STEP 2 &#8212; reduce mod 9</text>
+  <text x="720" y="178" text-anchor="end" fill="#5ddc8a" font-size="16.5" font-weight="800" font-family="SF Mono, Fira Code, Consolas, monospace">64 = 7&#215;9 + 1  &#8594;  2<tspan dy="-6" font-size="65%">6</tspan><tspan dy="6"> &#8801; 1</tspan></text>
+
+  <text x="40" y="220" fill="#8b96a8" font-size="12" font-weight="700" font-family="-apple-system,Arial,sans-serif">STEP 3 &#8212; split one factor off to get the inverse</text>
+  <text x="720" y="220" text-anchor="end" fill="#e9eef5" font-size="16.5" font-weight="800" font-family="SF Mono, Fira Code, Consolas, monospace">2 &#215; 2<tspan dy="-6" font-size="65%">5</tspan><tspan dy="6"> &#8801; 1  &#8594;  2</tspan><tspan dy="-6" font-size="65%">-1</tspan><tspan dy="6"> &#8801; 32 &#8801; </tspan><tspan fill="#5ddc8a">5</tspan></text>
+
+  <text x="380" y="256" text-anchor="middle" fill="#8b96a8" font-size="12.5" font-family="-apple-system,Arial,sans-serif">Check: 2 &#215; 5 = 10 &#8801; 1 (mod 9).</text>
+
+  <line x1="40" y1="274" x2="720" y2="274" stroke="#223049" stroke-width="1" />
+
+  <rect x="40" y="292" width="680" height="54" rx="10" fill="#111c2e" stroke="#3ab7ff" stroke-width="1.5" />
+  <text x="380" y="315" text-anchor="middle" fill="#8fdcff" font-size="14.5" font-weight="700" font-family="-apple-system,Arial,sans-serif">When n is a prime p, &#981;(p) = p &#8722; 1</text>
+  <text x="380" y="335" text-anchor="middle" fill="#8fdcff" font-size="14.5" font-weight="700" font-family="-apple-system,Arial,sans-serif">&#8212; this is exactly Fermat's little theorem.</text>
+
+  <line x1="40" y1="364" x2="720" y2="364" stroke="#223049" stroke-width="1" />
+  <text x="380" y="388" text-anchor="middle" fill="#8fdcff" font-size="15.5" font-weight="800" font-family="-apple-system,Arial,sans-serif">FERMAT IS EULER'S THEOREM FOR A PRIME</text>
+  <text x="380" y="408" text-anchor="middle" fill="#8b96a8" font-size="12.5" font-family="-apple-system,Arial,sans-serif">Euler works for any modulus, as long as the gcd is 1.</text>
+</svg>
diff --git a/src/components/figures/EulerTotientFigure.astro b/src/components/figures/EulerTotientFigure.astro
new file mode 100644
index 0000000..3e8279f
--- /dev/null
+++ b/src/components/figures/EulerTotientFigure.astro
@@ -0,0 +1,51 @@
+---
+// Fig. for "Euclid, CRT & Euler": Euler's totient function φ(n), shown by
+// marking which numbers from 1 to n share no factor with n (green) versus
+// which do (red, crossed out) — across three example moduli, then the two
+// shortcut formulas for a prime and for a product of two distinct primes.
+interface Row {
+  n: number;
+  coprime: number[]; // numbers from 1..n with gcd(x, n) = 1
+}
+const rows: Row[] = [
+  { n: 9, coprime: [1, 2, 4, 5, 7, 8] },
+  { n: 12, coprime: [1, 5, 7, 11] },
+  { n: 15, coprime: [1, 2, 4, 7, 8, 11, 13, 14] },
+];
+function strip(n: number, coprime: number[]) {
+  const nums = Array.from({ length: n }, (_, i) => i + 1);
+  const spacing = 640 / (n - 1);
+  return nums.map((x, i) => ({ x, cx: 40 + i * spacing, isCoprime: coprime.includes(x) }));
+}
+const strips = rows.map((r) => strip(r.n, r.coprime));
+---
+<svg viewBox="0 0 760 446" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;display:block;">
+  <text x="380" y="26" text-anchor="middle" fill="#e9eef5" font-size="16" font-weight="800" font-family="-apple-system,Arial,sans-serif">&#981;(n) counts the numbers coprime to n</text>
+  <text x="380" y="50" text-anchor="middle" fill="#8b96a8" font-size="12" font-style="italic" font-family="-apple-system,Arial,sans-serif">numbers from 1 to n that share no factor with n</text>
+
