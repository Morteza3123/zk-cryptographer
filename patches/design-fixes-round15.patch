+// Fig. for "Polynomial Arithmetic": dividing (x² - 5x + 6) by (x - 2) —
+// polynomial long division, one leading term at a time, the same
+// polynomial whose roots were checked by hand in the previous lesson.
+const steps = [
+  { label: "step 1 — divide leading terms", eq: "x² ÷ x = x" },
+  { label: "step 2 — multiply back", eq: "x(x−2) = x² − 2x" },
+  { label: "step 3 — subtract", eq: "(x²−5x+6) − (x²−2x) = −3x+6" },
+  { label: "step 4 — repeat: −3x ÷ x = −3", eq: "−3(x−2) = −3x+6" },
+];
+---
+<svg viewBox="0 0 680 320" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;display:block;">
+  <text x="340" y="26" text-anchor="middle" fill="#8fdcff" font-size="14" font-weight="700" font-family="-apple-system,Arial,sans-serif">dividing polynomials</text>
+  <text x="340" y="48" text-anchor="middle" fill="#e9eef5" font-size="16" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">(x² − 5x + 6) ÷ (x − 2)</text>
+  <line x1="20" y1="60" x2="660" y2="60" stroke="#223049" stroke-width="1" />
+
+  {steps.map((s, i) => {
+    const y = 66 + i * 40;
+    return (
+      <>
+        <text x="40" y={y + 22} text-anchor="start" fill="#8b96a8" font-size="13" font-family="-apple-system,Arial,sans-serif">{s.label}</text>
+        <text x="640" y={y + 22} text-anchor="end" fill="#e9eef5" font-size="14.5" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">{s.eq}</text>
+        <line x1="20" y1={y + 32} x2="660" y2={y + 32} stroke="#1a2436" stroke-width="1" />
+      </>
+    );
+  })}
+
+  <text x="40" y="248" text-anchor="start" fill="#8b96a8" font-size="13" font-family="-apple-system,Arial,sans-serif">step 5 — subtract again</text>
+  <text x="640" y="248" text-anchor="end" fill="#5ddc8a" font-size="16" font-weight="800" font-family="SF Mono, Fira Code, Consolas, monospace">(−3x+6) − (−3x+6) = 0</text>
+
+  <rect x="20" y="272" width="640" height="40" rx="8" fill="#0d1f17" stroke="#5ddc8a" stroke-width="1.5" />
+  <text x="340" y="298" text-anchor="middle" fill="#5ddc8a" font-size="15" font-weight="800" font-family="-apple-system,Arial,sans-serif">quotient is x − 3, remainder is 0</text>
+</svg>
