+// Fig. for "ZK Math — Introduction": the integers mod n under addition,
+// as a cyclic group — n points evenly spaced on a circle, connected in
+// sequence to show the "wrap around and keep going" structure that groups
+// formalize.
+interface Props {
+  n?: number;
+}
+const { n = 5 } = Astro.props;
+
+const cx = 240;
+const cy = 130;
+const r = 96;
+
+const points = Array.from({ length: n }, (_, i) => {
+  const angle = (i / n) * 2 * Math.PI - Math.PI / 2;
+  return { i, x: cx + Math.cos(angle) * r, y: cy + Math.sin(angle) * r };
+});
+
+// A short arc from point 0 to point 1 (with an arrowhead) hints the
+// direction of travel around the otherwise-plain dashed ring.
+const arcStart = points[0];
+const arcEnd = points[1];
+---
+<svg viewBox="0 0 480 260" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;display:block;">
+  <circle cx={cx} cy={cy} r={r} fill="none" stroke="#3ab7ff" stroke-width="2" stroke-dasharray="3 6" opacity="0.7" />
+  <path
+    d={`M ${arcStart.x.toFixed(1)} ${arcStart.y.toFixed(1)} A ${r} ${r} 0 0 1 ${arcEnd.x.toFixed(1)} ${arcEnd.y.toFixed(1)}`}
+    fill="none"
+    stroke="#8fdcff"
+    stroke-width="2.5"
+    marker-end="url(#cyclic-arrow)"
+  />
+
+  {points.map(({ i, x, y }) => (
+    <>
+      <circle cx={x} cy={y} r="17" fill="url(#bodyGrad)" stroke="#3ab7ff" stroke-width="2" />
+      <text x={x} y={y + 5} text-anchor="middle" fill="#051625" font-size="13" font-weight="800" font-family="-apple-system,Arial,sans-serif">{i}</text>
+    </>
+  ))}
+
+  <defs>
+    <marker id="cyclic-arrow" viewBox="0 0 10 10" refX="5" refY="5" markerWidth="6" markerHeight="6" orient="auto">
+      <path d="M0,0 L10,5 L0,10 z" fill="#3ab7ff" />
+    </marker>
+  </defs>
+</svg>
diff --git a/src/components/figures/EllipticCurveFigure.astro b/src/components/figures/EllipticCurveFigure.astro
new file mode 100644
index 0000000..2c527ba
--- /dev/null
+++ b/src/components/figures/EllipticCurveFigure.astro
@@ -0,0 +1,47 @@
+---
+// Fig. for "ZK Math — Introduction": y² = x³ + 7 — secp256k1, the curve
+// behind Bitcoin and Ethereum keys. Points are sampled at build time and
+// mapped from curve-space into the SVG viewBox.
+const A = 0;
+const B = 7;
+const xMin = -1.91; // just above the real root of x^3 + 7 = 0
+const xMax = 3.1;
+
+const W = 480;
+const H = 300;
+const padding = 36;
+
+const yAtX = (x: number) => Math.sqrt(Math.max(x * x * x + A * x + B, 0));
+const yMax = yAtX(xMax) * 1.05;
+
+const toScreenX = (x: number) => padding + ((x - xMin) / (xMax - xMin)) * (W - 2 * padding);
+const toScreenY = (y: number) => H / 2 - (y / yMax) * (H / 2 - padding);
+
+const N = 48;
+const upper: string[] = [];
+const lower: string[] = [];
+for (let i = 0; i <= N; i++) {
+  const x = xMin + (i / N) * (xMax - xMin);
+  const y = yAtX(x);
+  upper.push(`${toScreenX(x).toFixed(1)},${toScreenY(y).toFixed(1)}`);
+  lower.push(`${toScreenX(x).toFixed(1)},${toScreenY(-y).toFixed(1)}`);
+}
+
+// A sample point on the curve to call out, e.g. x = 2 -> y = sqrt(15)
+const sampleX = 2;
+const sampleY = yAtX(sampleX);
+const sx = toScreenX(sampleX);
+const sy = toScreenY(sampleY);
+---
+<svg viewBox={`0 0 ${W} ${H}`} xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;display:block;">
+  <line x1={padding} y1={H / 2} x2={W - padding} y2={H / 2} stroke="#223049" stroke-width="1.5" />
+  <line x1={toScreenX(0)} y1={padding - 10} x2={toScreenX(0)} y2={H - padding + 10} stroke="#223049" stroke-width="1.5" />
+
+  <polyline points={upper.join(" ")} fill="none" stroke="#3ab7ff" stroke-width="2.5" stroke-linecap="round" />
+  <polyline points={lower.join(" ")} fill="none" stroke="#3ab7ff" stroke-width="2.5" stroke-linecap="round" />
+
+  <circle cx={sx} cy={sy} r="4.5" fill="#8fdcff" />
+  <text x={sx + 10} y={sy - 8} fill="#e9eef5" font-size="12" font-weight="700" font-family="-apple-system,Arial,sans-serif">(2, √15)</text>
+
+  <text x={W / 2} y="26" text-anchor="middle" fill="#e9eef5" font-size="16" font-weight="800" font-family="-apple-system,Arial,sans-serif">y² = x³ + 7</text>
+</svg>
