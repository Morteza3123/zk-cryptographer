+---
+// Fig. for "Lagrange Interpolation": checking the combined polynomial at
+// each of the three x-values — only one basis polynomial ever turns on
+// at a time, and it always hands back exactly that point's y-value.
+interface Row {
+  label: string;
+  note: string;
+  result: string;
+}
+const rows: Row[] = [
+  { label: "check x = 0", note: "only L₀ turns on", result: "= 1 ✓" },
+  { label: "check x = 1", note: "only L₁ turns on", result: "= 2 ✓" },
+  { label: "check x = 2", note: "only L₂ turns on", result: "= 5 ✓" },
+];
+const rowH = 50;
+const topPad = 44;
+const tableH = rows.length * rowH;
+const footerH = 48;
+const height = topPad + tableH + footerH + 10;
+---
+<svg viewBox={`0 0 680 ${height}`} xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;display:block;">
+  <text x="340" y="26" text-anchor="middle" fill="#8fdcff" font-size="14" font-weight="700" font-family="-apple-system,Arial,sans-serif">P(x) = 1·L₀ + 2·L₁ + 5·L₂ — checked at each point</text>
+  <line x1="20" y1="40" x2="660" y2="40" stroke="#223049" stroke-width="1" />
+
+  {rows.map((row, i) => {
+    const y = topPad + i * rowH;
+    return (
+      <>
+        <text x="40" y={y + 16} text-anchor="start" fill="#c3cedd" font-size="14.5" font-weight="700" font-family="-apple-system,Arial,sans-serif">{row.label}</text>
+        <text x="400" y={y + 16} text-anchor="middle" fill="#8b96a8" font-size="13.5" font-family="-apple-system,Arial,sans-serif">{row.note}</text>
+        <text x="640" y={y + 16} text-anchor="end" fill="#5ddc8a" font-size="15" font-weight="800" font-family="-apple-system,Arial,sans-serif">{row.result}</text>
+        {i < rows.length - 1 && (
+          <line x1="20" y1={y + rowH - 12} x2="660" y2={y + rowH - 12} stroke="#1a2436" stroke-width="1" />
+        )}
+      </>
+    );
+  })}
+
+  <rect x="20" y={topPad + tableH + 10} width="640" height={footerH - 14} rx="8" fill="#121c2c" stroke="#223049" stroke-width="1.5" />
+  <text x="340" y={topPad + tableH + 10 + (footerH - 14) / 2 + 5} text-anchor="middle" fill="#8fdcff" font-size="13.5" font-weight="700" font-family="-apple-system,Arial,sans-serif">expanded out, this simplifies to P(x) = x² + 1</text>
+</svg>
diff --git a/src/components/figures/LagrangeCurveFigure.astro b/src/components/figures/LagrangeCurveFigure.astro
new file mode 100644
index 0000000..34bac53
--- /dev/null
+++ b/src/components/figures/LagrangeCurveFigure.astro
@@ -0,0 +1,53 @@
+---
+// Fig. for "Lagrange Interpolation": the problem this lesson solves —
+// given the three points (0,1), (1,2), (2,5), exactly one degree-2
+// polynomial passes through all of them. Points and curve are both
+// mapped from data-space into the SVG viewBox at build time.
+const points: [number, number][] = [
+  [0, 1],
+  [1, 2],
+  [2, 5],
+];
+const f = (x: number) => x * x + 1;
+
+const xMin = -0.6;
+const xMax = 2.6;
+const yMin = 0;
+const yMax = 8.2;
+
+const W = 480;
+const H = 280;
+const padL = 46;
+const padR = 20;
+const padT = 24;
+const padB = 36;
+
+const toScreenX = (x: number) => padL + ((x - xMin) / (xMax - xMin)) * (W - padL - padR);
+const toScreenY = (y: number) => H - padB - ((y - yMin) / (yMax - yMin)) * (H - padT - padB);
+
+const N = 40;
+const curve: string[] = [];
+for (let i = 0; i <= N; i++) {
+  const x = xMin + (i / N) * (xMax - xMin);
+  curve.push(`${toScreenX(x).toFixed(1)},${toScreenY(f(x)).toFixed(1)}`);
+}
+---
+<svg viewBox={`0 0 ${W} ${H}`} xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;display:block;">
+  <line x1={padL} y1={toScreenY(0)} x2={W - padR} y2={toScreenY(0)} stroke="#223049" stroke-width="1.5" />
+  <line x1={toScreenX(0)} y1={padT} x2={toScreenX(0)} y2={H - padB} stroke="#223049" stroke-width="1.5" />
+
+  <polyline points={curve.join(" ")} fill="none" stroke="#3ab7ff" stroke-width="2.5" stroke-linecap="round" />
+
+  {points.map(([x, y]) => {
+    const sx = toScreenX(x);
+    const sy = toScreenY(y);
+    return (
+      <>
+        <circle cx={sx} cy={sy} r="5" fill="#8fdcff" stroke="#0a0f19" stroke-width="2" />
+        <text x={sx + 10} y={sy - 10} fill="#e9eef5" font-size="13" font-weight="700" font-family="-apple-system,Arial,sans-serif">({x}, {y})</text>
+      </>
+    );
+  })}
+
+  <text x={W / 2} y="20" text-anchor="middle" fill="#8fdcff" font-size="13" font-weight="700" font-family="-apple-system,Arial,sans-serif">exactly one degree-2 polynomial fits all three points</text>
+</svg>
