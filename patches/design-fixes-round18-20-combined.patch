+// Fig. for "Groups & Cyclic Groups": the four group axioms — every one of
+// these has to hold for a set plus an operation to count as a group.
+interface Row {
+  label: string;
+  eq: string;
+}
+const rows: Row[] = [
+  { label: "Closure", eq: "combine two elements, stay in the set" },
+  { label: "Identity", eq: "one element that changes nothing" },
+  { label: "Inverses", eq: "every element has an undo" },
+  { label: "Associativity", eq: "grouping doesn't change the result" },
+];
+const rowH = 54;
+const topPad = 44;
+const tableH = rows.length * rowH;
+const height = topPad + tableH + 12;
+---
+<svg viewBox={`0 0 680 ${height}`} xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;display:block;">
+  <text x="340" y="26" text-anchor="middle" fill="#8fdcff" font-size="14" font-weight="700" font-family="-apple-system,Arial,sans-serif">the group axioms — all four must hold</text>
+  <line x1="20" y1="40" x2="660" y2="40" stroke="#223049" stroke-width="1" />
+
+  {rows.map((row, i) => {
+    const y = topPad + i * rowH;
+    return (
+      <>
+        <text x="40" y={y + 21} text-anchor="start" fill="#5ddc8a" font-size="16.5" font-weight="800" font-family="SF Mono, Fira Code, Consolas, monospace">{row.label}</text>
+        <text x="640" y={y + 21} text-anchor="end" fill="#e9eef5" font-size="15" font-weight="700" font-family="-apple-system,Arial,sans-serif">{row.eq}</text>
+        {i < rows.length - 1 && (
+          <line x1="20" y1={y + 38} x2="660" y2={y + 38} stroke="#1a2436" stroke-width="1" />
+        )}
+      </>
+    );
+  })}
+</svg>
