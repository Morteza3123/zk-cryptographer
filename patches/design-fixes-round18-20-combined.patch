+import MathBox from "../../components/MathBox.astro";
+import Figure from "../../components/Figure.astro";
+import SchwartzZippelCurveFigure from "../../components/figures/SchwartzZippelCurveFigure.astro";
+import SchwartzZippelLemmaFigure from "../../components/figures/SchwartzZippelLemmaFigure.astro";
