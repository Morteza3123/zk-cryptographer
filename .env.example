# Copy this file to .env for local development (and set the same values as
# Environment Variables in the Vercel project for production). Both the
# Google Sheets integration and the email integration are optional at
# runtime — if either is left unset, that one step is skipped and logged as
# a warning rather than failing the form submission. See docs/SETUP.md for
# how to obtain each of these.

# --- Google Sheets (lead storage) ---
# The service account's email address, from the downloaded JSON key file's
# "client_email" field.
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# The service account's private key, from the JSON key file's "private_key"
# field. Paste it as a single line with literal \n sequences in place of
# real line breaks (this is how the JSON file already stores it — just wrap
# the whole value in quotes).
GOOGLE_PRIVATE_KEY=

# The spreadsheet's ID — the long string in its URL between /d/ and /edit.
GOOGLE_SHEET_ID=

# --- Resend (email notifications) ---
RESEND_API_KEY=

# Where lead notifications are sent.
NOTIFICATION_EMAIL_TO=

# Who they're sent from. Must be a verified sender/domain in Resend — the
# resend.dev sandbox address below works before you verify your own domain,
# but only delivers to the Resend account's own owner address.
NOTIFICATION_EMAIL_FROM="ZK Cryptographer <onboarding@resend.dev>"
