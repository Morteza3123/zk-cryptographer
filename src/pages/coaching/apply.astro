---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ApplyFormBehavior from "../../components/ApplyFormBehavior.astro";
---
<BaseLayout
  title="Apply for Coaching"
  description="Apply for 1:1 ZK coaching — tell me about your background and goals, and I'll follow up by email within 2 business days."
>
  <div class="crumbrow">
    <a href="/coaching">Coaching</a> / <b>Apply</b>
  </div>

  <div class="apply-page">
    <div class="container">
      <div class="apply-head">
        <div class="apply-kicker">APPLY FOR COACHING</div>
        <h1 class="apply-h1">Tell me about your background and goals.</h1>
        <p class="apply-sub">This isn't a commitment — it's the start of a conversation. I read every application myself and follow up by email within 2 business days to schedule a free 30-minute intro call.</p>
      </div>

      <div class="apply-card" data-apply-card>
        <form data-apply-form data-action="/api/apply/coaching">
          <div class="form-error" data-form-error hidden></div>

          <div class="field-row">
            <div class="field">
              <label for="name">Full name <span class="req">*</span></label>
              <input id="name" name="name" type="text" placeholder="Ada Lovelace" required />
            </div>
            <div class="field">
              <label for="email">Email <span class="req">*</span></label>
              <input id="email" name="email" type="email" placeholder="you@example.com" required />
            </div>
          </div>

          <div class="field">
            <label for="contact">WhatsApp or Telegram <span class="opt">(optional)</span></label>
            <input id="contact" name="contact" type="text" placeholder="+1 555 123 4567 or @username" />
          </div>

          <div class="field">
            <label for="plan">Which plan are you interested in? <span class="req">*</span></label>
            <select id="plan" name="plan" required>
              <option value="">Choose one</option>
              <option>Single Session</option>
              <option>4-Week Sprint</option>
              <option>12-Week Mentorship</option>
              <option>Not sure yet</option>
            </select>
          </div>

          <div class="field">
            <label for="background">Current role &amp; background <span class="req">*</span></label>
            <input id="background" name="background" type="text" placeholder="e.g. backend engineer, 3 years, new to ZK" required />
          </div>

          <div class="field">
            <label for="goals">What are you trying to learn or build? <span class="req">*</span></label>
            <textarea id="goals" name="goals" placeholder="A bit of context on where you're starting from and what you want out of this." required></textarea>
          </div>

          <div class="field">
            <label for="timeline">Target timeline <span class="req">*</span></label>
            <select id="timeline" name="timeline" required>
              <option value="">Choose one</option>
              <option>ASAP</option>
              <option>Within a month</option>
              <option>Just exploring</option>
            </select>
          </div>

          <div class="field">
            <label for="portfolio">GitHub / portfolio link <span class="opt">(optional)</span></label>
            <input id="portfolio" name="portfolio" type="text" placeholder="https://github.com/..." />
          </div>

          <div class="field">
            <label for="source">How did you hear about ZK Cryptographer? <span class="opt">(optional)</span></label>
            <input id="source" name="source" type="text" placeholder="YouTube, blog, referral, ..." />
          </div>

          <div class="submit-row">
            <button class="btn submit-btn" type="submit" data-submit-btn>Submit application</button>
            <div class="form-note">No payment required to apply — pricing is discussed on the intro call.</div>
          </div>
        </form>

        <div class="apply-confirm" data-apply-confirm hidden>
          <div class="confirm-badge">&#10003;</div>
          <div class="confirm-title">Application received.</div>
          <p class="confirm-sub">Thanks — I'll review this and follow up by email within 2 business days to schedule your free intro call.</p>
        </div>
      </div>
    </div>
  </div>

  <ApplyFormBehavior />
</BaseLayout>
