---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import AboutHeroDiagram from "../components/AboutHeroDiagram.astro";
import PersonaCard from "../components/PersonaCard.astro";
import {
  aboutHero,
  aboutHeroChips,
  aboutStory,
  aboutFocus,
  aboutFinalCta,
} from "../content/site-data/about";
---
<BaseLayout
  title="About"
  description="Morteza — a blockchain engineer with 6+ years in ZK and blockchain engineering, focused on ZK identity and privacy. The background behind ZK Cryptographer's learning, coaching, and services."
  active="about"
>
  <Hero
    kicker={aboutHero.kicker}
    heading={aboutHero.heading}
    sub={aboutHero.sub}
    primaryCta={{ label: "Book a coaching call", href: "/coaching" }}
    secondaryCta={{ label: "See services", href: "/services" }}
    stats={aboutHero.stats}
  >
    <AboutHeroDiagram chips={aboutHeroChips} slot="diagram" />
  </Hero>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div class="section-kicker">{aboutStory.kicker}</div>
        <h2 class="section-title">{aboutStory.title}</h2>
      </div>
      <div class="prose-centered">
        {aboutStory.paragraphs.map((p) => <p>{p}</p>)}
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="section-head">
        <div class="section-kicker">{aboutFocus.kicker}</div>
        <h2 class="section-title">{aboutFocus.title}</h2>
      </div>
      <div class="persona-grid">
        {aboutFocus.items.map((i) => (
          <PersonaCard title={i.title} desc={i.desc} />
        ))}
      </div>
    </div>
  </section>

  <section class="cta-band">
    <div class="container">
      <div class="cta-band-kicker">{aboutFinalCta.kicker}</div>
      <h2 class="cta-band-title">{aboutFinalCta.heading}</h2>
      <p class="cta-band-sub">{aboutFinalCta.sub}</p>
      <a class="btn" href={aboutFinalCta.ctaHref}>{aboutFinalCta.ctaLabel}</a>
    </div>
  </section>
</BaseLayout>
