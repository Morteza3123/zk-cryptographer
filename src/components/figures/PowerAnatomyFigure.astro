---
// Fig. for "Exponents and Powers": the anatomy of a power — which part is
// the base, which part is the exponent, using 2³ as the example. The
// longer explanation lives in the external <Figure> caption, so this SVG
// only needs short labels, with enough margin that neither clips.
---
<svg viewBox="0 0 460 200" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;display:block;">
  <text x="190" y="110" text-anchor="middle" fill="#e9eef5" font-size="64" font-weight="800" font-family="-apple-system,Arial,sans-serif">2</text>
  <text x="228" y="68" text-anchor="middle" fill="#8fdcff" font-size="30" font-weight="800" font-family="-apple-system,Arial,sans-serif">3</text>

  <line x1="90" y1="150" x2="165" y2="118" stroke="#3ab7ff" stroke-width="1.6" marker-end="url(#powanatomy-arrow)" />
  <text x="90" y="168" text-anchor="middle" fill="#c3cedd" font-size="14" font-weight="700" font-family="-apple-system,Arial,sans-serif">base</text>

  <line x1="340" y1="50" x2="252" y2="58" stroke="#3ab7ff" stroke-width="1.6" marker-end="url(#powanatomy-arrow)" />
  <text x="345" y="54" text-anchor="start" fill="#c3cedd" font-size="14" font-weight="700" font-family="-apple-system,Arial,sans-serif">exponent</text>

  <text x="230" y="168" text-anchor="middle" fill="#8b96a8" font-size="14" font-family="-apple-system,Arial,sans-serif">2 × 2 × 2 = 8</text>

  <defs>
    <marker id="powanatomy-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
      <path d="M0,0 L10,5 L0,10 z" fill="#3ab7ff" />
    </marker>
  </defs>
</svg>
