---
// Fig. 2 in "What Zero-Knowledge Proofs Actually Prove": a real protocol
// transcript next to one fabricated by a simulator — indistinguishable.
const rows = ["c = 7f3a..", "e = 5", "z = 2c91.."];
---
<svg viewBox="0 0 560 190" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;display:block;">
  <text x="130" y="28" text-anchor="middle" fill="#8b96a8" font-size="11" font-weight="700" letter-spacing="0.06em" font-family="-apple-system,Arial,sans-serif">REAL TRANSCRIPT</text>
  <rect x="40" y="42" width="180" height="112" rx="8" fill="#121c2c" stroke="#223049" stroke-width="1.5" />
  {rows.map((r, i) => (
    <text x="130" y={74 + i * 28} text-anchor="middle" fill="#cdd9e8" font-size="13" font-family="SF Mono, Fira Code, Consolas, monospace">{r}</text>
  ))}

  <text x="280" y="105" text-anchor="middle" fill="#3ab7ff" font-size="20" font-weight="700">&#8776;</text>

  <text x="430" y="28" text-anchor="middle" fill="#8b96a8" font-size="11" font-weight="700" letter-spacing="0.06em" font-family="-apple-system,Arial,sans-serif">SIMULATED TRANSCRIPT</text>
  <rect x="340" y="42" width="180" height="112" rx="8" fill="#121c2c" stroke="#223049" stroke-width="1.5" />
  {rows.map((r, i) => (
    <text x="430" y={74 + i * 28} text-anchor="middle" fill="#cdd9e8" font-size="13" font-family="SF Mono, Fira Code, Consolas, monospace">{r}</text>
  ))}
</svg>
