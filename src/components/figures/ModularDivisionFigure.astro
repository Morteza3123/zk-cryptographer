---
// Fig. for "Modular Inverses & Fermat's Little Theorem": the same 6 ÷ 2,
// read three ways — plain division, the reciprocal rewrite that's
// identical to it, and that same rewrite attempted inside mod 7, where
// the reciprocal ½ simply isn't a number that exists.
interface Col {
  eq: string;
  note1: string;
  note2: string;
  verdict: string | null;
  ok: boolean;
}
const cols: Col[] = [
  { eq: "6 ÷ 2 = 3", note1: "normal division", note2: "", verdict: null, ok: true },
  { eq: "6 × ½ = 3", note1: "same thing — multiply by", note2: "the reciprocal", verdict: null, ok: true },
  { eq: "6 × ½ mod 7 ?", note1: "½ is not a whole number", note2: "", verdict: "✗ this doesn't exist here", ok: false },
];
const colW = 240;
---
<svg viewBox="0 0 720 200" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;display:block;">
  <line x1="240" y1="14" x2="240" y2="186" stroke="#223049" stroke-width="1" />
  <line x1="480" y1="14" x2="480" y2="186" stroke="#223049" stroke-width="1" />

  {cols.map((col, i) => {
    const cx = i * colW + colW / 2;
    return (
      <>
        <text x={cx} y="56" text-anchor="middle" fill="#e9eef5" font-size="21" font-weight="800" font-family="-apple-system,Arial,sans-serif">{col.eq}</text>
        <text x={cx} y="88" text-anchor="middle" fill="#8b96a8" font-size="13" font-family="-apple-system,Arial,sans-serif">{col.note1}</text>
        {col.note2 && (
          <text x={cx} y="108" text-anchor="middle" fill="#8b96a8" font-size="13" font-family="-apple-system,Arial,sans-serif">{col.note2}</text>
        )}
        {col.verdict && (
          <text x={cx} y="150" text-anchor="middle" fill="#ff8080" font-size="14.5" font-weight="800" font-family="-apple-system,Arial,sans-serif">{col.verdict}</text>
        )}
      </>
    );
  })}
</svg>
