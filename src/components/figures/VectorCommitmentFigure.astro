---
// Fig. for "Merkle Trees & Vector Commitments": the general idea (a vector
// commitment: one short value for a whole list, position-binding openings)
// and the two ways this series has now built one — Merkle tree vs. KZG.
---
<svg viewBox="0 0 760 460" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;display:block;">
  <text x="380" y="26" text-anchor="middle" fill="#e9eef5" font-size="16" font-weight="800" font-family="-apple-system,Arial,sans-serif">same promise, different trade-offs</text>

  <!-- left: the idea -->
  <text x="40" y="56" fill="#c3cedd" font-size="12.5" font-weight="700" font-family="-apple-system,Arial,sans-serif">THE IDEA</text>
  {["v1", "v2", "v3", "vn"].map((v, i) => (
    <rect x={40 + i * 75} y="68" width="60" height="42" rx="8"
      fill="#121c2c" stroke={v === "v3" ? "#3ab7ff" : "#c3cedd"} stroke-width={v === "v3" ? 2 : 1.4} />
  ))}
  <text x="70" y="95" text-anchor="middle" fill="#e9eef5" font-size="13" font-family="-apple-system,Arial,sans-serif">v1</text>
  <text x="145" y="95" text-anchor="middle" fill="#e9eef5" font-size="13" font-family="-apple-system,Arial,sans-serif">v2</text>
  <text x="220" y="95" text-anchor="middle" fill="#8fdcff" font-size="13" font-weight="700" font-family="-apple-system,Arial,sans-serif">v3</text>
  <text x="295" y="95" text-anchor="middle" fill="#e9eef5" font-size="13" font-family="-apple-system,Arial,sans-serif">vn</text>

  <line x1="190" y1="110" x2="190" y2="140" stroke="#c3cedd" stroke-width="1.4" />
  <line x1="70" y1="110" x2="190" y2="140" stroke="#c3cedd" stroke-width="1.4" />
  <line x1="310" y1="110" x2="190" y2="140" stroke="#c3cedd" stroke-width="1.4" />
  <line x1="190" y1="140" x2="280" y2="156" stroke="#e9eef5" stroke-width="1.6" marker-end="url(#vc-arrow-w)" />
  <rect x="285" y="138" width="60" height="42" rx="8" fill="#0d1526" stroke="#3ab7ff" stroke-width="2" />
  <text x="315" y="164" text-anchor="middle" fill="#8fdcff" font-size="17" font-weight="800" font-family="SF Mono, Fira Code, Consolas, monospace">C</text>

  <rect x="20" y="200" width="320" height="52" rx="9" fill="#121c2c" stroke="#c3cedd" stroke-width="1.4" />
  <text x="180" y="231" text-anchor="middle" fill="#e9eef5" font-size="13" font-weight="700" font-family="-apple-system,Arial,sans-serif">open position i (here i = 3)</text>
  <line x1="180" y1="252" x2="180" y2="276" stroke="#c3cedd" stroke-width="1.4" marker-end="url(#vc-arrow-w)" />
  <rect x="20" y="278" width="320" height="52" rx="9" fill="#0d1526" stroke="#8fdcff" stroke-width="1.6" />
  <text x="180" y="309" text-anchor="middle" fill="#8fdcff" font-size="13" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">v3 + proof &#960;</text>
  <line x1="180" y1="330" x2="180" y2="354" stroke="#c3cedd" stroke-width="1.4" marker-end="url(#vc-arrow-w)" />
  <rect x="20" y="356" width="320" height="52" rx="9" fill="#121c2c" stroke="#5ddc8a" stroke-width="1.8" />
  <text x="180" y="387" text-anchor="middle" fill="#5ddc8a" font-size="13.5" font-weight="700" font-family="-apple-system,Arial,sans-serif">&#10003; checks against C</text>
  <path d="M 345 382 C 400 382 400 159 346 159" fill="none" stroke="#3ab7ff" stroke-width="1.6" stroke-dasharray="4 4" marker-end="url(#vc-arrow-b)" />

  <!-- right: two ways to build one -->
  <line x1="400" y1="40" x2="400" y2="430" stroke="#223049" stroke-width="1" stroke-dasharray="3 5" />
  <text x="430" y="56" fill="#c3cedd" font-size="12.5" font-weight="700" font-family="-apple-system,Arial,sans-serif">TWO WAYS TO BUILD ONE</text>

  <rect x="430" y="76" width="290" height="110" rx="10" fill="#121c2c" stroke="#e9eef5" stroke-width="1.6" />
  <text x="575" y="108" text-anchor="middle" fill="#e9eef5" font-size="16" font-weight="800" font-family="-apple-system,Arial,sans-serif">MERKLE TREE</text>
  <text x="575" y="134" text-anchor="middle" fill="#c3cedd" font-size="12.5" font-family="-apple-system,Arial,sans-serif">proof = log n hashes</text>
  <text x="575" y="153" text-anchor="middle" fill="#c3cedd" font-size="12.5" font-family="-apple-system,Arial,sans-serif">no trusted setup</text>
  <text x="575" y="172" text-anchor="middle" fill="#c3cedd" font-size="12.5" font-family="-apple-system,Arial,sans-serif">needs only a hash function</text>

  <rect x="430" y="202" width="290" height="110" rx="10" fill="#121c2c" stroke="#3ab7ff" stroke-width="1.6" />
  <text x="575" y="234" text-anchor="middle" fill="#8fdcff" font-size="16" font-weight="800" font-family="-apple-system,Arial,sans-serif">KZG</text>
  <text x="575" y="260" text-anchor="middle" fill="#c3cedd" font-size="12.5" font-family="-apple-system,Arial,sans-serif">proof = ONE point</text>
  <text x="575" y="279" text-anchor="middle" fill="#c3cedd" font-size="12.5" font-family="-apple-system,Arial,sans-serif">needs a trusted setup</text>
  <text x="575" y="298" text-anchor="middle" fill="#c3cedd" font-size="12.5" font-family="-apple-system,Arial,sans-serif">needs pairings (Topic 13)</text>

  <rect x="430" y="332" width="84" height="56" rx="8" fill="#0d1526" stroke="#c3cedd" stroke-width="1.3" />
  <text x="472" y="364" text-anchor="middle" fill="#e9eef5" font-size="12.5" font-weight="700" font-family="-apple-system,Arial,sans-serif">Vector</text>
  <line x1="514" y1="360" x2="548" y2="360" stroke="#8fdcff" stroke-width="1.6" marker-end="url(#vc-arrow-b)" />
  <rect x="550" y="332" width="100" height="56" rx="8" fill="#0d1526" stroke="#8fdcff" stroke-width="1.3" />
  <text x="600" y="357" text-anchor="middle" fill="#8fdcff" font-size="11.5" font-weight="700" font-family="-apple-system,Arial,sans-serif">Polynomial</text>
  <text x="600" y="372" text-anchor="middle" fill="#8b96a8" font-size="10" font-family="-apple-system,Arial,sans-serif">(Lagrange)</text>
  <line x1="650" y1="360" x2="676" y2="360" stroke="#8fdcff" stroke-width="1.6" marker-end="url(#vc-arrow-b)" />
  <rect x="678" y="332" width="68" height="56" rx="8" fill="#0d1526" stroke="#8fdcff" stroke-width="1.3" />
  <text x="712" y="357" text-anchor="middle" fill="#8fdcff" font-size="11.5" font-weight="700" font-family="-apple-system,Arial,sans-serif">KZG</text>
  <text x="712" y="372" text-anchor="middle" fill="#8fdcff" font-size="11.5" font-weight="700" font-family="-apple-system,Arial,sans-serif">commit</text>
  <text x="600" y="405" text-anchor="middle" fill="#8b96a8" font-size="10.5" font-family="-apple-system,Arial,sans-serif">Topic 9</text>
  <text x="712" y="405" text-anchor="middle" fill="#8b96a8" font-size="10.5" font-family="-apple-system,Arial,sans-serif">Topic 15</text>

  <line x1="20" y1="420" x2="740" y2="420" stroke="#223049" stroke-width="1" />
  <text x="380" y="444" text-anchor="middle" fill="#3ab7ff" font-size="15" font-weight="800" font-family="-apple-system,Arial,sans-serif">A VECTOR COMMITMENT LOCKS IN A WHOLE LIST, ONE SHORT VALUE</text>

  <defs>
    <marker id="vc-arrow-w" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6.5" markerHeight="6.5" orient="auto-start-reverse">
      <path d="M0,0 L10,5 L0,10 z" fill="#c3cedd" />
    </marker>
    <marker id="vc-arrow-b" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6.5" markerHeight="6.5" orient="auto-start-reverse">
      <path d="M0,0 L10,5 L0,10 z" fill="#3ab7ff" />
    </marker>
  </defs>
</svg>
