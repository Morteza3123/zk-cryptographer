---
// Fig. for "Linear Algebra over Finite Fields": running A·v = (3,4) backwards
// — eliminate x, divide by 5 mod 7, back-substitute — recovers v = (5,6),
// the same vector Fig. 2 started from.
---
<svg viewBox="0 0 760 550" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;display:block;">
  <text x="380" y="26" text-anchor="middle" fill="#e9eef5" font-size="16" font-weight="800" font-family="-apple-system,Arial,sans-serif">solving a system</text>

  <rect x="40" y="46" width="680" height="42" rx="10" fill="#111c2e" stroke="#3ab7ff" stroke-width="1.5" />
  <text x="380" y="72" text-anchor="middle" fill="#8fdcff" font-size="13.5" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">Which vector v = (x, y) does A turn into (3, 4)?</text>

  <text x="380" y="112" text-anchor="middle" fill="#8b96a8" font-size="11.5" font-weight="700" font-family="-apple-system,Arial,sans-serif">SETUP</text>
  <text x="380" y="136" text-anchor="middle" fill="#e9eef5" font-size="14" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">x + 2y = 3</text>
  <text x="380" y="158" text-anchor="middle" fill="#e9eef5" font-size="14" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">3x + 4y = 4</text>

  <text x="380" y="192" text-anchor="middle" fill="#8b96a8" font-size="12" font-weight="700" font-family="-apple-system,Arial,sans-serif">STEP 1 &#8212; clear x from row 2</text>
  <text x="380" y="214" text-anchor="middle" fill="#e9eef5" font-size="12" font-family="SF Mono, Fira Code, Consolas, monospace">subtract 3 &#215; row 1 from row 2: (3x + 4y) &#8722; 3(x + 2y) = 4 &#8722; 3 &#215; 3</text>
  <text x="380" y="236" text-anchor="middle" fill="#e9eef5" font-size="13.5" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">&#8722;2y = &#8722;5</text>
  <text x="380" y="258" text-anchor="middle" fill="#e9eef5" font-size="13.5" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">&#8722;2 = 5 and &#8722;5 = 2, so 5y = 2</text>

  <text x="380" y="292" text-anchor="middle" fill="#8b96a8" font-size="12" font-weight="700" font-family="-apple-system,Arial,sans-serif">STEP 2 &#8212; divide</text>
  <text x="380" y="316" text-anchor="middle" fill="#e9eef5" font-size="13.5" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">5 &#215; 3 = 15 = 1, so 1 &#247; 5 = 3, and y = 2 &#215; 3 = 6</text>

  <text x="380" y="350" text-anchor="middle" fill="#8b96a8" font-size="12" font-weight="700" font-family="-apple-system,Arial,sans-serif">STEP 3 &#8212; back-substitute</text>
  <text x="380" y="374" text-anchor="middle" fill="#e9eef5" font-size="13.5" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">x = 3 &#8722; 2y = 3 &#8722; 12 = &#8722;9 = 5</text>

  <rect x="260" y="396" width="240" height="42" rx="10" fill="#0e1f16" stroke="#5ddc8a" stroke-width="1.8" />
  <text x="380" y="422" text-anchor="middle" fill="#5ddc8a" font-size="14.5" font-weight="800" font-family="SF Mono, Fira Code, Consolas, monospace">(x, y) = (5, 6)</text>

  <text x="380" y="464" text-anchor="middle" fill="#e9eef5" font-size="12.5" font-family="SF Mono, Fira Code, Consolas, monospace">1 &#215; 5 + 2 &#215; 6 = 17 = 3 &#10003; and 3 &#215; 5 + 4 &#215; 6 = 39 = 4 &#10003;</text>

  <line x1="40" y1="484" x2="720" y2="484" stroke="#223049" stroke-width="1" />
  <text x="380" y="508" text-anchor="middle" fill="#8fdcff" font-size="15.5" font-weight="800" font-family="-apple-system,Arial,sans-serif">ELIMINATE, DIVIDE, BACK-SUBSTITUTE</text>
  <text x="380" y="530" text-anchor="middle" fill="#8b96a8" font-size="12.5" font-family="-apple-system,Arial,sans-serif">Same steps as with real numbers, but division means multiplying by the inverse mod 7.</text>
</svg>
