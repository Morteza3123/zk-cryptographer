---
// Fig. for "Groups & Cyclic Groups": the group axioms aren't abstract —
// they're the exact additive structure built back in the modular
// arithmetic lesson (topic 4), checked here against GF(7)'s addition.
interface Row {
  label: string;
  eq: string;
  note: string;
}
const rows: Row[] = [
  { label: "Closure", eq: "3 + 5 ≡ 1 (mod 7)", note: "stays in the set" },
  { label: "Identity", eq: "3 + 0 = 3", note: "adding zero changes nothing" },
  { label: "Inverses", eq: "3 + 4 ≡ 0 (mod 7)", note: "4 undoes 3" },
];
const rowH = 54;
const topPad = 64;
const tableH = rows.length * rowH;
const footerH = 48;
const height = topPad + tableH + footerH + 10;
---
<svg viewBox={`0 0 680 ${height}`} xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;display:block;">
  <text x="340" y="24" text-anchor="middle" fill="#8fdcff" font-size="14" font-weight="700" font-family="-apple-system,Arial,sans-serif">checking three axioms against addition mod 7</text>
  <text x="340" y="44" text-anchor="middle" fill="#8b96a8" font-size="13" font-family="SF Mono, Fira Code, Consolas, monospace">{"{0, 1, 2, 3, 4, 5, 6}"} under addition mod 7</text>
  <line x1="20" y1="58" x2="660" y2="58" stroke="#223049" stroke-width="1" />

  {rows.map((row, i) => {
    const y = topPad + i * rowH;
    return (
      <>
        <text x="40" y={y + 21} text-anchor="start" fill="#5ddc8a" font-size="15.5" font-weight="800" font-family="SF Mono, Fira Code, Consolas, monospace">{row.label}</text>
        <text x="330" y={y + 21} text-anchor="middle" fill="#e9eef5" font-size="16" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">{row.eq}</text>
        <text x="640" y={y + 21} text-anchor="end" fill="#8b96a8" font-size="13.5" font-family="-apple-system,Arial,sans-serif">{row.note}</text>
        {i < rows.length - 1 && (
          <line x1="20" y1={y + 38} x2="660" y2={y + 38} stroke="#1a2436" stroke-width="1" />
        )}
      </>
    );
  })}

  <rect x="20" y={topPad + tableH + 10} width="640" height={footerH - 14} rx="8" fill="#121c2c" stroke="#223049" stroke-width="1.5" />
  <text x="340" y={topPad + tableH + 10 + (footerH - 14) / 2 + 5} text-anchor="middle" fill="#8fdcff" font-size="13.5" font-weight="700" font-family="-apple-system,Arial,sans-serif">this is exactly the additive structure from topic 4</text>
</svg>
