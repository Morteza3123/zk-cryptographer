---
// Fig. for "Merkle Trees & Vector Commitments": the Section 3 membership
// check moved inside a ZK circuit — private leaf secrets and Merkle path
// never leave the prover; only the root, nullifier N, and proof come out.
---
<svg viewBox="0 0 820 360" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;display:block;">
  <text x="410" y="26" text-anchor="middle" fill="#e9eef5" font-size="16" font-weight="800" font-family="-apple-system,Arial,sans-serif">member of the set, identity unknown</text>

  <text x="135" y="58" text-anchor="middle" fill="#c3cedd" font-size="12.5" font-weight="700" font-family="-apple-system,Arial,sans-serif">PRIVATE</text>
  <text x="410" y="58" text-anchor="middle" fill="#c3cedd" font-size="12.5" font-weight="700" font-family="-apple-system,Arial,sans-serif">ZK CIRCUIT</text>
  <text x="690" y="58" text-anchor="middle" fill="#c3cedd" font-size="12.5" font-weight="700" font-family="-apple-system,Arial,sans-serif">PUBLIC</text>

  <rect x="30" y="78" width="210" height="48" rx="9" fill="#121c2c" stroke="#5ddc8a" stroke-width="1.8" />
  <text x="135" y="107" text-anchor="middle" fill="#5ddc8a" font-size="13" font-weight="700" font-family="-apple-system,Arial,sans-serif">leaf secrets (nf, s)</text>

  <rect x="30" y="140" width="210" height="48" rx="9" fill="#121c2c" stroke="#5ddc8a" stroke-width="1.8" />
  <text x="135" y="169" text-anchor="middle" fill="#5ddc8a" font-size="13" font-weight="700" font-family="-apple-system,Arial,sans-serif">Merkle path (siblings)</text>

  <text x="135" y="216" text-anchor="middle" fill="#8b96a8" font-size="11" font-style="italic" font-family="-apple-system,Arial,sans-serif">never leaves the prover</text>

  <line x1="240" y1="102" x2="290" y2="140" stroke="#5ddc8a" stroke-width="1.6" />
  <line x1="240" y1="164" x2="290" y2="140" stroke="#5ddc8a" stroke-width="1.6" />
  <line x1="290" y1="140" x2="320" y2="140" stroke="#5ddc8a" stroke-width="1.6" marker-end="url(#mc-arrow-g)" />

  <rect x="320" y="76" width="260" height="140" rx="12" fill="#0a0f19" stroke="#e9eef5" stroke-width="1.8" />
  <text x="450" y="112" text-anchor="middle" fill="#e9eef5" font-size="13" font-family="-apple-system,Arial,sans-serif">1. rebuild the leaf</text>
  <text x="450" y="140" text-anchor="middle" fill="#e9eef5" font-size="13" font-family="-apple-system,Arial,sans-serif">2. hash up the path,</text>
  <text x="450" y="158" text-anchor="middle" fill="#e9eef5" font-size="13" font-family="-apple-system,Arial,sans-serif">must equal root</text>
  <text x="450" y="188" text-anchor="middle" fill="#e9eef5" font-size="13" font-family="-apple-system,Arial,sans-serif">3. compute N = H(nf)</text>

  <line x1="580" y1="146" x2="630" y2="146" stroke="#8fdcff" stroke-width="1.6" marker-end="url(#mc-arrow-b)" />

  <rect x="632" y="104" width="76" height="40" rx="8" fill="#0d1526" stroke="#c3cedd" stroke-width="1.6" />
  <text x="670" y="129" text-anchor="middle" fill="#e9eef5" font-size="13" font-weight="700" font-family="-apple-system,Arial,sans-serif">root</text>
  <rect x="632" y="150" width="76" height="40" rx="8" fill="#0d1526" stroke="#3ab7ff" stroke-width="1.8" />
  <text x="670" y="175" text-anchor="middle" fill="#8fdcff" font-size="13" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">N</text>
  <rect x="632" y="196" width="76" height="40" rx="8" fill="#0d1526" stroke="#c3cedd" stroke-width="1.6" />
  <text x="670" y="221" text-anchor="middle" fill="#e9eef5" font-size="13" font-weight="700" font-family="-apple-system,Arial,sans-serif">proof &#960;</text>
  <path d="M 632 124 L 612 146 L 632 170" fill="none" stroke="#223049" stroke-width="1.4" />
  <line x1="612" y1="146" x2="630" y2="146" stroke="#223049" stroke-width="1.4" />

  <rect x="240" y="252" width="340" height="40" rx="8" fill="#0d1a12" stroke="#223049" stroke-width="1" />
  <text x="410" y="277" text-anchor="middle" fill="#8b96a8" font-size="12" font-family="-apple-system,Arial,sans-serif">hashing inside a circuit is costly — ZK systems use circuit-friendly hashes, like Poseidon</text>

  <line x1="20" y1="306" x2="800" y2="306" stroke="#223049" stroke-width="1" />
  <text x="410" y="330" text-anchor="middle" fill="#8fdcff" font-size="15.5" font-weight="800" font-family="-apple-system,Arial,sans-serif">THE VERIFIER SEES ONLY THE ROOT, N, AND THE PROOF</text>
  <text x="410" y="348" text-anchor="middle" fill="#8b96a8" font-size="12.5" font-family="-apple-system,Arial,sans-serif">The core of anonymous membership: private voting, anonymous credentials, mixers.</text>

  <defs>
    <marker id="mc-arrow-g" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6.5" markerHeight="6.5" orient="auto-start-reverse">
      <path d="M0,0 L10,5 L0,10 z" fill="#5ddc8a" />
    </marker>
    <marker id="mc-arrow-b" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6.5" markerHeight="6.5" orient="auto-start-reverse">
      <path d="M0,0 L10,5 L0,10 z" fill="#8fdcff" />
    </marker>
  </defs>
</svg>
