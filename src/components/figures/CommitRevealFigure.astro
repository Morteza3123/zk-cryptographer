---
// Fig. for "Commitment Schemes": the core commit-then-reveal shape — the
// commit phase locks in a secret m behind C without revealing it; the
// reveal phase, later, lets the receiver check that m and the opening
// key r actually produce that same C.
---
<svg viewBox="0 0 920 470" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;display:block;">
  <text x="460" y="30" text-anchor="middle" fill="#e9eef5" font-size="17" font-weight="800" font-family="-apple-system,Arial,sans-serif">lock it in now, open it later</text>

  <line x1="450" y1="48" x2="450" y2="400" stroke="#1a2436" stroke-width="1" stroke-dasharray="4 5" />

  <!-- LEFT: commit phase -->
  <text x="225" y="66" text-anchor="middle" fill="#c3cedd" font-size="13.5" font-weight="700" font-family="-apple-system,Arial,sans-serif">COMMIT PHASE</text>

  <rect x="40" y="82" width="190" height="52" rx="9" fill="#121c2c" stroke="#5ddc8a" stroke-width="1.6" />
  <text x="135" y="113" text-anchor="middle" fill="#e9eef5" font-size="14.5" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">m = 42 (secret)</text>

  <line x1="135" y1="134" x2="135" y2="164" stroke="#e9eef5" stroke-width="1.8" marker-end="url(#cr-arrow)" />

  <rect x="40" y="166" width="190" height="52" rx="9" fill="#0d1526" stroke="#e9eef5" stroke-width="1.8" />
  <text x="135" y="197" text-anchor="middle" fill="#e9eef5" font-size="15" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">Commit(m, r)</text>

  <line x1="135" y1="218" x2="135" y2="248" stroke="#8fdcff" stroke-width="2" marker-end="url(#cr-arrow-c)" />

  <rect x="95" y="250" width="80" height="52" rx="9" fill="#0a0f19" stroke="#8fdcff" stroke-width="2" />
  <text x="135" y="282" text-anchor="middle" fill="#8fdcff" font-size="20" font-weight="800" font-family="SF Mono, Fira Code, Consolas, monospace">C</text>

  <line x1="135" y1="302" x2="135" y2="332" stroke="#8fdcff" stroke-width="2" marker-end="url(#cr-arrow-c)" />

  <rect x="40" y="334" width="190" height="52" rx="9" fill="#0d1526" stroke="#e9eef5" stroke-width="1.8" />
  <text x="135" y="365" text-anchor="middle" fill="#e9eef5" font-size="15" font-weight="700" font-family="-apple-system,Arial,sans-serif">Receiver</text>

  <text x="135" y="398" text-anchor="middle" fill="#8b96a8" font-size="12.5" font-family="-apple-system,Arial,sans-serif">receiver sees C —</text>
  <text x="135" y="414" text-anchor="middle" fill="#8b96a8" font-size="12.5" font-family="-apple-system,Arial,sans-serif">learns nothing about m</text>

  <!-- RIGHT: reveal phase -->
  <text x="685" y="66" text-anchor="middle" fill="#c3cedd" font-size="13.5" font-weight="700" font-family="-apple-system,Arial,sans-serif">REVEAL PHASE</text>
  <text x="685" y="84" text-anchor="middle" fill="#8fdcff" font-size="11.5" font-style="italic" font-family="-apple-system,Arial,sans-serif">(later)</text>

  <rect x="480" y="110" width="160" height="52" rx="9" fill="#121c2c" stroke="#5ddc8a" stroke-width="1.6" />
  <text x="560" y="141" text-anchor="middle" fill="#e9eef5" font-size="15" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">m = 42</text>

  <rect x="480" y="196" width="220" height="52" rx="9" fill="#121c2c" stroke="#3ab7ff" stroke-width="1.6" />
  <text x="590" y="227" text-anchor="middle" fill="#e9eef5" font-size="14.5" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">r (opening key)</text>

  <line x1="640" y1="146" x2="748" y2="178" stroke="#5ddc8a" stroke-width="1.8" marker-end="url(#cr-arrow-g)" />
  <line x1="700" y1="212" x2="750" y2="184" stroke="#3ab7ff" stroke-width="1.8" marker-end="url(#cr-arrow-b)" />

  <rect x="752" y="156" width="74" height="52" rx="9" fill="#0d1526" stroke="#e9eef5" stroke-width="1.8" />
  <text x="789" y="188" text-anchor="middle" fill="#e9eef5" font-size="19" font-weight="800" font-family="SF Mono, Fira Code, Consolas, monospace">?=</text>

  <line x1="826" y1="182" x2="856" y2="182" stroke="#e9eef5" stroke-width="1.8" marker-end="url(#cr-arrow)" />

  <rect x="858" y="156" width="46" height="52" rx="9" fill="#0a0f19" stroke="#8fdcff" stroke-width="2" />
  <text x="881" y="188" text-anchor="middle" fill="#8fdcff" font-size="18" font-weight="800" font-family="SF Mono, Fira Code, Consolas, monospace">C</text>

  <text x="685" y="286" text-anchor="middle" fill="#8b96a8" font-size="12.5" font-family="-apple-system,Arial,sans-serif">receiver verifies m and r</text>
  <text x="685" y="304" text-anchor="middle" fill="#8b96a8" font-size="12.5" font-family="-apple-system,Arial,sans-serif">actually produce C</text>

  <line x1="40" y1="420" x2="900" y2="420" stroke="#223049" stroke-width="1" />
  <text x="460" y="444" text-anchor="middle" fill="#8fdcff" font-size="15.5" font-weight="800" font-family="-apple-system,Arial,sans-serif">LOCK IT IN, PROVE IT LATER</text>
  <text x="460" y="462" text-anchor="middle" fill="#8b96a8" font-size="12.5" font-family="-apple-system,Arial,sans-serif">the committer can't be shown to lie about m once C is sent</text>

  <defs>
    <marker id="cr-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6.5" markerHeight="6.5" orient="auto-start-reverse">
      <path d="M0,0 L10,5 L0,10 z" fill="#e9eef5" />
    </marker>
    <marker id="cr-arrow-c" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6.5" markerHeight="6.5" orient="auto-start-reverse">
      <path d="M0,0 L10,5 L0,10 z" fill="#8fdcff" />
    </marker>
    <marker id="cr-arrow-g" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6.5" markerHeight="6.5" orient="auto-start-reverse">
      <path d="M0,0 L10,5 L0,10 z" fill="#5ddc8a" />
    </marker>
    <marker id="cr-arrow-b" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6.5" markerHeight="6.5" orient="auto-start-reverse">
      <path d="M0,0 L10,5 L0,10 z" fill="#3ab7ff" />
    </marker>
  </defs>
</svg>
