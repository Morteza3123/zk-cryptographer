---
// Fig. for "FFT and NTT": evaluating at all four roots of unity at once is a
// matrix times a vector — row j, column k holds ω^(j×k) — tying evaluation
// back to the matrix-times-vector idea from Topic 22.
import Matrix4x4 from "./Matrix4x4.astro";
const rows = [
  ["1", "1", "1", "1"],
  ["1", "5", "12", "8"],
  ["1", "12", "1", "12"],
  ["1", "8", "12", "5"],
];
---
<svg viewBox="0 0 760 500" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;display:block;">
  <text x="380" y="26" text-anchor="middle" fill="#e9eef5" font-size="16" font-weight="800" font-family="-apple-system,Arial,sans-serif">the transform as a matrix</text>

  <rect x="40" y="46" width="680" height="42" rx="10" fill="#111c2e" stroke="#3ab7ff" stroke-width="1.5" />
  <text x="380" y="72" text-anchor="middle" fill="#8fdcff" font-size="13.5" font-weight="700" font-family="-apple-system,Arial,sans-serif">Is there one formula for &#8220;evaluate at all four roots&#8221;?</text>

  <rect x="40" y="96" width="680" height="42" rx="10" fill="#111c2e" stroke="#3ab7ff" stroke-width="1.5" />
  <text x="380" y="122" text-anchor="middle" fill="#8fdcff" font-size="13" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">row j, column k holds &#969; to the power j &#215; k, where &#969; = 5</text>

  <text x="380" y="160" text-anchor="middle" fill="#8b96a8" font-size="12" font-family="SF Mono, Fira Code, Consolas, monospace">5<tspan dy="-6" font-size="65%">2</tspan><tspan dy="6"> = 12, 5</tspan><tspan dy="-6" font-size="65%">3</tspan><tspan dy="6"> = 8, 5</tspan><tspan dy="-6" font-size="65%">4</tspan><tspan dy="6"> = 1</tspan></text>

  <Matrix4x4 x={160} y={180} rows={rows} highlightRow={2} scale={1.1} />
  <text x="310" y="235" fill="#e9eef5" font-size="15" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">&#215; (1, 2, 0, 0)</text>
  <text x="450" y="235" fill="#e9eef5" font-size="15" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">= (3, 11, 12, 4)</text>

  <text x="380" y="316" text-anchor="middle" fill="#8b96a8" font-size="12" font-weight="700" font-family="-apple-system,Arial,sans-serif">STEP 1 &#8212; one row as a dot product</text>
  <text x="380" y="340" text-anchor="middle" fill="#e9eef5" font-size="13.5" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">third row: 1&#215;1 + 12&#215;2 + 1&#215;0 + 12&#215;0 = 25 = 12 &#10003;</text>

  <rect x="60" y="362" width="640" height="42" rx="10" fill="#0e1f16" stroke="#5ddc8a" stroke-width="1.8" />
  <text x="380" y="388" text-anchor="middle" fill="#5ddc8a" font-size="13.5" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">(3, 11, 12, 4) = the values of f at 1, 5, 12, 8, as before</text>

  <line x1="40" y1="428" x2="720" y2="428" stroke="#223049" stroke-width="1" />
  <text x="380" y="452" text-anchor="middle" fill="#8fdcff" font-size="15.5" font-weight="800" font-family="-apple-system,Arial,sans-serif">ONE MATRIX EVALUATES AT EVERY ROOT</text>
  <text x="380" y="474" text-anchor="middle" fill="#8b96a8" font-size="12.5" font-family="-apple-system,Arial,sans-serif">But this is n &#215; n multiplications, the same slow cost. We need a faster way.</text>
</svg>
