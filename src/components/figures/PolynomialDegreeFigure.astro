---
// Fig. for "Polynomials": the degree — the highest power of x that
// appears — read off four polynomials, from a bare constant up to a
// cubic.
interface Row {
  eq: string;
  degree: string;
  type: string;
}
const rows: Row[] = [
  { eq: "p(x) = 7", degree: "degree 0", type: "constant" },
  { eq: "p(x) = 2x + 1", degree: "degree 1", type: "linear" },
  { eq: "p(x) = 3x² + 2x + 5", degree: "degree 2", type: "quadratic" },
  { eq: "p(x) = x³ − x + 4", degree: "degree 3", type: "cubic" },
];
const rowH = 56;
const topPad = 46;
const height = topPad + rows.length * rowH + 10;
---
<svg viewBox={`0 0 680 ${height}`} xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;display:block;">
  <text x="340" y="26" text-anchor="middle" fill="#8fdcff" font-size="14" font-weight="700" font-family="-apple-system,Arial,sans-serif">the degree — highest power of x</text>
  <line x1="20" y1="40" x2="660" y2="40" stroke="#223049" stroke-width="1" />

  {rows.map((row, i) => {
    const y = topPad + i * rowH;
    return (
      <>
        <text x="40" y={y + 18} text-anchor="start" fill="#e9eef5" font-size="16" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">{row.eq}</text>
        <text x="470" y={y + 18} text-anchor="middle" fill="#8fdcff" font-size="14.5" font-weight="700" font-family="-apple-system,Arial,sans-serif">{row.degree}</text>
        <text x="620" y={y + 18} text-anchor="end" fill="#5ddc8a" font-size="14" font-weight="700" font-family="-apple-system,Arial,sans-serif">{row.type}</text>
        {i < rows.length - 1 && (
          <line x1="20" y1={y + rowH - 16} x2="660" y2={y + rowH - 16} stroke="#1a2436" stroke-width="1" />
        )}
      </>
    );
  })}
</svg>
