---
// Fig. for "Elliptic Curves over Finite Fields": point addition, geometrically.
// Curve: y^2 = x^3 - 3x + 5 (the running example for this lesson). P and Q are
// two real points on the curve; the chord through them hits the curve again
// at a third point, which this figure calls R — the un-reflected result.
// With showReflection, a dashed line drops from R to its mirror image across
// the x-axis, which is the actual sum P + Q.
interface Props {
  showReflection?: boolean;
}
const { showReflection = false } = Astro.props;

const A = -3;
const B = 5;
const f = (x: number) => x * x * x + A * x + B;

// Bisection for the curve's single real root (where f(x) = 0), so the curve
// is only plotted where it's real-valued.
let lo = -3;
let hi = -2;
for (let i = 0; i < 60; i++) {
  const mid = (lo + hi) / 2;
  if (f(mid) < 0) lo = mid;
  else hi = mid;
}
const xRoot = hi;

const P: [number, number] = [-2, Math.sqrt(f(-2))];
const Q: [number, number] = [0.1, Math.sqrt(f(0.1))];
const m = (Q[1] - P[1]) / (Q[0] - P[0]);
const xR = m * m - P[0] - Q[0];
const yR = P[1] + m * (xR - P[0]);
const R: [number, number] = [xR, yR];
const sum: [number, number] = [xR, -yR];

const xMinView = -2.6;
const xMaxView = 2.7;
const yMinView = -3.2;
const yMaxView = 3.2;
const xMaxCurve = 3.0;

const W = 560;
const H = 520;
const padL = 54;
const padR = 30;
const padT = 36;
const padB = 46;

const toScreenX = (x: number) => padL + ((x - xMinView) / (xMaxView - xMinView)) * (W - padL - padR);
const toScreenY = (y: number) => H - padB - ((y - yMinView) / (yMaxView - yMinView)) * (H - padT - padB);

const N = 60;
const upper: string[] = [];
const lower: string[] = [];
for (let i = 0; i <= N; i++) {
  const x = xRoot + (i / N) * (xMaxCurve - xRoot);
  const y = Math.sqrt(Math.max(f(x), 0));
  upper.push(`${toScreenX(x).toFixed(1)},${toScreenY(y).toFixed(1)}`);
  lower.push(`${toScreenX(x).toFixed(1)},${toScreenY(-y).toFixed(1)}`);
}

// The chord through P and Q, extended a little past each end so it visibly
// runs through all three points.
const lineX1 = -2.5;
const lineX2 = 2.4;
const lineY1 = P[1] + m * (lineX1 - P[0]);
const lineY2 = P[1] + m * (lineX2 - P[0]);

const xTicks = [-2, -1, 1, 2];
const yTicks = [-3, -2, -1, 1, 2, 3];
---
<svg viewBox={`0 0 ${W} ${H}`} xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;display:block;">
  <text x={toScreenX(0) - 14} y={padT - 12} fill="#c3cedd" font-size="16" font-weight="700" font-family="-apple-system,Arial,sans-serif" font-style="italic">y</text>
  <text x={W - padR + 16} y={toScreenY(0) + 5} fill="#c3cedd" font-size="16" font-weight="700" font-family="-apple-system,Arial,sans-serif" font-style="italic">x</text>

  <line x1={padL - 10} y1={toScreenY(0)} x2={W - padR + 6} y2={toScreenY(0)} stroke="#3a4a63" stroke-width="1.5" marker-end="url(#ecadd-axis)" />
  <line x1={toScreenX(0)} y1={H - padB + 10} x2={toScreenX(0)} y2={padT - 6} stroke="#3a4a63" stroke-width="1.5" marker-end="url(#ecadd-axis)" />

  {xTicks.map((t) => (
    <>
      <line x1={toScreenX(t)} y1={toScreenY(0) - 5} x2={toScreenX(t)} y2={toScreenY(0) + 5} stroke="#3a4a63" stroke-width="1.5" />
      <text x={toScreenX(t)} y={toScreenY(0) + 22} text-anchor="middle" fill="#8b96a8" font-size="13" font-family="-apple-system,Arial,sans-serif">{t}</text>
    </>
  ))}
  {yTicks.map((t) => (
    <>
      <line x1={toScreenX(0) - 5} y1={toScreenY(t)} x2={toScreenX(0) + 5} y2={toScreenY(t)} stroke="#3a4a63" stroke-width="1.5" />
      <text x={toScreenX(0) - 14} y={toScreenY(t) + 5} text-anchor="end" fill="#8b96a8" font-size="13" font-family="-apple-system,Arial,sans-serif">{t}</text>
    </>
  ))}

  <line x1={toScreenX(lineX1)} y1={toScreenY(lineY1)} x2={toScreenX(lineX2)} y2={toScreenY(lineY2)} stroke="#ff8080" stroke-width="2.2" />

  <polyline points={upper.join(" ")} fill="none" stroke="#8fdcff" stroke-width="2.5" stroke-linecap="round" />
  <polyline points={lower.join(" ")} fill="none" stroke="#8fdcff" stroke-width="2.5" stroke-linecap="round" />

  {showReflection && (
    <line x1={toScreenX(R[0])} y1={toScreenY(R[1])} x2={toScreenX(sum[0])} y2={toScreenY(sum[1])} stroke="#e9eef5" stroke-width="1.5" stroke-dasharray="5,4" />
  )}

  <circle cx={toScreenX(P[0])} cy={toScreenY(P[1])} r="6" fill="#5ddc8a" stroke="#0a0f19" stroke-width="2" />
  <text x={toScreenX(P[0]) - 12} y={toScreenY(P[1]) - 12} text-anchor="end" fill="#e9eef5" font-size="15" font-weight="700" font-family="-apple-system,Arial,sans-serif" font-style="italic">P</text>

  <circle cx={toScreenX(Q[0])} cy={toScreenY(Q[1])} r="6" fill="#5ddc8a" stroke="#0a0f19" stroke-width="2" />
  <text x={toScreenX(Q[0])} y={toScreenY(Q[1]) - 14} text-anchor="middle" fill="#e9eef5" font-size="15" font-weight="700" font-family="-apple-system,Arial,sans-serif" font-style="italic">Q</text>

  <circle cx={toScreenX(R[0])} cy={toScreenY(R[1])} r="6" fill="#5ddc8a" stroke="#0a0f19" stroke-width="2" />
  <text x={toScreenX(R[0]) + 14} y={toScreenY(R[1]) + 4} text-anchor="start" fill="#e9eef5" font-size="15" font-weight="700" font-family="-apple-system,Arial,sans-serif" font-style="italic">R</text>

  {showReflection && (
    <>
      <circle cx={toScreenX(sum[0])} cy={toScreenY(sum[1])} r="6" fill="#5ddc8a" stroke="#0a0f19" stroke-width="2" />
      <text x={toScreenX(sum[0]) + 14} y={toScreenY(sum[1]) + 4} text-anchor="start" fill="#5ddc8a" font-size="15" font-weight="800" font-family="-apple-system,Arial,sans-serif" font-style="italic">P + Q</text>
    </>
  )}

  <text x={28} y={H - 20} fill="#c3cedd" font-size="15" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">y&#178; = x&#179; &#8722; 3x + 5</text>

  <defs>
    <marker id="ecadd-axis" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
      <path d="M0,0 L10,5 L0,10 z" fill="#3a4a63" />
    </marker>
  </defs>
</svg>
