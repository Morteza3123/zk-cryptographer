---
// Fig. for "Finite Fields": the payoff — every Circom signal is secretly
// an element of GF(p), with p the same huge BN254 prime from the
// divisibility lesson, so every +, -, *, / in a circuit is a field
// operation whether the code says so or not.
---
<svg viewBox="0 0 520 240" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;display:block;">
  <text x="260" y="40" text-anchor="middle" fill="#e9eef5" font-size="19" font-weight="800" font-family="SF Mono, Fira Code, Consolas, monospace">signal &lt;== value</text>
  <text x="260" y="64" text-anchor="middle" fill="#8b96a8" font-size="13" font-family="-apple-system,Arial,sans-serif">value is a number between 0 and p-1</text>

  <line x1="260" y1="82" x2="260" y2="132" stroke="#3ab7ff" stroke-width="1.8" marker-end="url(#circfield-arrow)" />

  <text x="260" y="164" text-anchor="middle" fill="#5ddc8a" font-size="19" font-weight="800" font-family="-apple-system,Arial,sans-serif">value &#8712; GF(p)</text>
  <text x="260" y="188" text-anchor="middle" fill="#8b96a8" font-size="13" font-family="-apple-system,Arial,sans-serif">p = the BN254 prime from the divisibility lesson</text>

  <line x1="20" y1="208" x2="500" y2="208" stroke="#223049" stroke-width="1" />
  <text x="260" y="228" text-anchor="middle" fill="#8fdcff" font-size="13" font-weight="700" font-family="-apple-system,Arial,sans-serif">+, &#8722;, &#215;, &#247; in a circuit are all finite-field operations</text>

  <defs>
    <marker id="circfield-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6.5" markerHeight="6.5" orient="auto-start-reverse">
      <path d="M0,0 L10,5 L0,10 z" fill="#3ab7ff" />
    </marker>
  </defs>
</svg>
