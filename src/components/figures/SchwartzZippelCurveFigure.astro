---
// Fig. for "Schwartz-Zippel Lemma": the opening hook — p(x) = x and
// q(x) = x^2 look nothing alike as curves, yet they land on exactly the
// same value at two spots, (0,0) and (1,1). Mapped from data-space into
// the SVG viewBox at build time, same pattern as LagrangeCurveFigure.
const crossings: [number, number][] = [
  [0, 0],
  [1, 1],
];
const p = (x: number) => x;
const q = (x: number) => x * x;

const xMin = -0.5;
const xMax = 1.5;
const yMin = -0.7;
const yMax = 2.6;

const W = 480;
const H = 280;
const padL = 46;
const padR = 20;
const padT = 24;
const padB = 36;

const toScreenX = (x: number) => padL + ((x - xMin) / (xMax - xMin)) * (W - padL - padR);
const toScreenY = (y: number) => H - padB - ((y - yMin) / (yMax - yMin)) * (H - padT - padB);

const N = 40;
const buildCurve = (f: (x: number) => number) => {
  const pts: string[] = [];
  for (let i = 0; i <= N; i++) {
    const x = xMin + (i / N) * (xMax - xMin);
    pts.push(`${toScreenX(x).toFixed(1)},${toScreenY(f(x)).toFixed(1)}`);
  }
  return pts.join(" ");
};
const pLine = buildCurve(p);
const qCurve = buildCurve(q);
---
<svg viewBox={`0 0 ${W} ${H}`} xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;display:block;">
  <line x1={padL} y1={toScreenY(0)} x2={W - padR} y2={toScreenY(0)} stroke="#223049" stroke-width="1.5" />
  <line x1={toScreenX(0)} y1={padT} x2={toScreenX(0)} y2={H - padB} stroke="#223049" stroke-width="1.5" />

  <polyline points={qCurve} fill="none" stroke="#3ab7ff" stroke-width="2.5" stroke-linecap="round" />
  <polyline points={pLine} fill="none" stroke="#8fdcff" stroke-width="2.5" stroke-linecap="round" stroke-dasharray="1,0" />

  <text x={toScreenX(1.42)} y={toScreenY(q(1.42)) - 8} fill="#3ab7ff" font-size="14" font-weight="800" font-family="SF Mono, Fira Code, Consolas, monospace">q(x) = x²</text>
  <text x={toScreenX(1.42)} y={toScreenY(p(1.3)) + 18} fill="#8fdcff" font-size="14" font-weight="800" font-family="SF Mono, Fira Code, Consolas, monospace">p(x) = x</text>

  {crossings.map(([x, y]) => {
    const sx = toScreenX(x);
    const sy = toScreenY(y);
    return (
      <>
        <circle cx={sx} cy={sy} r="5.5" fill="#5ddc8a" stroke="#0a0f19" stroke-width="2" />
        <text x={sx} y={sy - 14} text-anchor="middle" fill="#e9eef5" font-size="13" font-weight="700" font-family="-apple-system,Arial,sans-serif">({x}, {y})</text>
      </>
    );
  })}

  <text x={W / 2} y="20" text-anchor="middle" fill="#5ddc8a" font-size="13" font-weight="700" font-family="-apple-system,Arial,sans-serif">two very different curves — only two points in common</text>
</svg>
