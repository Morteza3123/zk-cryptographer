---
// Fig. for "Commitment Schemes": the Pedersen commitment — a real,
// working construction built entirely from the elliptic curve group
// introduced in topic 12. C is a single curve point with two secrets
// (m and r) baked into it; recovering either back out is exactly the
// discrete log problem from topic 11.
---
<svg viewBox="0 0 760 400" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;display:block;">
  <text x="380" y="26" text-anchor="middle" fill="#e9eef5" font-size="16" font-weight="800" font-family="-apple-system,Arial,sans-serif">a real construction, built from elliptic curve points</text>

  <rect x="170" y="44" width="420" height="80" rx="14" fill="#0d1526" stroke="#e9eef5" stroke-width="2" />
  <text x="380" y="96" text-anchor="middle" fill="#8fdcff" font-size="32" font-weight="800" font-family="SF Mono, Fira Code, Consolas, monospace">C = g&#183;m + h&#183;r</text>

  <line x1="155" y1="256" x2="258" y2="134" stroke="#c3cedd" stroke-width="1.6" marker-end="url(#pc-arrow-w)" />
  <line x1="380" y1="256" x2="380" y2="134" stroke="#5ddc8a" stroke-width="1.6" marker-end="url(#pc-arrow-g)" />
  <line x1="605" y1="256" x2="502" y2="134" stroke="#3ab7ff" stroke-width="1.6" marker-end="url(#pc-arrow-b)" />

  <rect x="20" y="258" width="270" height="70" rx="10" fill="#121c2c" stroke="#c3cedd" stroke-width="1.6" />
  <text x="155" y="286" text-anchor="middle" fill="#c3cedd" font-size="13.5" font-weight="700" font-family="-apple-system,Arial,sans-serif">g, h &#8212; two fixed</text>
  <text x="155" y="306" text-anchor="middle" fill="#c3cedd" font-size="13.5" font-weight="700" font-family="-apple-system,Arial,sans-serif">generator points (public)</text>

  <rect x="310" y="258" width="140" height="70" rx="10" fill="#121c2c" stroke="#5ddc8a" stroke-width="1.6" />
  <text x="380" y="286" text-anchor="middle" fill="#5ddc8a" font-size="13.5" font-weight="700" font-family="-apple-system,Arial,sans-serif">m &#8212; the secret</text>
  <text x="380" y="306" text-anchor="middle" fill="#5ddc8a" font-size="13.5" font-weight="700" font-family="-apple-system,Arial,sans-serif">message</text>

  <rect x="470" y="258" width="270" height="70" rx="10" fill="#121c2c" stroke="#3ab7ff" stroke-width="1.6" />
  <text x="605" y="286" text-anchor="middle" fill="#3ab7ff" font-size="13.5" font-weight="700" font-family="-apple-system,Arial,sans-serif">r &#8212; a random blinding</text>
  <text x="605" y="306" text-anchor="middle" fill="#3ab7ff" font-size="13.5" font-weight="700" font-family="-apple-system,Arial,sans-serif">factor (secret)</text>

  <line x1="20" y1="344" x2="740" y2="344" stroke="#223049" stroke-width="1" />
  <text x="380" y="368" text-anchor="middle" fill="#8fdcff" font-size="15" font-weight="800" font-family="-apple-system,Arial,sans-serif">ONE POINT, TWO SECRETS BAKED IN</text>
  <text x="380" y="390" text-anchor="middle" fill="#8b96a8" font-size="12" font-family="-apple-system,Arial,sans-serif">C is a single curve point — recovering m or r is exactly the discrete log problem</text>

  <defs>
    <marker id="pc-arrow-w" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6.5" markerHeight="6.5" orient="auto-start-reverse">
      <path d="M0,0 L10,5 L0,10 z" fill="#c3cedd" />
    </marker>
    <marker id="pc-arrow-g" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6.5" markerHeight="6.5" orient="auto-start-reverse">
      <path d="M0,0 L10,5 L0,10 z" fill="#5ddc8a" />
    </marker>
    <marker id="pc-arrow-b" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6.5" markerHeight="6.5" orient="auto-start-reverse">
      <path d="M0,0 L10,5 L0,10 z" fill="#3ab7ff" />
    </marker>
  </defs>
</svg>
