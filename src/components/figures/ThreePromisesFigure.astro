---
// Fig. for "Information Theory & Entropy": the three promises every ZK
// proof system makes, and which earlier topics each one is built from.
// Completeness succeeds (green), soundness catches a cheater (reserved red —
// a real rejection case, not a decorative choice), zero-knowledge reveals
// nothing (blue, the established public/no-leak color).
---
<svg viewBox="0 0 760 430" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;display:block;">
  <text x="380" y="26" text-anchor="middle" fill="#e9eef5" font-size="16" font-weight="800" font-family="-apple-system,Arial,sans-serif">the three promises of a ZK proof</text>

  <!-- completeness -->
  <rect x="30" y="56" width="220" height="260" rx="12" fill="#121c2c" stroke="#5ddc8a" stroke-width="1.8" />
  <text x="140" y="84" text-anchor="middle" fill="#5ddc8a" font-size="14.5" font-weight="800" font-family="-apple-system,Arial,sans-serif">COMPLETENESS</text>
  <text x="140" y="108" text-anchor="middle" fill="#c3cedd" font-size="12" font-family="-apple-system,Arial,sans-serif">a true statement: the honest</text>
  <text x="140" y="126" text-anchor="middle" fill="#c3cedd" font-size="12" font-family="-apple-system,Arial,sans-serif">prover always convinces the verifier</text>
  <line x1="50" y1="146" x2="230" y2="146" stroke="#223049" stroke-width="1" />
  <text x="140" y="166" text-anchor="middle" fill="#8b96a8" font-size="11" font-style="italic" font-family="-apple-system,Arial,sans-serif">built from</text>
  <text x="140" y="196" text-anchor="middle" fill="#e9eef5" font-size="12" font-family="-apple-system,Arial,sans-serif">polynomial division with zero</text>
  <text x="140" y="214" text-anchor="middle" fill="#e9eef5" font-size="12" font-family="-apple-system,Arial,sans-serif">remainder (Topic 8)</text>
  <text x="140" y="244" text-anchor="middle" fill="#e9eef5" font-size="12" font-family="-apple-system,Arial,sans-serif">the pairing equation (Topic 13)</text>
  <text x="140" y="274" text-anchor="middle" fill="#e9eef5" font-size="12" font-family="SF Mono, Fira Code, Consolas, monospace">the check z&#183;G = a + c&#183;y</text>
  <text x="140" y="292" text-anchor="middle" fill="#e9eef5" font-size="12" font-family="-apple-system,Arial,sans-serif">(Topic 17)</text>

  <!-- soundness -->
  <rect x="270" y="56" width="220" height="260" rx="12" fill="#121c2c" stroke="#ff5c7a" stroke-width="1.8" />
  <text x="380" y="84" text-anchor="middle" fill="#ff5c7a" font-size="14.5" font-weight="800" font-family="-apple-system,Arial,sans-serif">SOUNDNESS</text>
  <text x="380" y="108" text-anchor="middle" fill="#c3cedd" font-size="12" font-family="-apple-system,Arial,sans-serif">a false statement: a cheater is</text>
  <text x="380" y="126" text-anchor="middle" fill="#c3cedd" font-size="12" font-family="-apple-system,Arial,sans-serif">caught, with overwhelming probability</text>
  <line x1="290" y1="146" x2="470" y2="146" stroke="#223049" stroke-width="1" />
  <text x="380" y="166" text-anchor="middle" fill="#8b96a8" font-size="11" font-style="italic" font-family="-apple-system,Arial,sans-serif">built from</text>
  <text x="380" y="198" text-anchor="middle" fill="#e9eef5" font-size="12" font-family="-apple-system,Arial,sans-serif">Schwartz-Zippel (Topic 10)</text>
  <text x="380" y="228" text-anchor="middle" fill="#e9eef5" font-size="12" font-family="-apple-system,Arial,sans-serif">binding commitments (Topic 15)</text>
  <text x="380" y="258" text-anchor="middle" fill="#e9eef5" font-size="12" font-family="-apple-system,Arial,sans-serif">collision resistance (Topic 14)</text>

  <!-- zero-knowledge -->
  <rect x="510" y="56" width="220" height="260" rx="12" fill="#121c2c" stroke="#3ab7ff" stroke-width="1.8" />
  <text x="620" y="84" text-anchor="middle" fill="#8fdcff" font-size="14.5" font-weight="800" font-family="-apple-system,Arial,sans-serif">ZERO-KNOWLEDGE</text>
  <text x="620" y="108" text-anchor="middle" fill="#c3cedd" font-size="12" font-family="-apple-system,Arial,sans-serif">the verifier learns nothing except</text>
  <text x="620" y="126" text-anchor="middle" fill="#c3cedd" font-size="12" font-family="-apple-system,Arial,sans-serif">that it is true</text>
  <line x1="530" y1="146" x2="710" y2="146" stroke="#223049" stroke-width="1" />
  <text x="620" y="166" text-anchor="middle" fill="#8b96a8" font-size="11" font-style="italic" font-family="-apple-system,Arial,sans-serif">built from</text>
  <text x="620" y="196" text-anchor="middle" fill="#e9eef5" font-size="12" font-family="-apple-system,Arial,sans-serif">random blinding factors</text>
  <text x="620" y="214" text-anchor="middle" fill="#e9eef5" font-size="12" font-family="-apple-system,Arial,sans-serif">(Topics 15 and 17)</text>
  <text x="620" y="244" text-anchor="middle" fill="#e9eef5" font-size="12" font-family="-apple-system,Arial,sans-serif">the private path and</text>
  <text x="620" y="262" text-anchor="middle" fill="#e9eef5" font-size="12" font-family="-apple-system,Arial,sans-serif">nullifier (Topic 16)</text>
  <text x="620" y="292" text-anchor="middle" fill="#e9eef5" font-size="12" font-family="-apple-system,Arial,sans-serif">the simulator (Topic 17)</text>

  <line x1="30" y1="346" x2="730" y2="346" stroke="#223049" stroke-width="1" />
  <text x="380" y="370" text-anchor="middle" fill="#8fdcff" font-size="15.5" font-weight="800" font-family="-apple-system,Arial,sans-serif">COMPLETE. SOUND. ZERO-KNOWLEDGE.</text>
  <text x="380" y="392" text-anchor="middle" fill="#8b96a8" font-size="12.5" font-family="-apple-system,Arial,sans-serif">Every ZK system in this series, from Groth16 to PLONK, is judged by these three promises.</text>
</svg>
