---
// Fig. for "Commitment Schemes": the two properties a commitment scheme
// must have at once — hiding (C alone reveals nothing about m) and
// binding (the same C can never be opened to two different messages).
---
<svg viewBox="0 0 920 460" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;display:block;">
  <text x="460" y="30" text-anchor="middle" fill="#e9eef5" font-size="17" font-weight="800" font-family="-apple-system,Arial,sans-serif">two promises, both have to hold at once</text>

  <line x1="450" y1="48" x2="450" y2="400" stroke="#1a2436" stroke-width="1" stroke-dasharray="4 5" />

  <!-- LEFT: hiding -->
  <text x="225" y="68" text-anchor="middle" fill="#5ddc8a" font-size="14" font-weight="800" font-family="-apple-system,Arial,sans-serif">HIDING</text>

  <rect x="40" y="86" width="110" height="48" rx="9" fill="#121c2c" stroke="#5ddc8a" stroke-width="1.6" />
  <text x="95" y="115" text-anchor="middle" fill="#e9eef5" font-size="14" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">m = 42</text>
  <line x1="150" y1="110" x2="184" y2="110" stroke="#e9eef5" stroke-width="1.8" marker-end="url(#hb-arrow-w)" />

  <rect x="186" y="86" width="100" height="48" rx="9" fill="#0d1526" stroke="#e9eef5" stroke-width="1.8" />
  <text x="236" y="115" text-anchor="middle" fill="#e9eef5" font-size="13.5" font-weight="700" font-family="-apple-system,Arial,sans-serif">Commit</text>
  <line x1="286" y1="110" x2="320" y2="110" stroke="#8fdcff" stroke-width="1.8" marker-end="url(#hb-arrow-c)" />

  <rect x="322" y="86" width="60" height="48" rx="9" fill="#0a0f19" stroke="#8fdcff" stroke-width="2" />
  <text x="352" y="117" text-anchor="middle" fill="#8fdcff" font-size="18" font-weight="800" font-family="SF Mono, Fira Code, Consolas, monospace">C</text>

  <text x="235" y="196" text-anchor="middle" fill="#e9eef5" font-size="13" font-weight="700" font-family="-apple-system,Arial,sans-serif">C alone reveals</text>
  <text x="235" y="214" text-anchor="middle" fill="#e9eef5" font-size="13" font-weight="700" font-family="-apple-system,Arial,sans-serif">NOTHING about m</text>

  <line x1="330" y1="134" x2="270" y2="236" stroke="#5ddc8a" stroke-width="1" stroke-dasharray="3 3" />
  <line x1="370" y1="134" x2="400" y2="236" stroke="#5ddc8a" stroke-width="1" stroke-dasharray="3 3" />

  <rect x="40" y="238" width="170" height="40" rx="18" fill="none" stroke="#5ddc8a" stroke-width="1.4" stroke-dasharray="5 4" />
  <text x="125" y="263" text-anchor="middle" fill="#5ddc8a" font-size="13" font-family="SF Mono, Fira Code, Consolas, monospace">m = 42 ?</text>

  <rect x="320" y="238" width="140" height="40" rx="18" fill="none" stroke="#5ddc8a" stroke-width="1.4" stroke-dasharray="5 4" />
  <text x="390" y="263" text-anchor="middle" fill="#5ddc8a" font-size="13" font-family="SF Mono, Fira Code, Consolas, monospace">m = 7 ?</text>

  <text x="225" y="312" text-anchor="middle" fill="#8b96a8" font-size="12.5" font-family="-apple-system,Arial,sans-serif">both are equally plausible</text>

  <!-- RIGHT: binding -->
  <text x="685" y="68" text-anchor="middle" fill="#8fdcff" font-size="14" font-weight="800" font-family="-apple-system,Arial,sans-serif">BINDING</text>

  <rect x="480" y="78" width="150" height="46" rx="9" fill="#121c2c" stroke="#5ddc8a" stroke-width="1.6" />
  <text x="555" y="106" text-anchor="middle" fill="#e9eef5" font-size="14" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">m&#8321; = 42</text>

  <text x="645" y="155" text-anchor="middle" fill="#c3cedd" font-size="16" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">&#8800;</text>

  <rect x="480" y="162" width="150" height="46" rx="9" fill="#121c2c" stroke="#5ddc8a" stroke-width="1.6" />
  <text x="555" y="190" text-anchor="middle" fill="#e9eef5" font-size="14" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">m&#8322; = 7</text>

  <line x1="630" y1="101" x2="678" y2="128" stroke="#5ddc8a" stroke-width="1.6" marker-end="url(#hb-arrow-g)" />
  <line x1="630" y1="185" x2="678" y2="158" stroke="#5ddc8a" stroke-width="1.6" marker-end="url(#hb-arrow-g)" />

  <rect x="680" y="108" width="100" height="70" rx="9" fill="#0d1526" stroke="#e9eef5" stroke-width="1.8" />
  <text x="730" y="148" text-anchor="middle" fill="#e9eef5" font-size="13.5" font-weight="700" font-family="-apple-system,Arial,sans-serif">Commit</text>

  <line x1="780" y1="143" x2="824" y2="143" stroke="#ff8080" stroke-width="2" stroke-dasharray="5 5" />
  <circle cx="840" cy="143" r="15" fill="none" stroke="#ff8080" stroke-width="2.6" />
  <line x1="830" y1="133" x2="850" y2="153" stroke="#ff8080" stroke-width="2.6" />
  <text x="800" y="120" text-anchor="middle" fill="#ff8080" font-size="11.5" font-weight="800" font-family="-apple-system,Arial,sans-serif">BLOCKED</text>

  <text x="730" y="222" text-anchor="middle" fill="#8b96a8" font-size="12.5" font-family="-apple-system,Arial,sans-serif">same C cannot open to</text>
  <text x="730" y="240" text-anchor="middle" fill="#8b96a8" font-size="12.5" font-family="-apple-system,Arial,sans-serif">two different messages</text>

  <line x1="40" y1="332" x2="900" y2="332" stroke="#223049" stroke-width="1" />
  <text x="460" y="356" text-anchor="middle" fill="#8fdcff" font-size="15.5" font-weight="800" font-family="-apple-system,Arial,sans-serif">TWO PROMISES, NEVER BROKEN</text>
  <text x="460" y="380" text-anchor="middle" fill="#8b96a8" font-size="12.5" font-family="-apple-system,Arial,sans-serif">hiding: C reveals nothing — binding: C can only ever open to one message</text>

  <defs>
    <marker id="hb-arrow-w" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6.5" markerHeight="6.5" orient="auto-start-reverse">
      <path d="M0,0 L10,5 L0,10 z" fill="#e9eef5" />
    </marker>
    <marker id="hb-arrow-c" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6.5" markerHeight="6.5" orient="auto-start-reverse">
      <path d="M0,0 L10,5 L0,10 z" fill="#8fdcff" />
    </marker>
    <marker id="hb-arrow-g" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6.5" markerHeight="6.5" orient="auto-start-reverse">
      <path d="M0,0 L10,5 L0,10 z" fill="#5ddc8a" />
    </marker>
  </defs>
</svg>
