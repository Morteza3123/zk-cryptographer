---
// Fig. for "Bilinear Pairings": the big picture — a pairing is a bridge
// between two separate elliptic curve groups, landing in a third,
// completely different group underneath.
---
<svg viewBox="0 0 640 300" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;display:block;">
  <circle cx="110" cy="110" r="58" fill="#121c2c" stroke="#5ddc8a" stroke-width="2.5" />
  <text x="110" y="104" text-anchor="middle" fill="#e9eef5" font-size="20" font-weight="800" font-family="-apple-system,Arial,sans-serif" font-style="italic">P</text>
  <text x="110" y="128" text-anchor="middle" fill="#5ddc8a" font-size="13" font-weight="700" font-family="-apple-system,Arial,sans-serif">point in G&#8321;</text>

  <circle cx="530" cy="110" r="58" fill="#121c2c" stroke="#3ab7ff" stroke-width="2.5" />
  <text x="530" y="104" text-anchor="middle" fill="#e9eef5" font-size="20" font-weight="800" font-family="-apple-system,Arial,sans-serif" font-style="italic">Q</text>
  <text x="530" y="128" text-anchor="middle" fill="#3ab7ff" font-size="13" font-weight="700" font-family="-apple-system,Arial,sans-serif">point in G&#8322;</text>

  <line x1="168" y1="110" x2="248" y2="110" stroke="#8b96a8" stroke-width="1.8" marker-end="url(#pb-arrow)" />
  <line x1="472" y1="110" x2="392" y2="110" stroke="#8b96a8" stroke-width="1.8" marker-end="url(#pb-arrow)" />

  <rect x="252" y="76" width="136" height="68" rx="10" fill="#0d1526" stroke="#8fdcff" stroke-width="2" />
  <text x="320" y="118" text-anchor="middle" fill="#8fdcff" font-size="21" font-weight="800" font-family="-apple-system,Arial,sans-serif" font-style="italic">e(P, Q)</text>

  <line x1="320" y1="144" x2="320" y2="196" stroke="#8b96a8" stroke-width="1.8" marker-end="url(#pb-arrow)" />

  <rect x="140" y="204" width="360" height="72" rx="10" fill="#121c2c" stroke="#223049" stroke-width="1.5" />
  <text x="320" y="234" text-anchor="middle" fill="#8fdcff" font-size="16" font-weight="800" font-family="-apple-system,Arial,sans-serif">GROUP G&#8348;</text>
  <text x="320" y="258" text-anchor="middle" fill="#c3cedd" font-size="13" font-family="-apple-system,Arial,sans-serif">the multiplicative group of a finite field</text>

  <defs>
    <marker id="pb-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
      <path d="M0,0 L10,5 L0,10 z" fill="#8b96a8" />
    </marker>
  </defs>
</svg>
