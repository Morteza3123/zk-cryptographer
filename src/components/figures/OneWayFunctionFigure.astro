---
// Fig. for "Divisibility, Factors & Primes": multiplying two primes is
// instant; factoring the product back apart is not — the asymmetry
// cryptographic security is built on. Laid out in clearly separated rows
// (numbers, then arrows, then caption) so nothing collides regardless of
// how wide the arrow labels run.
---
<svg viewBox="0 0 560 250" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;display:block;">
  <text x="60" y="72" text-anchor="middle" fill="#e9eef5" font-size="34" font-weight="800" font-family="-apple-system,Arial,sans-serif">7</text>
  <text x="60" y="96" text-anchor="middle" fill="#5ddc8a" font-size="12" font-weight="700" font-family="-apple-system,Arial,sans-serif">prime</text>

  <text x="150" y="72" text-anchor="middle" fill="#e9eef5" font-size="34" font-weight="800" font-family="-apple-system,Arial,sans-serif">11</text>
  <text x="150" y="96" text-anchor="middle" fill="#5ddc8a" font-size="12" font-weight="700" font-family="-apple-system,Arial,sans-serif">prime</text>

  <text x="450" y="72" text-anchor="middle" fill="#e9eef5" font-size="34" font-weight="800" font-family="-apple-system,Arial,sans-serif">77</text>
  <text x="450" y="96" text-anchor="middle" fill="#8b96a8" font-size="12" font-family="-apple-system,Arial,sans-serif">7 × 11</text>

  <text x="290" y="132" text-anchor="middle" fill="#5ddc8a" font-size="13" font-weight="700" font-family="-apple-system,Arial,sans-serif">× multiply — instant, easy</text>
  <line x1="200" y1="146" x2="380" y2="146" stroke="#5ddc8a" stroke-width="2" marker-end="url(#owf-arrow-fwd)" />

  <line x1="380" y1="178" x2="200" y2="178" stroke="#ff8080" stroke-width="2" stroke-dasharray="6 5" marker-end="url(#owf-arrow-rev)" />
  <text x="290" y="200" text-anchor="middle" fill="#ff8080" font-size="13" font-weight="700" font-family="-apple-system,Arial,sans-serif">factor back — nearly impossible for huge numbers</text>

  <text x="290" y="232" text-anchor="middle" fill="#8b96a8" font-size="13" font-style="italic" font-family="-apple-system,Arial,sans-serif">this asymmetry is called a one-way function</text>

  <defs>
    <marker id="owf-arrow-fwd" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6.5" markerHeight="6.5" orient="auto-start-reverse">
      <path d="M0,0 L10,5 L0,10 z" fill="#5ddc8a" />
    </marker>
    <marker id="owf-arrow-rev" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6.5" markerHeight="6.5" orient="auto-start-reverse">
      <path d="M0,0 L10,5 L0,10 z" fill="#ff8080" />
    </marker>
  </defs>
</svg>
