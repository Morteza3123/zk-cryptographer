---
// Fig. for "ZK Math — Introduction": y² = x³ + 7 — secp256k1, the curve
// behind Bitcoin and Ethereum keys. Points are sampled at build time and
// mapped from curve-space into the SVG viewBox.
const A = 0;
const B = 7;
const xMin = -1.91; // just above the real root of x^3 + 7 = 0
const xMax = 3.1;

const W = 480;
const H = 300;
const padding = 36;

const yAtX = (x: number) => Math.sqrt(Math.max(x * x * x + A * x + B, 0));
const yMax = yAtX(xMax) * 1.05;

const toScreenX = (x: number) => padding + ((x - xMin) / (xMax - xMin)) * (W - 2 * padding);
const toScreenY = (y: number) => H / 2 - (y / yMax) * (H / 2 - padding);

const N = 48;
const upper: string[] = [];
const lower: string[] = [];
for (let i = 0; i <= N; i++) {
  const x = xMin + (i / N) * (xMax - xMin);
  const y = yAtX(x);
  upper.push(`${toScreenX(x).toFixed(1)},${toScreenY(y).toFixed(1)}`);
  lower.push(`${toScreenX(x).toFixed(1)},${toScreenY(-y).toFixed(1)}`);
}

// A sample point on the curve to call out, e.g. x = 2 -> y = sqrt(15)
const sampleX = 2;
const sampleY = yAtX(sampleX);
const sx = toScreenX(sampleX);
const sy = toScreenY(sampleY);
---
<svg viewBox={`0 0 ${W} ${H}`} xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;display:block;">
  <line x1={padding} y1={H / 2} x2={W - padding} y2={H / 2} stroke="#223049" stroke-width="1.5" />
  <line x1={toScreenX(0)} y1={padding - 10} x2={toScreenX(0)} y2={H - padding + 10} stroke="#223049" stroke-width="1.5" />

  <polyline points={upper.join(" ")} fill="none" stroke="#3ab7ff" stroke-width="2.5" stroke-linecap="round" />
  <polyline points={lower.join(" ")} fill="none" stroke="#3ab7ff" stroke-width="2.5" stroke-linecap="round" />

  <circle cx={sx} cy={sy} r="4.5" fill="#8fdcff" />
  <text x={sx + 10} y={sy - 8} fill="#e9eef5" font-size="12" font-weight="700" font-family="-apple-system,Arial,sans-serif">(2, √15)</text>

  <text x={W / 2} y="26" text-anchor="middle" fill="#e9eef5" font-size="16" font-weight="800" font-family="-apple-system,Arial,sans-serif">y² = x³ + 7</text>
</svg>
