---
// Fig. for "Schwartz-Zippel Lemma": the formal statement as a vertical
// flow — a random point in a huge field is compared on two different
// degree-d polynomials, and the almost-certain outcome is disagreement.
---
<svg viewBox="0 0 520 250" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;display:block;">
  <text x="260" y="38" text-anchor="middle" fill="#e9eef5" font-size="18" font-weight="800" font-family="-apple-system,Arial,sans-serif">two different degree-d polynomials</text>
  <text x="260" y="62" text-anchor="middle" fill="#8b96a8" font-size="13" font-family="-apple-system,Arial,sans-serif">compared at a random point in a huge field</text>

  <line x1="260" y1="80" x2="260" y2="134" stroke="#3ab7ff" stroke-width="1.8" marker-end="url(#szlemma-arrow)" />

  <text x="260" y="166" text-anchor="middle" fill="#5ddc8a" font-size="21" font-weight="800" font-family="-apple-system,Arial,sans-serif">they almost certainly disagree</text>

  <rect x="60" y="188" width="400" height="44" rx="8" fill="#121c2c" stroke="#223049" stroke-width="1.5" />
  <text x="260" y="215" text-anchor="middle" fill="#c3cedd" font-size="14.5" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">chance of a false match &#8804; d / field size</text>

  <defs>
    <marker id="szlemma-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6.5" markerHeight="6.5" orient="auto-start-reverse">
      <path d="M0,0 L10,5 L0,10 z" fill="#3ab7ff" />
    </marker>
  </defs>
</svg>
