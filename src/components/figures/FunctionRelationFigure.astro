---
// Fig. for "Variables, Expressions & Equations": y = x + 10 as a small
// machine — a value goes in, the equation does something to it, a second
// variable comes out. The same shape every constraint in a real ZK
// circuit has, just one step long here.
---
<svg viewBox="0 0 520 170" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;display:block;">
  <circle cx="70" cy="85" r="32" fill="url(#bodyGrad)" stroke="#3ab7ff" stroke-width="2" />
  <text x="70" y="92" text-anchor="middle" fill="#e9eef5" font-size="15" font-weight="800" font-family="-apple-system,Arial,sans-serif">x = 5</text>

  <line x1="104" y1="85" x2="178" y2="85" stroke="#3ab7ff" stroke-width="1.6" marker-end="url(#fnrel-arrow)" />

  <rect x="182" y="50" width="156" height="70" rx="10" fill="url(#bodyGrad)" stroke="#3ab7ff" stroke-width="2" />
  <text x="260" y="91" text-anchor="middle" fill="#e9eef5" font-size="17" font-weight="800" font-family="-apple-system,Arial,sans-serif">y = x + 10</text>

  <line x1="340" y1="85" x2="414" y2="85" stroke="#3ab7ff" stroke-width="1.6" marker-end="url(#fnrel-arrow)" />

  <circle cx="450" cy="85" r="32" fill="url(#bodyGrad)" stroke="#3ab7ff" stroke-width="2" />
  <text x="450" y="92" text-anchor="middle" fill="#e9eef5" font-size="15" font-weight="800" font-family="-apple-system,Arial,sans-serif">y = 15</text>

  <text x="260" y="150" text-anchor="middle" fill="#8b96a8" font-size="12" font-style="italic" font-family="-apple-system,Arial,sans-serif">one equation, relating two variables</text>

  <defs>
    <marker id="fnrel-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6.5" markerHeight="6.5" orient="auto-start-reverse">
      <path d="M0,0 L10,5 L0,10 z" fill="#3ab7ff" />
    </marker>
  </defs>
</svg>
