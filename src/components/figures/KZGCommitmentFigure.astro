---
// Fig. for "Commitment Schemes": KZG commits to an entire polynomial —
// potentially thousands of terms — compressed down to a single curve
// point, then opened at one random location with a short pairing-based
// proof instead of revealing the polynomial itself.
---
<svg viewBox="0 0 920 440" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;display:block;">
  <text x="460" y="30" text-anchor="middle" fill="#e9eef5" font-size="17" font-weight="800" font-family="-apple-system,Arial,sans-serif">committing to an entire polynomial</text>

  <line x1="450" y1="48" x2="450" y2="330" stroke="#1a2436" stroke-width="1" stroke-dasharray="4 5" />

  <!-- LEFT: commit -->
  <text x="225" y="66" text-anchor="middle" fill="#c3cedd" font-size="13.5" font-weight="700" font-family="-apple-system,Arial,sans-serif">COMMIT</text>

  <path d="M 50,120 C 85,80 115,160 150,120 C 185,80 215,160 250,120 C 275,95 295,135 310,112" fill="none" stroke="#3ab7ff" stroke-width="3.5" stroke-linecap="round" />
  <text x="180" y="166" text-anchor="middle" fill="#8b96a8" font-size="12.5" font-family="-apple-system,Arial,sans-serif">p(x) &#8212; could have thousands of terms</text>

  <line x1="180" y1="180" x2="180" y2="218" stroke="#8fdcff" stroke-width="2" marker-end="url(#kz-arrow)" />

  <circle cx="180" cy="238" r="15" fill="#0a0f19" stroke="#8fdcff" stroke-width="2.6" />
  <text x="180" y="276" text-anchor="middle" fill="#8fdcff" font-size="13.5" font-weight="700" font-family="-apple-system,Arial,sans-serif">C = commitment to p(x)</text>
  <text x="180" y="296" text-anchor="middle" fill="#8b96a8" font-size="12" font-family="-apple-system,Arial,sans-serif">just ONE elliptic curve point</text>

  <!-- RIGHT: open / prove -->
  <text x="685" y="66" text-anchor="middle" fill="#c3cedd" font-size="13.5" font-weight="700" font-family="-apple-system,Arial,sans-serif">OPEN / PROVE</text>

  <rect x="480" y="78" width="380" height="46" rx="9" fill="#0d1526" stroke="#e9eef5" stroke-width="1.6" />
  <text x="670" y="106" text-anchor="middle" fill="#e9eef5" font-size="14" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">verifier picks random x = a</text>

  <line x1="670" y1="124" x2="670" y2="150" stroke="#223049" stroke-width="1.6" marker-end="url(#kz-arrow-w)" />

  <rect x="480" y="152" width="380" height="56" rx="9" fill="#0d1526" stroke="#e9eef5" stroke-width="1.6" />
  <text x="670" y="176" text-anchor="middle" fill="#e9eef5" font-size="14" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">prover reveals y = p(a),</text>
  <text x="670" y="196" text-anchor="middle" fill="#e9eef5" font-size="14" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">plus proof &#960;</text>

  <line x1="670" y1="208" x2="670" y2="234" stroke="#223049" stroke-width="1.6" marker-end="url(#kz-arrow-w)" />

  <rect x="480" y="236" width="380" height="50" rx="9" fill="#0d1526" stroke="#5ddc8a" stroke-width="1.8" />
  <text x="670" y="266" text-anchor="middle" fill="#5ddc8a" font-size="15" font-weight="800" font-family="SF Mono, Fira Code, Consolas, monospace">verifier checks e(&#8230;) = e(&#8230;)</text>

  <text x="460" y="318" text-anchor="middle" fill="#8b96a8" font-size="12.5" font-family="-apple-system,Arial,sans-serif">&#8230;without ever seeing the rest of p(x)</text>

  <line x1="40" y1="340" x2="900" y2="340" stroke="#223049" stroke-width="1" />
  <text x="460" y="364" text-anchor="middle" fill="#8fdcff" font-size="15" font-weight="800" font-family="-apple-system,Arial,sans-serif">PROVE ONE POINT, WITHOUT SHOWING THE POLYNOMIAL</text>
  <text x="460" y="388" text-anchor="middle" fill="#8b96a8" font-size="12.5" font-family="-apple-system,Arial,sans-serif">this is what a Groth16 or PLONK proof actually sends you — not the polynomial, just this</text>

  <defs>
    <marker id="kz-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6.5" markerHeight="6.5" orient="auto-start-reverse">
      <path d="M0,0 L10,5 L0,10 z" fill="#8fdcff" />
    </marker>
    <marker id="kz-arrow-w" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6.5" markerHeight="6.5" orient="auto-start-reverse">
      <path d="M0,0 L10,5 L0,10 z" fill="#e9eef5" />
    </marker>
  </defs>
</svg>
