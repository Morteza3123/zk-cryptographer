---
// Fig. for "Variables, Expressions & Equations": a variable as a named
// box holding a value — an ordinary one on the left, a secret one on the
// right (the same box, just with its contents hidden), to bridge straight
// into why cryptography cares about variables at all.
---
<svg viewBox="0 0 520 220" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;display:block;">
  <text x="140" y="34" text-anchor="middle" fill="#c3cedd" font-size="14" font-weight="800" font-family="-apple-system,Arial,sans-serif">age</text>
  <rect x="60" y="48" width="160" height="92" rx="10" fill="url(#bodyGrad)" stroke="#3ab7ff" stroke-width="2" />
  <text x="140" y="104" text-anchor="middle" fill="#e9eef5" font-size="30" font-weight="800" font-family="-apple-system,Arial,sans-serif">25</text>
  <text x="140" y="168" text-anchor="middle" fill="#8b96a8" font-size="12" font-family="-apple-system,Arial,sans-serif">a name, holding a value</text>

  <text x="380" y="34" text-anchor="middle" fill="#c3cedd" font-size="14" font-weight="800" font-family="-apple-system,Arial,sans-serif">secret</text>
  <rect x="300" y="48" width="160" height="92" rx="10" fill="url(#bodyGrad)" stroke="#3ab7ff" stroke-width="2" />
  <path d="M 368 88 L 368 79 a 12 12 0 0 1 24 0 L 392 88" fill="none" stroke="#3ab7ff" stroke-width="2.5" />
  <rect x="362" y="88" width="36" height="28" rx="5" fill="#0a0f19" stroke="#3ab7ff" stroke-width="2" />
  <circle cx="380" cy="102" r="3" fill="#8fdcff" />
  <text x="380" y="168" text-anchor="middle" fill="#8b96a8" font-size="12" font-family="-apple-system,Arial,sans-serif">same box — value stays hidden</text>

  <text x="140" y="196" text-anchor="middle" fill="#8b96a8" font-size="12.5" font-style="italic" font-family="-apple-system,Arial,sans-serif">age = 25</text>
  <text x="380" y="196" text-anchor="middle" fill="#8b96a8" font-size="12.5" font-style="italic" font-family="-apple-system,Arial,sans-serif">secret = ?</text>
</svg>
