---
// Fig. for "Polynomial Arithmetic": multiplying two polynomials — every
// term in the first distributes across every term in the second, then
// the products get combined.
interface Row {
  eq: string;
  result: string;
}
const rows: Row[] = [
  { eq: "x × x", result: "x²" },
  { eq: "x × 3", result: "3x" },
  { eq: "2 × x", result: "2x" },
  { eq: "2 × 3", result: "6" },
];
---
<svg viewBox="0 0 680 290" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;display:block;">
  <text x="340" y="26" text-anchor="middle" fill="#8fdcff" font-size="14" font-weight="700" font-family="-apple-system,Arial,sans-serif">multiplying polynomials</text>
  <text x="340" y="48" text-anchor="middle" fill="#e9eef5" font-size="17" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">(x + 2)(x + 3)</text>
  <line x1="20" y1="60" x2="660" y2="60" stroke="#223049" stroke-width="1" />

  {rows.map((row, i) => {
    const y = 66 + i * 36;
    return (
      <>
        <text x="40" y={y + 24} text-anchor="start" fill="#c3cedd" font-size="15" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">{row.eq}</text>
        <text x="640" y={y + 24} text-anchor="end" fill="#8fdcff" font-size="15" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">{row.result}</text>
        {i < rows.length - 1 && (
          <line x1="20" y1={y + 32} x2="660" y2={y + 32} stroke="#1a2436" stroke-width="1" />
        )}
      </>
    );
  })}

  <line x1="20" y1="214" x2="660" y2="214" stroke="#223049" stroke-width="1" />
  <text x="340" y="244" text-anchor="middle" fill="#e9eef5" font-size="16" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">x² + 3x + 2x + 6</text>

  <text x="340" y="278" text-anchor="middle" fill="#5ddc8a" font-size="17" font-weight="800" font-family="SF Mono, Fira Code, Consolas, monospace">= x² + 5x + 6</text>
</svg>
