---
// Fig. for "Polynomial Arithmetic": the payoff for polynomial division —
// a zero remainder when dividing by (x - root) is exactly the check a
// QAP runs to verify a ZK witness.
---
<svg viewBox="0 0 560 230" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;display:block;">
  <text x="280" y="38" text-anchor="middle" fill="#e9eef5" font-size="19" font-weight="800" font-family="SF Mono, Fira Code, Consolas, monospace">p(x) &#247; (x − root) &#8594; remainder 0</text>
  <text x="280" y="64" text-anchor="middle" fill="#8b96a8" font-size="13" font-family="-apple-system,Arial,sans-serif">if and only if the root really is a root</text>

  <line x1="280" y1="82" x2="280" y2="130" stroke="#3ab7ff" stroke-width="1.8" marker-end="url(#polyzkdiv-arrow)" />

  <text x="280" y="162" text-anchor="middle" fill="#5ddc8a" font-size="18" font-weight="800" font-family="-apple-system,Arial,sans-serif">zero remainder = valid computation</text>

  <line x1="20" y1="184" x2="540" y2="184" stroke="#223049" stroke-width="1" />
  <text x="280" y="208" text-anchor="middle" fill="#8fdcff" font-size="13" font-weight="700" font-family="-apple-system,Arial,sans-serif">this exact check is how QAP verifies a ZK witness</text>

  <defs>
    <marker id="polyzkdiv-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6.5" markerHeight="6.5" orient="auto-start-reverse">
      <path d="M0,0 L10,5 L0,10 z" fill="#3ab7ff" />
    </marker>
  </defs>
</svg>
