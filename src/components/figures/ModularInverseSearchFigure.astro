---
// Fig. for "Modular Inverses & Fermat's Little Theorem": the brute-force
// search for an inverse, one candidate at a time — reused for both the
// successful search (3, mod 7) and the one that never finds a match
// (2, mod 6), which is what the optional `footer` prop is for.
interface Props {
  a: number;
  n: number;
  rows: number[];
  matchIndex?: number;
  footer?: string;
}
const { a, n, rows, matchIndex, footer } = Astro.props;
const rowH = 44;
const topPad = 34;
const tableH = rows.length * rowH;
const footerH = footer ? 74 : 0;
const height = topPad + tableH + footerH + 16;
---
<svg viewBox={`0 0 720 ${height}`} xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;display:block;">
  {rows.map((x, i) => {
    const y = topPad + i * rowH;
    const product = a * x;
    const remainder = product % n;
    const isMatch = i === matchIndex;
    const color = isMatch ? "#5ddc8a" : "#ff8080";
    const verdict = isMatch ? "✓ found it!" : "✗ not 1";
    return (
      <>
        <text x="60" y={y + 23} text-anchor="middle" fill="#c3cedd" font-size="15" font-weight="700" font-family="-apple-system,Arial,sans-serif">x = {x}</text>
        <text x="340" y={y + 23} text-anchor="middle" fill="#cdd9e8" font-size="14.5" font-family="SF Mono, Fira Code, Consolas, monospace">
          {`${a} × ${x} = ${product} → mod ${n} = ${remainder}`}
        </text>
        <text x="630" y={y + 23} text-anchor="middle" fill={color} font-size="14" font-weight="800" font-family="-apple-system,Arial,sans-serif">{verdict}</text>
        {i < rows.length - 1 && (
          <line x1="20" y1={y + rowH - 8} x2="700" y2={y + rowH - 8} stroke="#1a2436" stroke-width="1" />
        )}
      </>
    );
  })}

  {footer && (
    <>
      <rect x="20" y={topPad + tableH + 14} width="680" height={footerH - 16} rx="8" fill="#1a1016" stroke="#ff8080" stroke-width="1.5" />
      <line x1="20" y1={topPad + tableH + 14} x2="20" y2={topPad + tableH + footerH - 2} stroke="#ff8080" stroke-width="4" />
      <text x="360" y={topPad + tableH + 14 + (footerH - 16) / 2 + 5} text-anchor="middle" fill="#f2b8b8" font-size="13.5" font-weight="700" font-family="-apple-system,Arial,sans-serif">{footer}</text>
    </>
  )}
</svg>
