---
// Fig. for "Merkle Trees & Vector Commitments": tampering with a single leaf
// recomputes every hash on the path up to the root, so the root no longer
// matches. The untouched left half of the tree is dimmed on purpose — it's
// the same tree as the previous figure, just with one leaf swapped.
---
<svg viewBox="0 0 760 520" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;display:block;">
  <text x="380" y="26" text-anchor="middle" fill="#e9eef5" font-size="16" font-weight="800" font-family="-apple-system,Arial,sans-serif">change one leaf, the root changes</text>

  <!-- untouched side, dimmed -->
  <rect x="105" y="190" width="170" height="54" rx="10" fill="#0d1526" stroke="#8fdcff" stroke-width="1.4" opacity="0.35" />
  <text x="190" y="223" text-anchor="middle" fill="#8fdcff" font-size="13" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace" opacity="0.5">h12 = H(h1, h2)</text>
  <rect x="23" y="300" width="144" height="46" rx="9" fill="#0d1526" stroke="#8fdcff" stroke-width="1.4" opacity="0.35" />
  <text x="95" y="328" text-anchor="middle" fill="#8fdcff" font-size="12" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace" opacity="0.5">h1 = H(L1)</text>
  <rect x="213" y="300" width="144" height="46" rx="9" fill="#0d1526" stroke="#8fdcff" stroke-width="1.4" opacity="0.35" />
  <text x="285" y="328" text-anchor="middle" fill="#8fdcff" font-size="12" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace" opacity="0.5">h2 = H(L2)</text>
  <rect x="23" y="400" width="144" height="50" rx="9" fill="#121c2c" stroke="#c3cedd" stroke-width="1.4" opacity="0.35" />
  <text x="95" y="430" text-anchor="middle" fill="#e9eef5" font-size="14" font-weight="700" font-family="-apple-system,Arial,sans-serif" opacity="0.5">L1</text>
  <rect x="213" y="400" width="144" height="50" rx="9" fill="#121c2c" stroke="#c3cedd" stroke-width="1.4" opacity="0.35" />
  <text x="285" y="430" text-anchor="middle" fill="#e9eef5" font-size="14" font-weight="700" font-family="-apple-system,Arial,sans-serif" opacity="0.5">L2</text>
  <line x1="95" y1="400" x2="95" y2="346" stroke="#c3cedd" stroke-width="1.4" opacity="0.35" />
  <line x1="285" y1="400" x2="285" y2="346" stroke="#c3cedd" stroke-width="1.4" opacity="0.35" />
  <line x1="95" y1="300" x2="160" y2="244" stroke="#8fdcff" stroke-width="1.4" opacity="0.35" />
  <line x1="285" y1="300" x2="220" y2="244" stroke="#8fdcff" stroke-width="1.4" opacity="0.35" />
  <line x1="190" y1="190" x2="310" y2="140" stroke="#3ab7ff" stroke-width="1.4" opacity="0.35" />

  <!-- root: now mismatched -->
  <rect x="230" y="80" width="300" height="60" rx="12" fill="#1f0d14" stroke="#ff5c7a" stroke-width="2.2" />
  <text x="380" y="112" text-anchor="middle" fill="#ff5c7a" font-size="15" font-weight="800" font-family="SF Mono, Fira Code, Consolas, monospace">ROOT&#8242; = H(h12, h34&#8242;)</text>
  <text x="640" y="104" text-anchor="start" fill="#8b96a8" font-size="11" font-family="SF Mono, Fira Code, Consolas, monospace">ROOT 7e3f9a2c&#8230;</text>
  <text x="640" y="122" text-anchor="start" fill="#ff5c7a" font-size="11" font-family="SF Mono, Fira Code, Consolas, monospace">ROOT&#8242; c81d5f3b&#8230;</text>

  <!-- tampered pair -->
  <rect x="485" y="190" width="170" height="54" rx="10" fill="#1f0d14" stroke="#ff5c7a" stroke-width="1.8" />
  <text x="570" y="223" text-anchor="middle" fill="#ff5c7a" font-size="13.5" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">h34&#8242; = H(h3&#8242;, h4)</text>

  <!-- tampered hash + unaffected sibling -->
  <rect x="403" y="300" width="144" height="46" rx="9" fill="#1f0d14" stroke="#ff5c7a" stroke-width="1.8" />
  <text x="475" y="328" text-anchor="middle" fill="#ff5c7a" font-size="12.5" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">h3&#8242; = H(L3&#8242;)</text>
  <rect x="593" y="300" width="144" height="46" rx="9" fill="#0d1526" stroke="#8fdcff" stroke-width="1.6" />
  <text x="665" y="328" text-anchor="middle" fill="#8fdcff" font-size="12.5" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">h4 = H(L4)</text>

  <!-- tampered leaf + unaffected sibling -->
  <rect x="403" y="400" width="144" height="50" rx="9" fill="#1f0d14" stroke="#ff5c7a" stroke-width="1.8" />
  <text x="475" y="428" text-anchor="middle" fill="#ff5c7a" font-size="14.5" font-weight="700" font-family="-apple-system,Arial,sans-serif">L3&#8242;</text>
  <text x="475" y="443" text-anchor="middle" fill="#ff5c7a" font-size="10.5" font-style="italic" font-family="-apple-system,Arial,sans-serif">tampered</text>
  <rect x="593" y="400" width="144" height="50" rx="9" fill="#121c2c" stroke="#c3cedd" stroke-width="1.6" />
  <text x="665" y="430" text-anchor="middle" fill="#e9eef5" font-size="15" font-weight="700" font-family="-apple-system,Arial,sans-serif">L4</text>

  <!-- arrows (tampered path, red) -->
  <line x1="475" y1="400" x2="475" y2="346" stroke="#ff5c7a" stroke-width="1.8" marker-end="url(#rc-arrow-r)" />
  <line x1="665" y1="400" x2="665" y2="346" stroke="#c3cedd" stroke-width="1.6" marker-end="url(#rc-arrow-w)" />
  <line x1="475" y1="300" x2="540" y2="244" stroke="#ff5c7a" stroke-width="1.8" marker-end="url(#rc-arrow-r)" />
  <line x1="665" y1="300" x2="600" y2="244" stroke="#8fdcff" stroke-width="1.6" marker-end="url(#rc-arrow-b)" />
  <line x1="570" y1="190" x2="450" y2="140" stroke="#ff5c7a" stroke-width="1.8" marker-end="url(#rc-arrow-r)" />

  <line x1="20" y1="466" x2="740" y2="466" stroke="#223049" stroke-width="1" />
  <text x="380" y="490" text-anchor="middle" fill="#ff5c7a" font-size="15.5" font-weight="800" font-family="-apple-system,Arial,sans-serif">NO QUIET EDITS</text>
  <text x="380" y="508" text-anchor="middle" fill="#8b96a8" font-size="12.5" font-family="-apple-system,Arial,sans-serif">Every hash on the path to the root is recomputed — one bit differs, and the root no longer matches.</text>

  <defs>
    <marker id="rc-arrow-w" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6.5" markerHeight="6.5" orient="auto-start-reverse">
      <path d="M0,0 L10,5 L0,10 z" fill="#c3cedd" />
    </marker>
    <marker id="rc-arrow-b" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6.5" markerHeight="6.5" orient="auto-start-reverse">
      <path d="M0,0 L10,5 L0,10 z" fill="#8fdcff" />
    </marker>
    <marker id="rc-arrow-r" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6.5" markerHeight="6.5" orient="auto-start-reverse">
      <path d="M0,0 L10,5 L0,10 z" fill="#ff5c7a" />
    </marker>
  </defs>
</svg>
