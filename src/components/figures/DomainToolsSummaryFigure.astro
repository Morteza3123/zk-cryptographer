---
// Fig. for "Subgroups, Cosets, Roots of Unity & Vanishing Polynomials":
// where subgroups, roots of unity, and cosets/Z(x) actually show up in a
// real proof system — mirrors the three-column summary pattern used by
// the entropy and Euclid lessons' closing figures.
---
<svg viewBox="0 0 760 430" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;display:block;">
  <text x="380" y="26" text-anchor="middle" fill="#e9eef5" font-size="16" font-weight="800" font-family="-apple-system,Arial,sans-serif">where these tools show up</text>

  <!-- subgroups -->
  <rect x="30" y="56" width="220" height="230" rx="12" fill="#121c2c" stroke="#3ab7ff" stroke-width="1.8" />
  <text x="140" y="84" text-anchor="middle" fill="#8fdcff" font-size="14.5" font-weight="800" font-family="-apple-system,Arial,sans-serif">SUBGROUPS</text>
  <text x="140" y="112" text-anchor="middle" fill="#c3cedd" font-size="12" font-family="-apple-system,Arial,sans-serif">domain sizes must divide</text>
  <text x="140" y="130" text-anchor="middle" fill="#c3cedd" font-size="12" font-family="-apple-system,Arial,sans-serif">p &#8722; 1, so proof systems</text>
  <text x="140" y="148" text-anchor="middle" fill="#c3cedd" font-size="12" font-family="-apple-system,Arial,sans-serif">pick fields where p &#8722; 1</text>
  <text x="140" y="166" text-anchor="middle" fill="#c3cedd" font-size="12" font-family="-apple-system,Arial,sans-serif">has a big power of 2</text>
  <text x="140" y="256" text-anchor="middle" fill="#5ddc8a" font-size="12.5" font-style="italic" font-family="-apple-system,Arial,sans-serif">Why the field is chosen.</text>

  <!-- roots of unity -->
  <rect x="270" y="56" width="220" height="230" rx="12" fill="#121c2c" stroke="#5ddc8a" stroke-width="1.8" />
  <text x="380" y="84" text-anchor="middle" fill="#5ddc8a" font-size="14.5" font-weight="800" font-family="-apple-system,Arial,sans-serif">ROOTS OF UNITY</text>
  <text x="380" y="112" text-anchor="middle" fill="#c3cedd" font-size="12" font-family="-apple-system,Arial,sans-serif">the evaluation domain:</text>
  <text x="380" y="130" text-anchor="middle" fill="#c3cedd" font-size="12" font-family="-apple-system,Arial,sans-serif">the points circuits</text>
  <text x="380" y="148" text-anchor="middle" fill="#c3cedd" font-size="12" font-family="-apple-system,Arial,sans-serif">and FFTs use</text>
  <text x="380" y="256" text-anchor="middle" fill="#5ddc8a" font-size="12.5" font-style="italic" font-family="-apple-system,Arial,sans-serif">The domain of the proof.</text>

  <!-- cosets and Z(x) -->
  <rect x="510" y="56" width="220" height="230" rx="12" fill="#121c2c" stroke="#8fdcff" stroke-width="1.8" />
  <text x="620" y="84" text-anchor="middle" fill="#8fdcff" font-size="14.5" font-weight="800" font-family="-apple-system,Arial,sans-serif">COSETS AND Z(x)</text>
  <text x="620" y="112" text-anchor="middle" fill="#c3cedd" font-size="12" font-family="-apple-system,Arial,sans-serif">shifted copies of the</text>
  <text x="620" y="130" text-anchor="middle" fill="#c3cedd" font-size="12" font-family="-apple-system,Arial,sans-serif">domain, and the polynomial</text>
  <text x="620" y="148" text-anchor="middle" fill="#c3cedd" font-size="12" font-family="-apple-system,Arial,sans-serif">that proves zero on all of it</text>
  <text x="620" y="256" text-anchor="middle" fill="#5ddc8a" font-size="12.5" font-style="italic" font-family="-apple-system,Arial,sans-serif">Many checks in one.</text>

  <line x1="30" y1="316" x2="730" y2="316" stroke="#223049" stroke-width="1" />
  <text x="380" y="340" text-anchor="middle" fill="#8fdcff" font-size="15.5" font-weight="800" font-family="-apple-system,Arial,sans-serif">A SMALL DOMAIN, A BIG SHORTCUT</text>
  <text x="380" y="362" text-anchor="middle" fill="#8b96a8" font-size="12.5" font-family="-apple-system,Arial,sans-serif">Next up: quadratic residues and square roots.</text>
</svg>
