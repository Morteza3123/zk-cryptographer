---
// Fig. for "Quadratic Residues & Square Roots": square every nonzero number
// mod 13 and read off the pattern — each value appears exactly twice,
// because x and 13 − x give the same square, so exactly half of the
// nonzero numbers turn out to be squares (quadratic residues) and half
// are not.
const xs = Array.from({ length: 12 }, (_, i) => i + 1);
const sq = [1, 4, 9, 3, 12, 10, 10, 12, 3, 9, 4, 1];
const squares = [1, 3, 4, 9, 10, 12];
const nonSquares = [2, 5, 6, 7, 8, 11];
const spacing = (720 - 128) / 11;
const cols = xs.map((_, i) => 128 + i * spacing);
---
<svg viewBox="0 0 760 540" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;display:block;">
  <text x="380" y="26" text-anchor="middle" fill="#e9eef5" font-size="16" font-weight="800" font-family="-apple-system,Arial,sans-serif">which numbers are squares?</text>

  <rect x="40" y="46" width="680" height="42" rx="10" fill="#111c2e" stroke="#3ab7ff" stroke-width="1.5" />
  <text x="380" y="72" text-anchor="middle" fill="#8fdcff" font-size="13.5" font-weight="700" font-family="-apple-system,Arial,sans-serif">Which numbers mod 13 are the square of something?</text>

  <text x="40" y="112" fill="#8b96a8" font-size="12" font-weight="700" font-family="-apple-system,Arial,sans-serif">STEP 1 &#8212; square every number</text>
  {cols.map((cx, i) => (
    <>
      <text x={cx} y="134" text-anchor="middle" fill="#8b96a8" font-size="12.5" font-family="SF Mono, Fira Code, Consolas, monospace">{xs[i]}</text>
      <text x={cx} y="158" text-anchor="middle" fill="#e9eef5" font-size="14" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">{sq[i]}</text>
    </>
  ))}
  <text x="104" y="134" text-anchor="end" fill="#8b96a8" font-size="11.5" font-family="SF Mono, Fira Code, Consolas, monospace">x</text>
  <text x="104" y="158" text-anchor="end" fill="#8b96a8" font-size="11.5" font-family="SF Mono, Fira Code, Consolas, monospace">x<tspan dy="-5" font-size="70%">2</tspan></text>
  <text x="380" y="184" text-anchor="middle" fill="#8b96a8" font-size="12" font-style="italic" font-family="SF Mono, Fira Code, Consolas, monospace">7<tspan dy="-6" font-size="65%">2</tspan><tspan dy="6"> = 49 = 3 &#215; 13 + 10, so 10</tspan></text>

  <line x1="40" y1="202" x2="720" y2="202" stroke="#223049" stroke-width="1" />

  <text x="380" y="228" text-anchor="middle" fill="#8b96a8" font-size="12" font-weight="700" font-family="-apple-system,Arial,sans-serif">STEP 2 &#8212; each value appears twice</text>
  <text x="380" y="252" text-anchor="middle" fill="#c3cedd" font-size="13" font-family="-apple-system,Arial,sans-serif">x and 13 &#8722; x give the same square:</text>
  <text x="380" y="276" text-anchor="middle" fill="#e9eef5" font-size="13" font-family="SF Mono, Fira Code, Consolas, monospace">1&amp;12&#8594;1   2&amp;11&#8594;4   3&amp;10&#8594;9   4&amp;9&#8594;3   5&amp;8&#8594;12   6&amp;7&#8594;10</text>

  <line x1="40" y1="296" x2="720" y2="296" stroke="#223049" stroke-width="1" />

  <text x="380" y="322" text-anchor="middle" fill="#8b96a8" font-size="12" font-weight="700" font-family="-apple-system,Arial,sans-serif">STEP 3 &#8212; collect them</text>
  <text x="380" y="348" text-anchor="middle" fill="#5ddc8a" font-size="14.5" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">squares: {squares.join(", ")}</text>
  <text x="380" y="372" text-anchor="middle" fill="#ff5c7a" font-size="14.5" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">non-squares: {nonSquares.join(", ")}</text>

  <rect x="230" y="392" width="300" height="48" rx="10" fill="#0e1f16" stroke="#5ddc8a" stroke-width="1.8" />
  <text x="380" y="422" text-anchor="middle" fill="#5ddc8a" font-size="15" font-weight="800" font-family="-apple-system,Arial,sans-serif">6 squares and 6 non-squares</text>

  <text x="380" y="464" text-anchor="middle" fill="#8b96a8" font-size="12.5" font-family="SF Mono, Fira Code, Consolas, monospace">6 + 6 = 12 &#10003;</text>

  <line x1="40" y1="482" x2="720" y2="482" stroke="#223049" stroke-width="1" />
  <text x="380" y="506" text-anchor="middle" fill="#8fdcff" font-size="15.5" font-weight="800" font-family="-apple-system,Arial,sans-serif">EXACTLY HALF OF THE NONZERO NUMBERS ARE SQUARES</text>
  <text x="380" y="526" text-anchor="middle" fill="#8b96a8" font-size="12.5" font-family="-apple-system,Arial,sans-serif">Each square has two roots: x and &#8722;x.</text>
</svg>
