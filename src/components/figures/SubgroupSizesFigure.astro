---
// Fig. for "Subgroups, Cosets, Roots of Unity & Vanishing Polynomials": one
// subgroup for every divisor of 12, each built by raising the generator 2
// to the power 12/size — and a closure check inside the smallest nontrivial
// one, {1, 3, 9}.
const rows = [
  { size: 1, exp: "12", eq: " = 1", elements: "{1}" },
  { size: 2, exp: "6", eq: " = 12", elements: "{1, 12}" },
  { size: 3, exp: "4", eq: " = 3", elements: "{1, 3, 9}" },
  { size: 4, exp: "3", eq: " = 8", elements: "{1, 8, 12, 5}" },
  { size: 6, exp: "2", eq: " = 4", elements: "{1, 4, 3, 12, 9, 10}" },
  { size: 12, exp: "", eq: "", elements: "all of 1 to 12" },
];
---
<svg viewBox="0 0 760 580" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;display:block;">
  <text x="380" y="26" text-anchor="middle" fill="#e9eef5" font-size="16" font-weight="800" font-family="-apple-system,Arial,sans-serif">groups inside the group</text>

  <rect x="40" y="38" width="680" height="44" rx="9" fill="#111c2e" stroke="#223049" stroke-width="1" />
  <text x="380" y="65" text-anchor="middle" fill="#c3cedd" font-size="13.5" font-family="-apple-system,Arial,sans-serif">Which smaller groups live inside the powers of 2 mod 13?</text>

  <text x="40" y="108" fill="#8b96a8" font-size="12" font-weight="700" font-family="-apple-system,Arial,sans-serif">STEP 1 &#8212; one size for each divisor of 12</text>
  <text x="380" y="134" text-anchor="middle" fill="#e9eef5" font-size="16" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">sizes 1, 2, 3, 4, 6, 12</text>

  <line x1="40" y1="152" x2="720" y2="152" stroke="#223049" stroke-width="1" />

  <text x="40" y="178" fill="#8b96a8" font-size="12" font-weight="700" font-family="-apple-system,Arial,sans-serif">STEP 2 &#8212; build each from 2 to the power 12 &#247; size</text>
  <text x="90" y="202" fill="#8b96a8" font-size="11.5" font-style="italic" font-family="-apple-system,Arial,sans-serif">size</text>
  <text x="280" y="202" fill="#8b96a8" font-size="11.5" font-style="italic" font-family="-apple-system,Arial,sans-serif">generator</text>
  <text x="520" y="202" fill="#8b96a8" font-size="11.5" font-style="italic" font-family="-apple-system,Arial,sans-serif">elements</text>
  {rows.map((r, i) => {
    const y = 230 + i * 32;
    return (
      <>
        <text x="90" y={y} fill="#e9eef5" font-size="14.5" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">{r.size}</text>
        <text x="280" y={y} fill="#8fdcff" font-size="14" font-family="SF Mono, Fira Code, Consolas, monospace">2{r.exp && <tspan dy="-6" font-size="65%">{r.exp}</tspan>}<tspan dy={r.exp ? "6" : "0"}>{r.eq}</tspan></text>
        <text x="520" y={y} fill="#e9eef5" font-size="14" font-family="SF Mono, Fira Code, Consolas, monospace">{r.elements}</text>
      </>
    );
  })}

  <line x1="40" y1="432" x2="720" y2="432" stroke="#223049" stroke-width="1" />

  <text x="40" y="458" fill="#8b96a8" font-size="12" font-weight="700" font-family="-apple-system,Arial,sans-serif">STEP 3 &#8212; stays inside itself</text>
  <text x="380" y="482" text-anchor="middle" fill="#e9eef5" font-size="14" font-family="SF Mono, Fira Code, Consolas, monospace">in &#123;1, 3, 9&#125;: 3&#215;9 = 27 = 1, and 9&#215;9 = 81 = 3 (mod 13)</text>
  <text x="380" y="504" text-anchor="middle" fill="#5ddc8a" font-size="13" font-weight="700" font-family="-apple-system,Arial,sans-serif">both results inside the set</text>

  <line x1="40" y1="522" x2="720" y2="522" stroke="#223049" stroke-width="1" />
  <text x="380" y="546" text-anchor="middle" fill="#8fdcff" font-size="15.5" font-weight="800" font-family="-apple-system,Arial,sans-serif">ONE SUBGROUP FOR EACH DIVISOR OF 12</text>
  <text x="380" y="566" text-anchor="middle" fill="#8b96a8" font-size="12.5" font-family="-apple-system,Arial,sans-serif">Multiply any two members and you stay inside.</text>
</svg>
