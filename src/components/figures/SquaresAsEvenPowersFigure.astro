---
// Fig. for "Quadratic Residues & Square Roots": why exactly half are
// squares, using the generator 2 mod 13 from Topic 19 — squaring any
// power doubles its exponent, so every square is an even power of the
// generator, and every even power is a square.
const ks = Array.from({ length: 12 }, (_, i) => i + 1);
const pow = [2, 4, 8, 3, 6, 12, 11, 9, 5, 10, 7, 1];
const spacing = (720 - 128) / 11;
const cols = ks.map((_, i) => 128 + i * spacing);
---
<svg viewBox="0 0 760 498" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;display:block;">
  <text x="380" y="26" text-anchor="middle" fill="#e9eef5" font-size="16" font-weight="800" font-family="-apple-system,Arial,sans-serif">squares are the even powers</text>

  <rect x="40" y="46" width="680" height="42" rx="10" fill="#111c2e" stroke="#3ab7ff" stroke-width="1.5" />
  <text x="380" y="72" text-anchor="middle" fill="#8fdcff" font-size="13.5" font-weight="700" font-family="-apple-system,Arial,sans-serif">Using the generator 2, which powers give squares?</text>

  <text x="40" y="112" fill="#8b96a8" font-size="12" font-weight="700" font-family="-apple-system,Arial,sans-serif">STEP 1 &#8212; list the powers</text>
  {cols.map((cx, i) => (
    <>
      <text x={cx} y="134" text-anchor="middle" fill="#8b96a8" font-size="12.5" font-family="SF Mono, Fira Code, Consolas, monospace">{ks[i]}</text>
      <text x={cx} y="158" text-anchor="middle" fill={ks[i] % 2 === 0 ? "#5ddc8a" : "#ff5c7a"} font-size="14" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">{pow[i]}</text>
    </>
  ))}
  <text x="104" y="134" text-anchor="end" fill="#8b96a8" font-size="11.5" font-family="SF Mono, Fira Code, Consolas, monospace">k</text>
  <text x="104" y="158" text-anchor="end" fill="#8b96a8" font-size="11.5" font-family="SF Mono, Fira Code, Consolas, monospace">2<tspan dy="-5" font-size="70%">k</tspan></text>

  <line x1="40" y1="178" x2="720" y2="178" stroke="#223049" stroke-width="1" />

  <text x="380" y="204" text-anchor="middle" fill="#8b96a8" font-size="12" font-weight="700" font-family="-apple-system,Arial,sans-serif">STEP 2 &#8212; why</text>
  <text x="380" y="230" text-anchor="middle" fill="#e9eef5" font-size="14" font-family="SF Mono, Fira Code, Consolas, monospace">(2<tspan dy="-6" font-size="65%">j</tspan><tspan dy="6">)</tspan><tspan dy="-6" font-size="65%">2</tspan><tspan dy="6"> = 2</tspan><tspan dy="-6" font-size="65%">2j</tspan><tspan dy="6">, which is an even power</tspan></text>

  <line x1="40" y1="250" x2="720" y2="250" stroke="#223049" stroke-width="1" />

  <text x="380" y="276" text-anchor="middle" fill="#8b96a8" font-size="12" font-weight="700" font-family="-apple-system,Arial,sans-serif">STEP 3 &#8212; compare</text>
  <text x="380" y="300" text-anchor="middle" fill="#5ddc8a" font-size="13.5" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">even powers: 1, 3, 4, 9, 10, 12 = the squares from before &#10003;</text>
  <text x="380" y="322" text-anchor="middle" fill="#ff5c7a" font-size="13.5" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">odd powers: 2, 5, 6, 7, 8, 11 = the non-squares &#10003;</text>

  <rect x="200" y="342" width="360" height="46" rx="10" fill="#0e1f16" stroke="#5ddc8a" stroke-width="1.8" />
  <text x="380" y="371" text-anchor="middle" fill="#5ddc8a" font-size="14.5" font-weight="800" font-family="SF Mono, Fira Code, Consolas, monospace">squares = even powers, half of 12</text>

  <line x1="40" y1="410" x2="720" y2="410" stroke="#223049" stroke-width="1" />
  <text x="380" y="434" text-anchor="middle" fill="#8fdcff" font-size="15.5" font-weight="800" font-family="-apple-system,Arial,sans-serif">SQUARING DOUBLES THE EXPONENT</text>
  <text x="380" y="456" text-anchor="middle" fill="#8b96a8" font-size="12.5" font-family="-apple-system,Arial,sans-serif">A generator splits the group into squares and non-squares, half and half.</text>
</svg>
