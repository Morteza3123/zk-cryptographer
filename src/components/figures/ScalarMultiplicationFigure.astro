---
// Fig. for "Elliptic Curves over Finite Fields": the payoff — picking a
// generator point G and adding it to itself k times (scalar multiplication)
// is the trapdoor every real ZK proving system is built on.
---
<svg viewBox="0 0 520 250" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;display:block;">
  <text x="260" y="34" text-anchor="middle" fill="#e9eef5" font-size="16.5" font-weight="800" font-family="-apple-system,Arial,sans-serif">pick a generator point G, add it to itself k times</text>
  <text x="260" y="58" text-anchor="middle" fill="#8b96a8" font-size="13.5" font-family="SF Mono, Fira Code, Consolas, monospace">k &#183; G = G + G + G + &#8230; (k times)</text>

  <line x1="260" y1="76" x2="260" y2="128" stroke="#3ab7ff" stroke-width="1.8" marker-end="url(#scalar-arrow)" />

  <text x="260" y="160" text-anchor="middle" fill="#5ddc8a" font-size="17" font-weight="800" font-family="-apple-system,Arial,sans-serif">BN254 and BLS12-381 are the curves ZK systems use</text>

  <line x1="40" y1="186" x2="480" y2="186" stroke="#223049" stroke-width="1" />
  <text x="260" y="216" text-anchor="middle" fill="#8fdcff" font-size="13.5" font-weight="700" font-family="-apple-system,Arial,sans-serif">Groth16, PLONK, and KZG all run on this exact structure</text>

  <defs>
    <marker id="scalar-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6.5" markerHeight="6.5" orient="auto-start-reverse">
      <path d="M0,0 L10,5 L0,10 z" fill="#3ab7ff" />
    </marker>
  </defs>
</svg>
