---
// Fig. for "ZK Math — Introduction": the x·x = 25 example — a prover who
// knows x convinces a verifier the claim is true while x itself stays
// locked away.
---
<svg viewBox="0 0 560 210" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;display:block;">
  <circle cx="90" cy="95" r="34" fill="url(#bodyGrad)" stroke="#3ab7ff" stroke-width="2" />
  <text x="90" y="102" text-anchor="middle" fill="#e9eef5" font-size="15" font-weight="800" font-family="-apple-system,Arial,sans-serif">P</text>
  <text x="90" y="151" text-anchor="middle" fill="#8b96a8" font-size="12" font-family="-apple-system,Arial,sans-serif">Prover — knows x</text>

  <circle cx="470" cy="95" r="34" fill="url(#bodyGrad)" stroke="#3ab7ff" stroke-width="2" />
  <text x="470" y="102" text-anchor="middle" fill="#e9eef5" font-size="15" font-weight="800" font-family="-apple-system,Arial,sans-serif">V</text>
  <text x="470" y="151" text-anchor="middle" fill="#8b96a8" font-size="12" font-family="-apple-system,Arial,sans-serif">Verifier</text>

  <line x1="134" y1="95" x2="236" y2="95" stroke="#3ab7ff" stroke-width="1.6" marker-end="url(#zkreveal-arrow)" />
  <line x1="324" y1="95" x2="426" y2="95" stroke="#3ab7ff" stroke-width="1.6" marker-end="url(#zkreveal-arrow)" />
  <text x="280" y="58" text-anchor="middle" fill="#c3cedd" font-size="12.5" font-weight="700" font-family="-apple-system,Arial,sans-serif">proof that x · x = 25</text>

  <rect x="256" y="76" width="48" height="38" rx="7" fill="#0a0f19" stroke="#3ab7ff" stroke-width="2" />
  <path d="M 266 76 L 266 64 a 14 14 0 0 1 28 0 L 294 76" fill="none" stroke="#3ab7ff" stroke-width="2.5" />
  <circle cx="280" cy="95" r="3.5" fill="#8fdcff" />
  <text x="280" y="134" text-anchor="middle" fill="#8b96a8" font-size="11" font-style="italic" font-family="-apple-system,Arial,sans-serif">x stays hidden</text>

  <text x="280" y="190" text-anchor="middle" fill="#e9eef5" font-size="13" font-weight="700" font-family="-apple-system,Arial,sans-serif">convinced — without ever learning x = 5 (or −5)</text>

  <defs>
    <marker id="zkreveal-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6.5" markerHeight="6.5" orient="auto-start-reverse">
      <path d="M0,0 L10,5 L0,10 z" fill="#3ab7ff" />
    </marker>
  </defs>
</svg>
