---
// Fig. for "Linear Algebra over Finite Fields": a matrix times a vector is
// one dot product per row — A = [[1,2],[3,4]] turns v = (5,6) into (3,4) mod 7.
import Matrix2x2 from "./Matrix2x2.astro";
---
<svg viewBox="0 0 760 510" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;display:block;">
  <text x="380" y="26" text-anchor="middle" fill="#e9eef5" font-size="16" font-weight="800" font-family="-apple-system,Arial,sans-serif">matrix times vector</text>

  <rect x="40" y="46" width="680" height="42" rx="10" fill="#111c2e" stroke="#3ab7ff" stroke-width="1.5" />
  <text x="380" y="72" text-anchor="middle" fill="#8fdcff" font-size="13.5" font-weight="700" font-family="-apple-system,Arial,sans-serif">What does a matrix do to a vector?</text>

  <text x="270" y="150" text-anchor="end" fill="#e9eef5" font-size="16" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">A =</text>
  <Matrix2x2 x={300} y={110} a="1" b="2" c="3" d="4" scale={1.3} />
  <text x="560" y="150" text-anchor="middle" fill="#e9eef5" font-size="16" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">v = (5, 6)</text>

  <text x="380" y="216" text-anchor="middle" fill="#e9eef5" font-size="15" font-weight="800" font-family="SF Mono, Fira Code, Consolas, monospace">A &#215; v</text>

  <text x="380" y="250" text-anchor="middle" fill="#8b96a8" font-size="12" font-weight="700" font-family="-apple-system,Arial,sans-serif">STEP 1 &#8212; row 1 &#8226; v</text>
  <text x="380" y="276" text-anchor="middle" fill="#e9eef5" font-size="14.5" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">1 &#215; 5 + 2 &#215; 6 = 5 + 12 = 17 = 3</text>

  <text x="380" y="308" text-anchor="middle" fill="#8b96a8" font-size="12" font-weight="700" font-family="-apple-system,Arial,sans-serif">STEP 2 &#8212; row 2 &#8226; v</text>
  <text x="380" y="334" text-anchor="middle" fill="#e9eef5" font-size="14.5" font-weight="700" font-family="SF Mono, Fira Code, Consolas, monospace">3 &#215; 5 + 4 &#215; 6 = 15 + 24 = 39 = 4</text>

  <rect x="260" y="356" width="240" height="42" rx="10" fill="#0e1f16" stroke="#5ddc8a" stroke-width="1.8" />
  <text x="380" y="382" text-anchor="middle" fill="#5ddc8a" font-size="14.5" font-weight="800" font-family="SF Mono, Fira Code, Consolas, monospace">A &#215; v = (3, 4)</text>

  <text x="380" y="424" text-anchor="middle" fill="#e9eef5" font-size="13" font-family="SF Mono, Fira Code, Consolas, monospace">17 = 2 &#215; 7 + 3 and 39 = 5 &#215; 7 + 4 &#10003;</text>

  <line x1="40" y1="444" x2="720" y2="444" stroke="#223049" stroke-width="1" />
  <text x="380" y="468" text-anchor="middle" fill="#8fdcff" font-size="15.5" font-weight="800" font-family="-apple-system,Arial,sans-serif">ONE ROW, ONE DOT PRODUCT</text>
  <text x="380" y="490" text-anchor="middle" fill="#8b96a8" font-size="12.5" font-family="-apple-system,Arial,sans-serif">A matrix is a machine that turns one vector into another.</text>
</svg>
