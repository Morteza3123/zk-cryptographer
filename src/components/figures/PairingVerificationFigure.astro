---
// Fig. for "Bilinear Pairings": the payoff — bilinearity lets a verifier
// confirm a hidden multiplicative relationship between scalars without
// ever seeing the scalars themselves. This single check underlies
// Groth16 and KZG verification.
---
<svg viewBox="0 0 520 250" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;display:block;">
  <text x="260" y="34" text-anchor="middle" fill="#e9eef5" font-size="16" font-weight="800" font-family="-apple-system,Arial,sans-serif">check a hidden multiplicative relationship</text>
  <text x="260" y="58" text-anchor="middle" fill="#8b96a8" font-size="13" font-family="-apple-system,Arial,sans-serif">between scalars the verifier never actually sees</text>

  <line x1="260" y1="76" x2="260" y2="128" stroke="#3ab7ff" stroke-width="1.8" marker-end="url(#pver-arrow)" />

  <text x="260" y="160" text-anchor="middle" fill="#5ddc8a" font-size="18" font-weight="800" font-family="SF Mono, Fira Code, Consolas, monospace">e(A,B) = e(C,D) &#8658; a&#183;b = c&#183;d</text>

  <line x1="40" y1="186" x2="480" y2="186" stroke="#223049" stroke-width="1" />
  <text x="260" y="216" text-anchor="middle" fill="#8fdcff" font-size="13.5" font-weight="700" font-family="-apple-system,Arial,sans-serif">this single check is how Groth16 and KZG verify a proof</text>

  <defs>
    <marker id="pver-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6.5" markerHeight="6.5" orient="auto-start-reverse">
      <path d="M0,0 L10,5 L0,10 z" fill="#3ab7ff" />
    </marker>
  </defs>
</svg>
