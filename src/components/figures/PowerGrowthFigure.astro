---
// Fig. for "Exponents and Powers": how fast 2^n grows. A single series, so
// bar length is scaled to the exponent itself (log2 of the value) rather
// than the raw value — doing it to the raw value would make the first bar
// a single invisible pixel next to the last one. Each bar is directly
// labeled with its actual value, so the scale choice stays honest.
interface Row {
  exp: number;
  value: string;
}
const rows: Row[] = [
  { exp: 8, value: "256" },
  { exp: 10, value: "1,024" },
  { exp: 20, value: "> 1 million" },
  { exp: 30, value: "> 1 billion" },
];
const trackX = 150;
const trackW = 260;
const maxExp = 30;
const barH = 26;
const rowGap = 52;
const top = 30;
---
<svg viewBox={`0 0 620 ${top + rows.length * rowGap + 26}`} xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;display:block;">
  {rows.map((row, i) => {
    const y = top + i * rowGap;
    const w = (row.exp / maxExp) * trackW;
    return (
      <>
        <line x1={trackX} y1={y + barH / 2} x2={trackX + trackW} y2={y + barH / 2} stroke="#223049" stroke-width="1" />
        <rect x={trackX} y={y} width={w} height={barH} rx="6" fill="url(#bodyGrad)" stroke="#3ab7ff" stroke-width="2" />
        <text x={trackX - 14} y={y + barH / 2 + 5} text-anchor="end" fill="#c3cedd" font-size="15" font-weight="700" font-family="-apple-system,Arial,sans-serif">
          2<tspan dy="-6" font-size="10">{row.exp}</tspan>
        </text>
        <text x={trackX + w + 12} y={y + barH / 2 + 5} text-anchor="start" fill="#e9eef5" font-size="14" font-weight="700" font-family="-apple-system,Arial,sans-serif">{row.value}</text>
      </>
    );
  })}
  <text x={trackX} y={top + rows.length * rowGap + 2} text-anchor="start" fill="#8b96a8" font-size="11" font-style="italic" font-family="-apple-system,Arial,sans-serif">bar length scales with the exponent, not the value — the values themselves explode this fast</text>
</svg>
