---
// Renders the brand mark via <use>. LogoDefs must be included once per page
// (BaseLayout does this) before any Logo instance.
interface Props {
  size?: number;
  class?: string;
}
const { size = 30, class: className = "" } = Astro.props;
---
<svg class={`logo-mark ${className}`} style={`width:${size}px;height:${size}px;`} viewBox="0 0 400 420">
  <use href="#zk-logo-icon"></use>
</svg>
