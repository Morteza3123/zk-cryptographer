---
// Services' hero visual: two engagement types branching down into one
// converged "system" node. Reads as convergence, distinct from both the
// Blog's scatter and the Coaching page's single rising line.
interface Engagement {
  sym: string;
  title: string;
  tag: string;
}
interface Props {
  engagements: [Engagement, Engagement];
}
const { engagements } = Astro.props;
const top = [
  { ...engagements[0], x: 130, y: 100, r: 32 },
  { ...engagements[1], x: 430, y: 100, r: 32 },
];
const hubX = 280, hubY = 290, hubR = 38;
---
<svg viewBox="0 0 560 380" class="hero-diagram-svg" xmlns="http://www.w3.org/2000/svg">
  <line x1="130" y1="100" x2={hubX} y2={hubY} stroke="#3ab7ff" stroke-width="2" opacity="0.5" />
  <line x1="430" y1="100" x2={hubX} y2={hubY} stroke="#3ab7ff" stroke-width="2" opacity="0.5" />
  {top.map((n) => (
    <>
      <circle cx={n.x} cy={n.y} r={n.r} fill="url(#fpGrad)" stroke="#8fdcff" stroke-width="1.5" />
      <text x={n.x} y={n.y + 8} text-anchor="middle" fill="#051625" font-size="22" font-weight="800" font-family="-apple-system,Arial,sans-serif" set:html={n.sym} />
      <text x={n.x} y={n.y - n.r - 24} text-anchor="middle" fill="#3ab7ff" font-size="11" font-weight="700" letter-spacing="0.08em" font-family="-apple-system,Arial,sans-serif">{n.tag}</text>
      <text x={n.x} y={n.y - n.r - 6} text-anchor="middle" fill="#e9eef5" font-size="15" font-weight="800" font-family="-apple-system,Arial,sans-serif">{n.title}</text>
    </>
  ))}
  <circle cx={hubX} cy={hubY} r={hubR} fill="url(#bodyGrad)" stroke="#3ab7ff" stroke-width="1.6" />
  <svg x={hubX - 17} y={hubY - 19} width="34" height="36" viewBox="0 0 400 420"><use href="#zk-logo-icon"></use></svg>
  <text x={hubX} y={hubY + hubR + 22} text-anchor="middle" fill="#8b96a8" font-size="12" font-weight="700" letter-spacing="0.06em" font-family="-apple-system,Arial,sans-serif">YOUR ZK SYSTEM</text>
</svg>
