---
import BaseLayout from "./BaseLayout.astro";
import "katex/dist/katex.min.css";

interface SidebarItem {
  num: string;
  title: string;
  duration: string;
  slug: string;
}
interface SidebarGroup {
  label: string;
  items: SidebarItem[];
}
interface Props {
  title: string;
  description: string;
  category: string;
  dateLabel: string;
  readingTime: string;
  ogImage?: string;
  activeSlug?: string;
  sidebarGroups?: SidebarGroup[];
}
const {
  title,
  description,
  category,
  dateLabel,
  readingTime,
  ogImage = "/images/og-square.png",
  activeSlug,
  sidebarGroups = [],
} = Astro.props;
---
<BaseLayout
  title={title}
  description={description}
  active="blog"
  ogImage={ogImage}
  ogImageWidth={1080}
  ogImageHeight={1080}
>
  <div class="crumbrow">
    <a href="/blog">Blog</a> / <a href={`/blog?category=${encodeURIComponent(category)}`}>{category}</a> / <b>{title}</b>
  </div>
  <div class="course-layout">
    {sidebarGroups.length > 0 && (
      <aside class="course-sidebar">
        {sidebarGroups.map((group) => (
          <>
            <div class="sb-mod">{group.label}</div>
            {group.items.map((item) => (
              <a
                class={`sb-item ${item.slug === activeSlug ? "active" : ""}`}
                href={`/blog/${item.slug}`}
              >
                <span class="sb-num">{item.num}</span>
                <span>{item.title}</span>
                <span class="sb-dur">{item.duration}</span>
              </a>
            ))}
          </>
        ))}
      </aside>
    )}
    <div class="course-main">
      <div class="post-cat-pill">{category}</div>
      <div class="lesson-title">{title}</div>
      <div class="lesson-meta">{dateLabel} · {readingTime}</div>
      <article class="lesson-article">
        <slot />
      </article>
    </div>
  </div>
</BaseLayout>
