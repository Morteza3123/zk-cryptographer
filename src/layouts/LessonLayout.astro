---
import BaseLayout from "./BaseLayout.astro";
import YouTubeEmbed from "../components/YouTubeEmbed.astro";
import "katex/dist/katex.min.css";

interface ManifestItem {
  num: string;
  title: string;
  duration: string;
  slug?: string;
}
interface ManifestModule {
  module: string;
  items: ManifestItem[];
}
interface Props {
  trackTitle: string;
  trackHref: string;
  lessonCrumb: string;
  modules: ManifestModule[];
  activeSlug: string;
  lessonNumber: string;
  title: string;
  moduleLabel: string;
  lessonsInTrack: number;
  duration: string;
  description: string;
  youtubeHref?: string;
  prevTitle?: string;
  prevHref?: string;
  nextTitle?: string;
  nextHref?: string;
}
const {
  trackTitle,
  trackHref,
  lessonCrumb,
  modules,
  activeSlug,
  lessonNumber,
  title,
  moduleLabel,
  lessonsInTrack,
  duration,
  description,
  youtubeHref,
  prevTitle,
  prevHref,
  nextTitle,
  nextHref,
} = Astro.props;

// [lesson].astro is one shared template for every lesson (getStaticPaths),
// so it always passes a `slot="poster"` child structurally — even on pages
// where its own condition is false. That means `Astro.slots.has("poster")`
// is always true here regardless of lesson, so we instead render the slot
// and check whether anything actually came out of it.
const posterHtml = (await Astro.slots.render("poster")).trim();
const hasCustomPoster = posterHtml.length > 0;
---
<BaseLayout title={title} description={description} active="learn">
  <div class="crumbrow">
    <a href="/learn">Learn</a> / <a href={trackHref}>{trackTitle}</a> / <b>{lessonCrumb}</b>
  </div>
  <button class="sidebar-toggle" aria-label="Open lesson topics" data-sidebar-toggle>
    <span class="sidebar-toggle-icon"><span></span><span></span><span></span></span>
    Topics
  </button>
  <div class="sidebar-backdrop" data-sidebar-backdrop></div>
  <div class="course-layout">
    <aside class="course-sidebar" data-sidebar>
      <div class="course-sidebar-mobile-head">
        <span>Topics</span>
        <button aria-label="Close lesson topics" data-sidebar-close>&times;</button>
      </div>
      {modules.map((mod) => (
        <>
          <div class="sb-mod">{mod.module}</div>
          {mod.items.map((item) => (
            item.slug ? (
              <a
                class={`sb-item ${item.slug === activeSlug ? "active" : ""}`}
                href={`${trackHref}/${item.slug}`}
              >
                <span class="sb-num">{item.num}</span>
                <span>{item.title}</span>
                <span class="sb-dur">{item.duration}</span>
              </a>
            ) : (
              <div class="sb-item sb-item-inert">
                <span class="sb-num">{item.num}</span>
                <span>{item.title}</span>
                <span class="sb-dur">{item.duration}</span>
              </div>
            )
          ))}
        </>
      ))}
    </aside>
    <div class="course-main">
      {hasCustomPoster ? (
        <YouTubeEmbed duration={duration} href={youtubeHref}>
          <Fragment slot="poster" set:html={posterHtml} />
        </YouTubeEmbed>
      ) : (
        <YouTubeEmbed duration={duration} href={youtubeHref} />
      )}
      <div class="lesson-title">{lessonNumber}. {title}</div>
      <div class="lesson-meta">{moduleLabel} · Lesson {Number(lessonNumber) + 1} of {lessonsInTrack} · {duration}</div>
      <div class="lesson-desc">{description}</div>
      <article class="lesson-article">
        <slot />
      </article>
      <div class="prevnext">
        <div>
          {prevTitle && (
            prevHref ? <a href={prevHref}>&larr; <span class="sub">Previous</span><br />{prevTitle}</a>
            : <span class="prevnext-inert">&larr; <span class="sub">Previous</span><br />{prevTitle}</span>
          )}
        </div>
        <div style="text-align:right;">
          {nextTitle && (
            nextHref ? <a href={nextHref}><span class="sub">Next</span> &rarr;<br />{nextTitle}</a>
            : <span class="prevnext-inert"><span class="sub">Next</span> &rarr;<br />{nextTitle}</span>
          )}
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  // Mobile lesson-topic drawer: slides the sidebar in from the left instead
  // of it stacking above the lesson content. Vanilla toggle, same pattern
  // as the header's hamburger menu — no React island needed for this.
  const toggle = document.querySelector<HTMLElement>("[data-sidebar-toggle]");
  const sidebar = document.querySelector<HTMLElement>("[data-sidebar]");
  const backdrop = document.querySelector<HTMLElement>("[data-sidebar-backdrop]");
  const closeBtn = document.querySelector<HTMLElement>("[data-sidebar-close]");

  const closeSidebar = () => {
    sidebar?.setAttribute("data-open", "false");
    backdrop?.setAttribute("data-open", "false");
  };
  const openSidebar = () => {
    sidebar?.setAttribute("data-open", "true");
    backdrop?.setAttribute("data-open", "true");
  };

  toggle?.addEventListener("click", () => {
    const isOpen = sidebar?.getAttribute("data-open") === "true";
    if (isOpen) closeSidebar();
    else openSidebar();
  });
  closeBtn?.addEventListener("click", closeSidebar);
  backdrop?.addEventListener("click", closeSidebar);

  // Tapping a topic link navigates away (full page load), but close the
  // drawer first so a bfcache restore doesn't leave it stuck open.
  sidebar?.querySelectorAll("a.sb-item").forEach((a) => {
    a.addEventListener("click", closeSidebar);
  });
</script>
